  booktitle={2024 International Conference on Advancements in Smart, Secure and Intelligent Computing (ASSIC)}, 
  title={On the Design of Cancer Tumor Type Prediction using Machine Learning Techniques for Efficient Diagnosis}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={In the recent past, cancer is designated as the life threatening disease causing significant deaths across the globe. Countries are putting efforts for early stage cancer detection, and mortality prediction. Machine Learning (ML) models are proven to efficiently find the correlation among the features for robust predictions over statistical approaches. In this paper, we used kaggle dataset that includes 569 cancer cells and around 30 features cancer cells' classification. The proposed study employs ML models (e.g., binary classifiers) for effective predictive analytics. The evaluation results indicate that Random Forest achieves better results with Area Under Curve (AUC) of 0.99 followed by Decision tree with AUC be 0.92. However, the Logistic Regression (LR) and Support Vector Machine (SVM) fails to capture the generalized behavior of the cancer data for predictive analysis.},
  keywords={Support vector machines;Training data;Predictive models;Biology;Trajectory;Gene expression;Predictive analytics;Deep Learning;Benign;Malignant;cancer;classification;categorical},
  doi={10.1109/ASSIC60049.2024.10507927},
