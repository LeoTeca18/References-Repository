  booktitle={2023 1st DMIHER International Conference on Artificial Intelligence in Education and Industry 4.0 (IDICAIEI)}, 
  title={A Fine-Tuned ResNet50 Model for Multiclass Cancer Prediction}, 
  year={2023},
  volume={1},
  number={},
  pages={1-6},
  abstract={Cancer has maintained its position as a leading contributor to mortality across the world. To enhance treatment outcomes and elevate cancer survival rates, which exert significant economic and social repercussions, the development of a precise and early cancer prediction model is required. Equally important is a comprehensive grasp of the biological pathways underpinning cancer development. Over the past two decades, the categorization of diverse cancer types has undergone exploration through both machine learning and deep learning techniques. At the forefront of these efforts, molecular-level diagnostics utilizing microarray technology have the potential to provide accurate, unbiased, and methodical cancer classification. Given that the expression patterns across the entire genome are shaped by thousands of genes, the selective identification of pertinent genes becomes crucial for precise cancer diagnostics, given that not all genes are implicated in cancer processes. In this work, a deep learning-based pre-trained ResNet50 model has been utilized for the prediction of multiple types of cancer. The model has been fine-tuned by varying the number of epochs, optimizers and learning rates. This model has achieved an accuracy of 99% at epoch 50 which is higher in comparison to the existing models.},
  keywords={Economics;Education;Genomics;Predictive models;Fourth Industrial Revolution;Cancer;Residual neural networks;Cancer;Deep Learning;Convolution Neural Network;Precision;Preventable deaths;Diseases;Death rate;Health;Healthy lives},
  doi={10.1109/IDICAIEI58380.2023.10406918},
  ISSN={},
  month={Nov},}@ARTICLE{11299426,
  author={Sadeghi, Faezeh and Pourfard, Mohammadreza and Rostami, Maryam Talebi and Motamedi, Seyed Ahmad},
  journal={IEEE Transactions on Computational Biology and Bioinformatics}, 
  title={GEXPNET: A Novel Gene EXPression NETwork for Tumor Classification Using the ResNet-Based Deep Learning Approach}, 
  year={2026},
  volume={23},
  number={1},
  pages={14-26},
  abstract={Accurate classification of cancer subtypes from microarray gene expression data remains challenging due to high dimensionality, class imbalance, and limited sample sizes. To address these issues, we propose GexpNet, a novel deep learning architecture specifically designed for gene expression analysis. GexpNet integrates an initial convolutional layer with dynamic multi-head residual blocks that employ heterogeneous kernel sizes and activation functions. These are followed by an adaptive dense classifier, enabling effective multi-scale feature extraction and robust classification. To reduce noise and overfitting, a customized preprocessing pipeline is introduced, comprising median imputation, quantile normalization, and supervised feature selection based on logistic regression. Evaluated on four publicly available datasets, GexpNet achieves 98.99% accuracy (95% CI: 98.57–99.43% ) and 98.26% F1-score (95% CI: 97.51–99.01% ) on the Mendeley dataset, outperforming prior deep learning models by up to 1.99% . Across three additional datasets, GexpNet consistently exceeds 99% accuracy with minimal variance in 10-fold cross-validation, confirming its robustness and generalizability. Overall, these results highlight GexpNet as a robust, scalable, and generalizable framework for precision oncology applications.},
  keywords={Gene expression;Cancer;Accuracy;Feature extraction;Deep learning;Principal component analysis;Data models;Biology;Pipelines;Metaheuristics;Cancer classification;gene expression analysis;RNA sequencing (RNA-seq);deep learning;residual neural networks;precision medicine},
  doi={10.1109/TCBBIO.2025.3637184},
