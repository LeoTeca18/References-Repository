  month={},}@INPROCEEDINGS{11478842,
  author={Moosini, Bhuvana Reethika and Prasad, Ch. Rajendra},
  booktitle={2026 Twelfth International Conference on Bio Signals, Images, and Instrumentation (ICBSII)}, 
  title={Multi-Class Lung and Colon Cancers Classification using Transfer Learning Approach}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurate and early recognition of lung and colorectal cancers is essential for improving survival rates. These cancers are leading causes of cancer-related mortality worldwide. Although image analysis with manual evaluation by pathologists is time-consuming, subjective, and prone to variability. This study proposes an automated deep learning pipeline using transfer learning with the EfficientNetB3 architecture for robust cancer classification. The framework begins with data acquisition, followed by preprocessing and augmentation, including resizing images to $224 \times 224 \times 3$, normalization, and dataset balancing to enhance generalization. Two models were developed: a custom Convolutional Neural Network (CNN) and a transfer learning model based on EfficientNetB3 pre-trained on ImageNet. The system classifies images into five categories: normal colon tissue, colon adenocarcinoma, normal lung tissue, lung adenocarcinoma, and lung squamous cell carcinoma. Performance was evaluated using accuracy, precision, recall, and F1-score. Experimental results show that EfficientNetB3 achieved over 99 % test accuracy, outperforming the custom CNN and demonstrating strong generalization with minimal misclassification.},
  keywords={Feeds;Radio broadcasting;Frequency modulation;Pixel;Protocols;HTTP;Modulation;Radio broadcasting;Frequency modulation;Radio access networks;Lung Cancer;Colon Cancer;Histopathology;Deep Learning;Transfer Learning;EfficientNetB3;Medical Image Classification},
