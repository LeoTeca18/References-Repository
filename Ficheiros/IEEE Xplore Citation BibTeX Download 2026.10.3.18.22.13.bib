  title={Predictive Analytics for Lung Cancer Detection using Deep Learning Techniques}, 
  year={2025},
  volume={},
  number={},
  pages={1347-1352},
  abstract={This study investigates the use of deep learning techniques in lung cancer diagnosis by focusing on the VGG16 model. Lung cancer is the leading cause of cancer deaths and early detection is critical to improving patient outcomes. The VGG16 model was selected due to its performance in image classification. We investigate CT scan image preprocessing, video removal techniques, and training techniques to build accurate prediction models. The VGG16 model has been shown to accurately distinguish between cancerous and noncancerous cells, making it useful for early lung cancer diagnosis.},
