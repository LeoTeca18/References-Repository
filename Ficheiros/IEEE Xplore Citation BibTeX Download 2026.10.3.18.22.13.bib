  number={},
  pages={1-5},
  abstract={The use of artificial intelligence to develop biomarkers for cancer diagnosis is examined in this work. Insights into the presence, progression, and response to therapy of cancer can be gained in large part because to biomarkers. Artificial intelligence algorithms are able to find patterns and pinpoint potential cancer-related biomarkers by examining a variety of biological data, such as genomes, proteomics, and clinical factors. The study combines multi-omics data, makes use of feature selection methods, and develops a range of artificial intelligence models. The findings show how well artificial intelligence performs in categorising cancer cases and healthy controls with potential links to particular cancer subtypes. This study has implications for precision medicine innovation, personalised cancer treatment, and improved cancer diagnosis.},
  keywords={Biological system modeling;Precision medicine;Biomarkers;Predictive models;Artificial intelligence;Medical diagnostic imaging;Cancer;XGBoost;AdaBoost;Hybrid Model;Cancer Biomarker;F1_Score},
  doi={10.1109/ICICIS56802.2023.10430291},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11576844,
  author={Giri, Uttam Kumar and Tripathy, Ramamani and Singh, Hakam},
  booktitle={2026 International Conference on Connected Intelligence for Industrial Applications (CI2A)}, 
  title={Machine Learning Applications in Healthcare: A Comparative Analysis of Cancer Diagnosis and Prediction}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Cancer continues to take a devastating toll globally, standing as one of the world's leading causes of death. Detecting it accurately and early is crucial; it can dramatically improve a patient's chances of survival and successful treatment. However, the traditional methods doctors often rely on can be slow and sometimes depend too much on individual interpretation, which can vary. This is where machine learning (ML) and deep learning (DL) are stepping in, offering exciting new possibilities. By finding complex patterns within massive amounts of data, these powerful computational techniques have the potential to transform how we diagnose and even predict cancer. This article dives into the current landscape of ML and DL for cancer diagnosis and prediction. We compare how these tools are being used across several major cancers: breast, ovarian, blood, lung, and colon. Drawing on a range of research studies, we examine the specific algorithms researchers are testing, the types of data they're feeding into these models (such as medical images or genetic information), and the reported results, key metrics including accuracy and precision. What emerges is that numerous machine learning (ML) approaches are proving effective. Techniques like Support Vector Machines (SVM), Random Forests, Logistic Regression, Decision Trees, and K-Nearest Neighbors (KNN) are widely used. So are more advanced methods, including Gradient Boosting models (XGBoost, GBM, LGBM), various Artificial Neural Networks (ANNs), Convolutional Neural Networks (CNNs), particularly good with images, and ensemble methods that combine multiple models, have been successfully applied, often achieving high accuracy rates exceeding 90% in specific studies. Challenges include data limitations (size, imbalance, dimensionality), the need for explainability, and integrating multimodal data. Overall, this comparison underscores the tremendous potential ML and DL hold for revolutionizing cancer diagnostics},
  keywords={Modeling;Cancer;Machine learning;Accuracy;Machining;Printing;Breast cancer;Algorithms;Medical diagnosis;Support vector machines;Support Vector Machine (SVM);Random Forest (RF);Logistic Regression (LR);Decision Trees (DT);K-Nearest Neighbors (KNN);Artificial Neural Networks (ANN);Convolutional Neural Networks (CNN)},
  doi={10.1109/CI2A69097.2026.11576844},
  ISSN={},
  month={April},}@ARTICLE{11626861,
  author={Hassan, Muhammad and Zubair, Muhammad and Ibrahim, Rozeena and Mahmood, Tahir and Hussain, Muzammil and Umair, Muhammad},
  journal={IEEE Access}, 
  title={Explainable and Trustworthy AI in Oncology: A Systematic Review Across Major Organ Systems}, 
  year={2026},
  volume={14},
  number={},
  pages={127800-127833},
  abstract={The increasing adoption of AI in cancer diagnosis requires transparency and interpretability, particularly in AI-based clinical decision support systems. However, the inherent complexity and opacity of many AI models hinder their clinical acceptance and integration into healthcare workflows. This systematic review provides a comprehensive overview of eXplainable AI (XAI) techniques applied in the diagnosis of cancer in nine major organs, including the lungs, skin, brain, breast, gastrointestinal, colorectal, kidney, prostate, and ovary. The study systematically reviews and compares widely used XAI methods, covering both model-specific and model-agnostic approaches, and analyzes them based on interpretability aspects such as global vs. local explanations and intrinsic vs. post-hoc transparency, and provides guidance for selecting appropriate XAI techniques for specific diagnostic applications. Recent studies employing XAI in medical imaging and predictive modeling are analyzed to identify trends in modality usage, evaluation metrics, and methodological choices. Comparative insights into how different XAI techniques perform across various organ systems are presented in structured tables. This critical comparison highlights the strengths and limitations of these methods in real-world diagnostic contexts, noting challenges such as clinical trust, evaluation inconsistency, and integration into existing workflows. The review critically discusses the gap between advancements and their practical clinical utility, underscoring the urgent need for clinically relevant validation. In addition, current gaps are identified, and future research directions are discussed to improve the utility and reliability of XAI. The study provides a foundational reference for researchers and clinicians, supporting informed decisions and facilitating the effective adoption of XAI in oncology practice. This systematic review was conducted using a structured search strategy, predefined eligibility criteria, and PRISMA-guided study selection to ensure a transparent and reproducible synthesis of the literature.},
  keywords={Explainable AI;Modeling;Cams;Computer aided manufacturing;Tumors;Artificial intelligence;Visualization;Cancer;Oncology;Reviews;Artificial intelligence;clinical decision support;explainable AI;healthcare;medical image processing;oncology},
  doi={10.1109/ACCESS.2026.3717851},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10426208,
  author={Swetha, V and Vignesh, N and Immaculate Joy, S},
  booktitle={2023 3rd International Conference on Innovative Mechanisms for Industry Applications (ICIMIA)}, 
  title={A Review on Diagnosing Gastric Cancer using a Tri-Algorithm Gastronet}, 
  year={2023},
  volume={},
  number={},
  pages={1039-1048},
  abstract={Gastric cancer (GC) is a widespread malignant tumour that unfortunately carries a bleak prognosis. Detecting it early is crucial, and for this, endoscopic examination plays a vital role. However, further treatment necessitates pathological confirmation and CT scanning. Despite medical advancements, gastric cancer remains a deadly disease, challenging our efforts to improve prognosis. In pursuit of more accurate gastric cancer diagnosis, a project has been undertaken to develop a method using deep learning algorithms. This approach recognizes the substantial number of tests involved in reaching a conclusive diagnosis. The proposed deep learning algorithm, known as Gastronet, has shown promising results. Gastronet is a unique combination of three different algorithms: Multi-task Net, Fusion Net, and Global Net. Through their collaboration, Gastronet offers precise predictions of gastric cancer without the need for additional diagnostic procedures. The implementation of this advanced algorithm contributes significantly to the effective and accurate diagnosis of gastric cancer, surpassing the capabilities of existing models},
  keywords={Deep learning;Urban areas;Prediction algorithms;Cognition;Prognostics and health management;Medical diagnostic imaging;Cancer;gastric cancer;gastronet;machine learning;Region Based Convolutional Neural Networks (R-CNN);deep learning.},
