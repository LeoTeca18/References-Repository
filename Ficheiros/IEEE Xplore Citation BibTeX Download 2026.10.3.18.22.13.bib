  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={Ensemble Machine Learning Models for Treatment Response Prediction and Adaptive Patient Allocation in Cancer Clinical Trials}, 
  year={2025},
  volume={},
  number={},
  pages={2034-2039},
  abstract={Traditional clinical trial methodologies face limitations in predicting individual patient responses to oncological therapeutics, necessitating advanced predictive approaches for personalized treatment selection. To develop and validate machine learning models for predicting treatment response and implement adaptive randomization algorithms to optimize patient outcomes in clinical trials. This retrospective cohort study analyzed 2,156 patients from phase II-III oncology trials (20182024). Multiple machine learning algorithms including logistic regression, random forest, support vector machines, XGBoost, and ensemble methods were developed using clinical, molecular, and laboratory features. External validation was performed on 856 independent patients. The ensemble model achieved superior discriminative performance (AUC-ROC: 0.862, 95% CI: 0.8370.887) compared to traditional clinical scoring (AUC-ROC: 0.698, $\mathrm{p}<0.001$). External validation maintained robust performance (AUC-ROC: 0.831). Mutation burden and performance status were the most predictive features. The adaptive randomization algorithm allocated 68.4 % of patients to optimal treatments versus 50 % with conventional randomization, improving overall response rates by $12.3 \%(\mathbf{p}<0.001)$. Machine learning significantly enhances clinical trial efficiency and patient outcome prediction, demonstrating clear clinical utility for treatment optimization and patient stratification in precision oncology.},
  keywords={Space exploration;Digital audio broadcasting;Broadcasting;Protocols;Receivers;HTTP;Digital audio broadcasting;Digital communication;Communication systems;Communication equipment;Machine learning;Clinical trials;Adaptive randomization;Precision oncology;Treatment response prediction},
