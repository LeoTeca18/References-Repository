  month={Jan},}@INPROCEEDINGS{11646104,
  author={Patil, Prathamesh and Pradnya.S.Kulkarni},
  booktitle={2026 4th International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Lung Cancer Detection from Histopathological Images using Custom CNN With XAI Techniques}, 
  year={2026},
  volume={},
  number={},
  pages={1910-1916},
  abstract={One of the leading causes of cancer-related mortality worldwide is lung cancer. Improving patient survival requires early and precise diagnosis. Recent developments in deep learning make it possible to analyse histopathological lung pictures automatically. Because most deep learning models are opaque and considered black-box systems, their application in clinical practice is constrained. An explainable deep-learning framework for the categorisation of lung cancer is presented in this article. Gradient-weighted Class Activation Mapping (Grad-CAM) visualisation and a custom Convolutional Neural Network are also used. Three classes of histopathological lung tissue images: lung squamous cell carcinoma, lung adenocarcinoma, and normal tissue. Images are scaled to 224*224 pixels and preprocessed using data augmentation and normalisation techniques to enhance generalisation before training. With a test accuracy of 96.62%, the suggested Custom CNN is comparable to existing deep learning models like DenseNet121 (96.6%) and other CNN-based methods documented in earlier research. The suggested approach uses Grad-CAM to provide visual interpretability alongside classification performance.},
  keywords={Lungs;Modeling;Convolutional neural networks;Lung cancer;Tumors;Biological tissues;Visualization;Cams;Computer aided manufacturing;Accuracy;Convolutional Neural Network (CNN);Explainable Artificial Intelligence (XAI);Histopathological Images Lung Cancer Detection;Grad-CAM;LIME;SHAP Medical Image Classification;Deep Learning;Computer-Aided Diagnosis},
  doi={10.1109/ICSCSS69635.2026.11646104},
  ISSN={},
  month={July},}@INPROCEEDINGS{10822416,
  author={He, Dongmei and Yang, Xin and Zhan, Buchao and Zhang, Zilong and Zhang, Qingchen and Yan, Shankai},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Augmented Mycobiome-Based Cancer Detection by an Interpretable Large Model}, 
  year={2024},
  volume={},
  number={},
  pages={925-931},
  abstract={The microbiome has emerged as a promising predictor of human cancers. Fungi are important components of the human microbiome and are closely associated with cancer. However, our understanding of the function and efficacy of fungal cells in tumors remains limited, making it challenging to accurately detect cancer tissues using limited tumor mycobiome data. Transfer learning has recently revolutionized the bioinformatics field by leveraging deep learning models pre-trained on large-scale general datasets, effectively addressing the predicted issue in tasks with limited data. Here, we propose an interpretable large model, MCaPred, that encodes different tumor tissue sites with microbiome features. The model was pre-trained on large-scale microbiome data from different tumor tissue sites to predict cancer in limited mycobiome data samples, thereby exploring the association between fungi and cancer-type specificity. Studies have shown that MCaPred outperforms recent deep learning models in cancer screening based on tumor mycobiome data and that mycobiome-based cancer detection is augmented by pretrained models. More importantly, MCaPred can capture key factors from mycobiome data related to specific cancer occurrences because of its high interpretability. The proposed model, analysis code, and supplementary materials used in this study are available at GitHub (https://github.com/cskyan/MCaPred.git). Contact: hedongmei@hainanu.edu.cn or skyan@hainanu.edu.cn},
  keywords={Fungi;Deep learning;Biological system modeling;Transfer learning;Predictive models;Cancer detection;Data models;Bioinformatics;Cancer;Tumors;deep learning;cancer detection;microbiome;mycobiome;classifications;Interpretable},
  doi={10.1109/BIBM62325.2024.10822416},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{11661820,
  author={Maniruzzaman, Md. and Salman, Rejaul Islam and Tawhid, Kazi Golam and Bala, Bholanath and Hossain, Md. Mahbub and Ahsan, Md. Shamim},
  booktitle={2026 International Conference on Power, Electronics, Communications, Computing, and Intelligent Infrastructure (PECCII)}, 
  title={A Novel Attention-Enhanced Hybrid Deep Learning Model for GI Disease Classification}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Gastrointestinal diseases represent a major global health burden, necessitating accurate and timely diagnostic interventions. While endoscopy is the gold standard for diagnosis, manual interpretation is often hindered by cognitive fatigue and inter-observer variability. To address these challenges, this study proposes a novel attention-enhanced hybrid deep learning architecture for the automated multi-class classification of GI pathologies from endoscopic images. The proposed framework integrates two state-of-the-art backbones: ConvNeXt Base and EfficientNetV2-Small. Dual independent squeeze-and-excitation attention modules in each branch to recalibrate channel-wise features before fusion is implemented. The model is evaluated on the Kvasir v2 dataset, comprising 8,000 images across eight disease classes. The model’s performance is evaluated using multiple assessment methods, including training and validation loss and accuracy curves, a confusion matrix, standard classification metrics such as accuracy, precision, recall, and F1-score, as well as computational performance measures including inference latency and throughput. Results demonstrate that the hybrid model achieves an overall accuracy of 93.12%, outperforming individual backbone baselines. Excellent classification performance with 100% accuracy is noted for polyps and ulcerative-colitis, while challenging classes like esophagitis and normal-z-line are effectively differentiated despite visual similarities. Furthermore, the model exhibits a real-time inference latency of 32.65 ms and a throughput of 30.62 images/second, ensuring its practical deployability in clinical endoscopy suites. This research highlights the synergy of hybrid architectures in enhancing diagnostic robustness and efficiency for medical imaging.},
  keywords={Modeling;Training;Accuracy;Diseases;Architecture;Computer architecture;Geographic information systems;Printing;Learning (artificial intelligence);Gastrointestinal tract;gastrointestinal;endoscopic;squeeze-and-excitation;ConvNeXt;EfficientNetV2},
  doi={10.1109/PECCII70991.2026.11661820},
  ISSN={},
  month={June},}@ARTICLE{11389755,
  author={Sar, Ayan and Kumar, Ankit and Roy, Sampurna and Kaushish, Anurag and Choudhury, Tanupriya and Minakshi and Alqahtani, Saad Saeed and Abraham, Ajith},
  journal={IEEE Access}, 
  title={Quantum Machine Learning in Medical Image Analysis: From Diagnostics to Surgery Planning}, 
  year={2026},
  volume={14},
  number={},
  pages={27690-27732},
  abstract={Quantum Machine Learning (QML) is an emerging, powerful paradigm at the intersection of quantum computing and artificial intelligence, with the potential to enhance medical image analysis. We compared their performance with classical counterparts, while critically examining the gap between theoretical quantum advantages and the practical constraints of current Noisy Intermediate-Scale Quantum (NISQ) implementations. This review explored the current landscape of QML-based methodologies applied to key medical imaging modalities - Magnetic Resonance Imaging (MRI), Computed Tomography (CT), X-rays, and histopathology. We systematically analyzed how quantum-enhanced models were employed for critical tasks such as image classification, segmentation, and reconstruction, and we compared their performance with that of classical counterparts. The review delved into the architectural innovations that enabled these quantum approaches, including hybrid quantum-classical frameworks, variational quantum circuits, and quantum convolutional neural networks. Particular emphasis was given to the clinical relevance of QML applications, from early diagnostics to real-time surgery planning, and how quantum advantage might influence data efficiency, interpretability, along computational scalability. Finally, we highlighted current challenges in data encoding, noise resilience, and hardware limitations, and discussed promising future directions that could enable the practical deployment of QML in healthcare settings. This comprehensive review aimed to serve as a foundational reference for researchers and practitioners looking to harness quantum computing in medical imaging and precision medicine.},
  keywords={Computational modeling;Medical diagnostic imaging;Quantum computing;Magnetic resonance imaging;Image analysis;Solid modeling;Quantum mechanics;Data models;Reviews;Image segmentation;Hybrid quantum-classical models;medical image reconstruction;quantum convolutional neural networks;quantum image segmentation;quantum machine learning (QML);variational quantum circuits},
  doi={10.1109/ACCESS.2026.3663498},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9607699,
  author={Chao, Sherry and Belanger, David},
  booktitle={2021 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={Generalizing Few-Shot Classification of Whole-Genome Doubling Across Cancer Types}, 
  year={2021},
  volume={},
  number={},
  pages={3375-3385},
  abstract={The study and treatment of cancer is traditionally specialized to the cancer’s primary site of origin. However, certain phenotypes are shared across cancer types and have important implications for clinical care. To date, automating the identification of these characteristics from routine clinical data - irrespective of the type of cancer - is impaired by tissue-specific variability and limited labeled data. Whole-genome doubling is one such phenotype; whole-genome doubling events occur in nearly every type of cancer and have significant prognostic implications. Using digitized histopathology slide images of primary tumor biopsies, we train a deep neural network model end-to-end to accurately generalize few-shot classification of whole-genome doubling across 17 cancer types. By taking a meta-learning approach, cancer types are treated as separate but jointly-learned tasks. This approach outperforms a traditional neural network classifier and quickly generalizes to both held-out cancer types and batch effects. These results demonstrate the unrealized potential for meta-learning to not only account for between-cancer type variability but also remedy technical variability, enabling real-time identification of cancer phenotypes that are too often costly and inefficient to obtain.},
  keywords={Deep learning;Computer vision;Histopathology;Conferences;Neural networks;Real-time systems;Task analysis},
  doi={10.1109/ICCVW54120.2021.00377},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{10724395,
  author={Mou, Shahida Islam and Arif, Abu Shamim Mohammad},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Prediction of Lung Cancer using Genetic Algorithm and Machine Learning Technique}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={As Lung cancer is a life-threatening disease for human beings, for the sake of saving lives, early detection of lung cancer is obligatory. Many existing methods have been proposed to predict lung cancer, but there is a scope to enhance the effectiveness of the existing methods with an optimal number of features. We have proposed a method based on Machine Learning (ML) and Genetic Algorithm (GA) approaches to predict lung cancer. The dataset has been collected from data.world. In our proposed method, we optimized the features using the feature selection technique and applied the ML method to classify lung cancer patients. The GA’s fitness function and operators have been designed for feature selection. Three classifiers were employed for the classification of Decision Tree, XG Boost, and Support Vector Machine (SVM). In this study, our proposed method reached 100% accuracy, which left behind other existing methods with 13 out of 24 features. In light of the experiment’s outcomes, the proposed method outperformed the other strategies currently using the fewest features.},
  keywords={Support vector machines;Accuracy;Lung cancer;Machine learning;Feature extraction;Vectors;Decision trees;Genetic algorithms;Diseases;genetic algorithm;feature;accuracy;prediction;support vector machine},
  doi={10.1109/ICCCNT61001.2024.10724395},
  ISSN={2473-7674},
  month={June},}@ARTICLE{11396922,
  author={Kundu, Souraja and Patkar, Shruti S. and Mishra, Saras Mani and Trivedi, Gaurav and Merchant, Farhad},
  journal={IEEE Internet of Things Journal}, 
  title={A Comprehensive Review of Tsetlin Machines: Concepts, Applications, Analysis, and the Future}, 
  year={2026},
  volume={13},
  number={10},
  pages={20105-20127},
  abstract={With the rise of large language models, two significant challenges are their high power consumption during training and their opaque nature. The Tsetlin machine (TM) offers a logic-based, interpretable alternative to traditional machine learning (ML) models to address these issues. TM is used in various ML-based edge computing and Internet of Things (IoT) applications, such as batteryless sensors, resource-constrained intrusion detection, and on-device training. It shows  $30.5\times $  reduction in computation cost,  $36.6\times $  reduction in storage memory footprint,  $13.5\times $  reductions in latency and energy, and converges faster than neural networks. It can be implemented on different hardware platforms, including field-programmable gate arrays, superconducting circuits, and memristor-transistor arrays. Filling a gap, we provide a holistic reference containing more than 160 implementations of TMs. In this tutorial and survey, we explain the algorithm of the basic TM in detail with a background of learning automata (LA). Next, we discuss different TM variants, including the regression TM (RTM), federated learning (FL)-based TMs, the coalesced TM (CoTM), real and integer-weighted TMs (IWTMs), and the convolutional TM (CTM) for text and image classification. We classify these software and hardware implementations based on their algorithmic similarities and compare them using key performance metrics such as accuracy, training time, energy consumption per classification, and operating frequency. In addition, we discuss our observations on general trends, insights from our comparative analysis, limitations of existing implementations, and potential directions for future research to further extend its applicability in energy-efficient IoT and edge computing applications.},
  keywords={Learning automata;Internet of Things;Training;Automata;Natural language processing;Hardware;Field programmable gate arrays;Reviews;Computational modeling;Image edge detection;Deep learning (DL);edge computing;Internet of Things (IoT);learning automata (LA);reinforcement learning (RL);Tsetlin machine (TM)},
  doi={10.1109/JIOT.2026.3665145},
  ISSN={2327-4662},
  month={May},}@INPROCEEDINGS{11013845,
  author={Podder, Nitun Kumar and Kumkum, Bima and Akhter, Fahima},
  booktitle={2025 International Conference on Electrical, Computer and Communication Engineering (ECCE)}, 
  title={Network-Based Bioinformatics Approaches to Identify Molecular Biomarkers for Diabetes on the Progression of Cancers}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Diabetes is one of the most concerning diseases in the world today. According to the IDF Diabetes Atlas, almost 537 million 20-79 years old adults are living with diabetes and they predicted this number will be increased 643 million in 2030. In Type-1 diabetes the pancreas doesn’t produce enough insulin, frequently seen in both children and adults. And In Type-2 diabetes (T2D) the body doesn’t use insulin hormone that regulate the movement of glucose into cells to use as energy effectively. Higher blood sugar level provides an adequate supply of energy for rapidly dividing cancer cells that causes cancer progression. Patients with both diabetes and cancer have more risky than without diabetes and diabetes influence cancer progression. In our study we tried to determine the link between Diabetes and various cancers including Breast Cancer (BS), Ovarian Cancer (OC), Cervical Cancer (CC) and Stomach or Gastric Cancer (GC). Here we were using a network-based bioinformatics approach to uncover the connection in Diabetes with the development of selected cancers. We have found that Diabetes is linked with cancers progression sharing with 46, 46, 46, 79 Differentially Expressed Genes (DEGs) with BC, OC, CC and GC respectively. Then we constructed up and down diseasome network, Protein-Protein Interactions (PPIs), significant pathways and ontological analysis, Protein-Drug Interactions (PDIs), survival analysis and validate our study using Gold Benchmark datasets. In our entire study we used the Gene Expression Omnibus (GEO) dataset, STRING database, TCGA database, gold benchmark database, Enrichr tools, NetworkAnalyst, Cytoscape, Python and R programming language. This study depicts the significant correlation between and specific cancers that require more clinical focus and facilitating better disease prediction based on genetic biomarker and advanced research.},
  keywords={Proteins;Gold;Databases;Breast cancer;Diabetes;Insulin;Bioinformatics;Cervical cancer;Cancer;Ovarian cancer;Diabetes Mellitus;T2D;Breast Cancer;Ovarian Cancer;Cervical Cancer;Gastric cancer;Cancer Progression;Up and Down Diseasome Network;PPI Netwok;PDI Network;Survival Analysis},
  doi={10.1109/ECCE64574.2025.11013845},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11313122,
  author={Mostafa, Amany and Mounir, Mahmoud and Gad, Walaa},
  booktitle={2025 Twelfth International Conference on Intelligent Computing and Information Systems (ICICIS)}, 
  title={Integration of Multi-Omics Data in Cancer Research: Challenges, Computational Approaches and Applications}, 
  year={2025},
  volume={},
  number={},
  pages={538-545},
  abstract={The integration of multi-omics data is crucial in cancer research, as it helps unravel the complexity of molecular interactions across various omics modalities. This facilitates biomarker discovery and supports key clinical applications such as diagnosis, prognosis, classification and personalized treatment. By combining multiple datasets derived from different omics layers, including genomics, transcriptomics, proteomics, metabolomics, and epigenomics, researchers can gain an all-encompassing insight that enriches our comprehension of cancer biology. This study critically reviews the major computational approaches applied in multi-omics data integration, compares their advantages and limitations, highlights recent breakthroughs in cancer research, and outlines the emergence of existing challenges. The goal is to support both researchers and clinicians in selecting appropriate integration approaches to advance translational cancer research.},
  keywords={Technological innovation;Statistical analysis;Reviews;Precision medicine;Transcriptomics;Proteomics;Complexity theory;Prognostics and health management;Cancer;Tumors;Cancer research;multi-omics integration;machine learning;deep learning;biomarker identification;statistical methods},
  doi={10.1109/ICICIS66182.2025.11313122},
