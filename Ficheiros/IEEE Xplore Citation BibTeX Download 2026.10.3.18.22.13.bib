  pages={1-6},
  abstract={Polyps can be missed as a result of fatigue or inattention during prolonged or consecutive colonoscopies, with an estimated average rate of 16.8-28%. Consequently, patients with undetected polyps are less likely to survive late-stage colorectal cancer than those without polyps. The detection of polyps in colonoscopy images has been automated using a variety of approaches in order to address this issue. As a result, polyps will be prevented from being overlooked by humans, and the time and expense associated with screening numerous colonoscopies or wireless capsule endoscopies will be reduced. Our primary goal is to develop a system that precisely defines the location of polyps on an image, therefore increasing overall detection accuracy and enabling timely identification of colorectal cancer. In this work, we aim to combine UNet architecture with the pretrained model Inception-Resnet-V2 in the Encoder, and then a phase of segmentation Refinement based superpixels with Simple Linear Iterative Clustering (SLIC) for superpixels generation. The proposed methods’ average Dice on CVC-Clinic612 dataset is 0.8903, with MIoU and MPA of 0.8085 and 0.9796 respectively, and the average Dice on Kvasir-SEG dataset is 0.8758 with MIoU and MPA of 0.7936 and 0.9567 respectively. Comparing the results to state-of-the-art methods, the results show high performance.},
  keywords={Image segmentation;Wireless networks;Refining;Colonoscopy;Mobile communication;Fatigue;Gastrointestinal tract;colonoscopy;superpixels;Convolutional neural networks;Inception-Resnet-V2;segmentation},
  doi={10.1109/WINCOM59760.2023.10322947},
  ISSN={2769-9994},
  month={Oct},}@ARTICLE{9300148,
  author={Wright, Alexander I. and Dunn, Catriona M. and Hale, Michael and Hutchins, Gordon G. A. and Treanor, Darren E.},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={The Effect of Quality Control on Accuracy of Digital Pathology Image Analysis}, 
  year={2021},
  volume={25},
  number={2},
  pages={307-314},
  abstract={Digital slide images produced from routine diagnostic histopathological preparations suffer from variation arising at every step of the processing pipeline. Typically, pathologists compensate for such variation using expert knowledge and experience, which is difficult to replicate in automated solutions. The extent to which inconsistencies affect image analysis is explored in this work, examining in detail, the results from a previously published algorithm automating the generation of tumor:stroma ratio (TSR) in colorectal clinical trial datasets. One dataset consisting of 2,211 cases and 106,268 expert-labelled images is used to identify quality issues, by visually inspecting cases where algorithm-pathologist agreement is lowest. Twelve categories are identified and used to analyze pathologist-algorithm agreement in relation to these categories. Of the 2,211 cases, 701 were found to be free from any image quality issues. Algorithm performance was then assessed, comparing pathologist agreement with image quality classification. It was found that agreement was lowest on poorly differentiated tissue, with a mean TSR difference of 0.25 (sd = 0.24). Removing images that contained quality issues increased accuracy from 80% to 83%, at the expense of reducing the dataset to 33,736 images (32%). Training the algorithm on the optimized dataset, prior to testing on all images saw a decrease in accuracy of 4%, indicating that the optimized dataset did not contain enough variation to generate a fully representative model. The results provide an in-depth perspective on image quality, highlighting the importance of the effects on downstream image analysis.},
  keywords={Image color analysis;Pathology;Tumors;Image quality;Biomedical imaging;Clinical trials;Classification algorithms;Image quality;digital slides;clinical trials;machine learning;algorithm accuracy},
