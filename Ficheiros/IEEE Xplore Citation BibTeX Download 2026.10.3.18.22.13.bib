  month={May},}@INPROCEEDINGS{11608997,
  author={Basheeruddin, Mohd and Anjankar, Ashish P and Qausain, Sana and Ingole, Rushikesh P},
  booktitle={2026 IEEE 1st International Conference on Intelligent Technologies for a Sustainable and Inclusive Future (ICITSIF)}, 
  title={From Molecules to Models: AI-Based Analysis of Aspirin Effects on Protein Stability and Cardiovascular Disease}, 
  year={2026},
  volume={},
  number={},
  pages={1444-1449},
  abstract={Aspirin is an old mainstay of cardiovascular disease therapy owing to its antiplatelet and anti-inflammatory effects via inhibition of cyclooxygenase. Some growing evidence, however, is pointing to its direct effect on protein structure and stability more directly as part of its therapeutic effect than classical, and these are the key determinants of cardiovascular homeostasis. Misfolding, aggregation and functional instability of proteins are some of the causes of vascular inflammation, endothelial dysfunction and plaque susceptibility. Here, analogy tools of artificial intelligence offer good means to combine molecular, biophysical, and clinical data to gain more mechanistic insight. This is a review of experimental and clinical findings combined with AI-engaged molecular modeling, interaction prediction, and systems-level analyses to discuss the impact of aspirin on protein folding, acetylation, and functional resilience in cardiovascular disease. Special attention is paid to non-cyclooxygenase targets, such as inflammatory mediators and cell stress-response proteins, such as heat shock proteins, which are protective under conditions of oxidative and hemodynamic stresses. It has been demonstrated by AI-based models that the aspirin-driven alteration in the stability of proteins can suppress inflammatory signals, enhance cellular resistance to stress, and stabilize molecular networks in thrombosis and atherosclerosis. These lessons lead to the change of paradigm where single-target pharmacology should be supplanted by data-driven, systems-oriented cardiovascular therapeutics and emphasizes the importance of artificial intelligence in enhancing the clinical potential of aspirin.},
  keywords={Aspirin;Proteins;Tumors;Cancer;Manuals;Stability;Medical treatment;Cardiovascular diseases;Chemical vapor deposition;Biomarkers;Aspirin;Artificial Intelligence;Protein Stability;Cardiovascular Disease;Molecular Modeling;Inflammation},
