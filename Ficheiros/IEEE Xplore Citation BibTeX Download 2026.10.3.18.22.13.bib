  month={},}@INPROCEEDINGS{11356194,
  author={Wang, Shuaihao and Liu, Zhihong and Liu, Liangliang},
  booktitle={2025 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={A Breast Cancer Biomarker Prediction Method Based on Cross-Modal Adaptive Attention Collaboration}, 
  year={2025},
  volume={},
  number={},
  pages={2502-2507},
  abstract={HER2 is a critical biomarker for the diagnosis and prognosis of breast cancer. However, accurately predicting HER2 status from pathological images remains challenging due to tumor heterogeneity and the complexity of molecular mechanisms. Existing methods that integrate clinical and pathological features often struggle with structural semantic discretization, resulting in cross-modal information loss and semantic gaps. We propose a cross-modal adaptive attention collaboration neural network (CMCNet) to address these limitations. The proposed model features a heterogeneous dual-branch architecture to align and fuse pathological images and clinical data. A hierarchical Transformer architecture is employed to extract both local cell-level and global tissue-level semantic features from pathology images, while a large language model is used to capture sequential semantic information from clinical features. To further enhance integration, a cross-modal adaptive attention mechanism is introduced to regulate feature fusion dynamically. We validated the model using 556 samples from the TCGA-BRCA dataset. Experimental results demonstrate that CMCNet achieves a maximum accuracy of 84.26% in predicting HER2 status, outperforming current state-of-the-art methods. Ablation studies confirm the contribution of each module, and visualization analyses offer new insights into HER2 status diagnosis and prognosis prediction.},
  keywords={Deep learning;Pathology;Adaptation models;Fuses;Semantics;Feature extraction;Transformers;Breast cancer;Data models;Prognostics and health management;Breast Cancer;HER2;Deep Learning;Multimodal;Data Fusion},
  doi={10.1109/BIBM66473.2025.11356194},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{10318469,
  author={Zhou, Lin and Zhu, Zhengzhi and Wang, Xinmiao and Gao, Hongbo},
  booktitle={2023 IEEE International Conference on Unmanned Systems (ICUS)}, 
  title={Multi-Omics Analysis for Improved Diagnosis, Prognosis, and Drug Response Prediction in Digestive System Tumors}, 
  year={2023},
  volume={},
  number={},
  pages={505-511},
  abstract={Digestive system tumors (DST) have been the leading cause of cancer-related deaths globally in recent decades, making accurate tumor diagnosis, prognosis improvement, and drug response prediction crucial issues in personalized medicine. With the explosion in massive biological data and the transition from traditional biostatistical methods to computer-assisted approaches, AI-based diagnostic support systems have shown great potential in medical computer-assisted fields. In this study, we propose a novel multi-omics integration approach, Multi-Omics Fusion Graph Convolutional Network (MFGCN), to construct diagnostic models, survival prediction models, and drug response prediction models for DST. Firstly, we calculate the similarity matrix of each omics data and use Graph Transformer (GT) to learn the new graph structure. Secondly, we use GCN to learn features of each omics data. Finally, to integrate features of different omics for prediction, we use View Correlation Discovery Network (VCDN). Our experimental results outperform other currently advanced methods, offering significant potential value for personalized medicine of DST.},
  keywords={Drugs;Computational modeling;Biological system modeling;Precision medicine;Digestive system;Predictive models;Transformers;digestive system tumors;diagnosis;prognosis;drug response;Multi-Omics},
  doi={10.1109/ICUS58632.2023.10318469},
  ISSN={2771-7372},
  month={Oct},}@ARTICLE{11071277,
  author={Alharthi, Abdullah S. and Alqurashi, Ahmed and Essa Alharbi, Turki and Alammar, Mohammed M. and Aldosari, Nasser and Bouchekara, Houssem R. E. H. and Sha’aban, Yusuf A. and Shoaib Shahriar, Mohammad and Al Ayidh, Abdulrahman},
  journal={IEEE Access}, 
  title={Explainable AI for Sensor Signal Interpretation to Revolutionize Human Health Monitoring: A Review}, 
  year={2025},
  volume={13},
  number={},
  pages={115990-116024},
  abstract={The complexity of sensor signal patterns in healthcare, coupled with the variability of physiological data present significant challenges in developing reliable diagnostic and monitoring. While machine learning (ML) has greatly advanced sensor-based health analysis, its decision-making processes often lack transparency, raising concerns about reliability and clinical adoption. This review explores the role of Explainable Artificial Intelligence (XAI) in enhancing the interpretability of ML models for sensor signal analysis, particularly in applications such as pressure sensors, wearable inertial sensors, imaging sensors (MRI, CT, X-ray), ECG, EEG, and wearable health tracking. A systematic literature review was conducted across multiple databases to identify studies applying XAI techniques to sensor-based health monitoring. The review categorizes nine trending XAI methods used to interpret ML-driven analyses of biosignals, evaluating their advantages and limitations in different healthcare scenarios. The findings emphasize the importance of transparency in ML-driven sensor analysis, which is critical for building trust and real-time clinical decision-making and wearable healthcare applications. Despite its potential, XAI for sensor signals faces challenges related to model scalability, real-time processing, and clinician interpretability. The review identifies key research gaps in integrating XAI into sensor-based healthcare systems, emphasizing the need for robust validation methods and user-friendly explanations. Ultimately, XAI offers a promising path toward revolutionizing sensor-driven health monitoring, though further advancements are necessary to fully integrate explainability into real-world clinical and assistive applications.},
  keywords={Medical services;Monitoring;Explainable AI;Diseases;Robot sensing systems;Reviews;Biomedical monitoring;Prediction algorithms;Machine learning;Accuracy;Explainable AI human health;gait;Parkinson’s disease;stroke;depression;cancer;heart disease;Alzheimer’s disease},
  doi={10.1109/ACCESS.2025.3585764},
  ISSN={2169-3536},
  month={},}@ARTICLE{11216152,
  author={Jalil, Mustafa A. and Zafra, Amelia},
  journal={IEEE Access}, 
  title={Deep Learning in Multiple Instance Learning: Methods, Applications, and Research Trends}, 
  year={2025},
  volume={13},
  number={},
  pages={189629-189669},
  abstract={Multiple instance learning (MIL) is a flexible learning framework where data is organized into sets of instances, called bags, with a single label assigned to the entire bag instead of individual instances. This formulation is especially suitable for addressing complex problems by allowing greater flexibility in their representation using weakly labeled data. As in other learning frameworks, Deep Learning (DL) approaches have been applied to solve MIL problems showing very interesting results. This systematic review aims to provide a comprehensive review of all recent research efforts on DL based on MIL. Thus, 173 papers published from 2016 are analyzed. A unified taxonomy is proposed that relates DL architectures with MIL strategies and learning frameworks, providing an integrated view on their interactions. In addition, the main types of architectures, learning frameworks, assumptions, applications, datasets, and tools are discussed in detail. Relevant findings indicate that Convolutional Neural Networks remain the most commonly used architectures, with a growing trend toward hybrid models that incorporate attention mechanisms, transformers, or recurrent networks. While early MIL approaches primarily relied on instance-based strategies under the standard assumption, more recent studies reveal a clear shift toward the extended assumption, particularly within hybrid architectures. Bag-based strategies remain less prevalent and are mainly explored through hybrid models. Most of the reviewed studies focus on classification tasks, where the diversity of MIL assumptions and architectural choices is more pronounced, while regression tasks have been addressed less frequently. Regarding the applications, medical diagnosis is the most widely used application, with the most available resources. Also, it was found that Python is the most frequently used tool in the reviewed papers. Finally, we point out the open issues and future research directions. Some key challenges such as the adaptation of generative architectures in unsupervised learning and the improvement of robustness in the models are still open to be addressed.},
  keywords={Taxonomy;Systematic literature review;Deep learning;Computer architecture;Weak supervision;Standards;Semisupervised learning;Data models;Annotations;Uncertainty;Systematic review;deep learning;multiple instance learning},
  doi={10.1109/ACCESS.2025.3625449},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10331672,
  author={Elangovan, A. and Nagarajan, M.},
  booktitle={2023 International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)}, 
  title={Comparative Analysis of Machine Learning Models for Early Prediction of Cancer}, 
  year={2023},
  volume={},
  number={},
  pages={325-332},
  abstract={A deadly and occasionally fatal condition, cancer may have a number of detrimental effects on the body, represents one among the main causes of death, and is getting harder and harder to diagnose. Every type of cancer involves a unique group of characteristics, signs, and treatments, and early detection and care are crucial for a good prediction. On the basis of the type as well as position of the tumor, doctors employ a range of methods to diagnose cancer. One among the methods doctors utilize to identify cancer is imaging testing, like MRI scans, CT scans, X-rays, and PET scans, which may offer exact images of the body's internal components to notice any discrepancies. By emphasizing the importance of ML and DL methods like KNN, SVM, NB, DT, Deep Boltzmann machine, DNN, and others, this survey determines computational-intelligence techniques and offers a way to influence future work.},
  keywords={Surveys;Support vector machines;Magnetic resonance imaging;X-rays;Machine learning;Learning (artificial intelligence);Predictive models;Cancer Prediction;Early stage;Machine Learning;Deep Learning},
  doi={10.1109/ICSSAS57918.2023.10331672},
