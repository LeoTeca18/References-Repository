@ARTICLE{9971460,
  author={Oberste, Luis and Heinzl, Armin},
  journal={IEEE Transactions on Artificial Intelligence}, 
  title={User-Centric Explainability in Healthcare: A Knowledge-Level Perspective of Informed Machine Learning}, 
  year={2023},
  volume={4},
  number={4},
  pages={840-857},
  abstract={Explaining increasingly complex machine learning will remain crucial to cope with risks, regulations, responsibilities, and human support in healthcare. However, extant explainable systems mostly provide explanations that mismatch clinical users’ conceptions and fail their expectations to leverage validated and clinically relevant information. A key to more user-centric and satisfying explanations can be seen in combining data-driven and knowledge-based systems, i.e., to utilize prior knowledge jointly with the patterns learned from data. We conduct a structured review of knowledge-informed machine learning in healthcare. In this article, we build on a framework to characterize user knowledge and prior knowledge embodied in explanations. Specifically, we explicate the types and contexts of knowledge to examine the fit between knowledge-informed approaches and users. Our results highlight that knowledge-informed machine learning is a promising paradigm to enrich former data-driven systems, yielding explanations that can increase formal understanding, convey useful medical knowledge, and are more intuitive. Although complying with medical conception, it still needs to be investigated whether knowledge-informed explanations increase medical user acceptance and trust in clinical machine learning-based information systems.},
  keywords={Artificial intelligence;Medical diagnostic imaging;Medical services;Machine learning;Diseases;Data models;Predictive models;Artificial intelligence (AI) in medicine;explainable AI;human-centered AI;interpretable AI;knowledge-based systems;machine learning},
  doi={10.1109/TAI.2022.3227225},
  ISSN={2691-4581},
  month={Aug},}@INPROCEEDINGS{11085956,
  author={GaneshNaidu, U and G, Mahesh and M, V T Ram Pavan Kumar and Subbarao, Ch and Varma, A V S S and Johnsana, J S Linda},
  booktitle={2025 6th International Conference on Intelligent Communication Technologies and Virtual Mobile Networks (ICICV)}, 
  title={Machine Learning-Driven Personalized Cancer Treatment: Evaluating Supervised and Reinforcement Learning Approaches}, 
  year={2025},
  volume={},
  number={},
  pages={40-46},
  abstract={This research explores the application of machine learning techniques in recommending personalized cancer treatments, comparing supervised learning and reinforcement learning approaches. By leveraging historical patient data, the study predicts optimal treatment strategies, with models like XGBoost and Artificial Neural Networks demonstrating superior accuracy. Feature selection methods identified key patient-specific factors influencing treatment outcomes, ensuring model interpretability and relevance. Rigorous statistical validation confirmed the substantial advantage of advanced machine learning models in improving predictive reliability. Among these, XGBoost emerged as particularly effective, highlighting its potential in optimizing personalized therapy decisions. The findings emphasize the transformative role of machine learning in precision oncology, paving the way for data-driven treatment recommendations. Future research should integrate multi-modal data sources, including genomic, imaging, and clinical records, to enhance predictive accuracy. Additionally, incorporating explainable AI techniques will improve transparency and foster clinical trust, ultimately facilitating real-world implementation. This study underscores the promise of machine learning in revolutionizing cancer treatment personalization, guiding more informed and effective therapeutic strategies.},
  keywords={Accuracy;Soft sensors;Cancer treatment;Supervised learning;Imaging;Genomics;Reinforcement learning;Predictive models;Oncology;Reliability;Cancer Treatment;Machine Learning;Artificial Intelligence;Supervised Learning;Reinforcement Learning},
  doi={10.1109/ICICV64824.2025.11085956},
  ISSN={},
  month={June},}@ARTICLE{9858333,
  author={Rehman, Mujeeb Ur and Shafique, Arslan and Ghadi, Yazeed Yasin and Boulila, Wadii and Jan, Sana Ullah and Gadekallu, Thippa Reddy and Driss, Maha and Ahmad, Jawad},
  journal={IEEE Transactions on Network Science and Engineering}, 
  title={A Novel Chaos-Based Privacy-Preserving Deep Learning Model for Cancer Diagnosis}, 
  year={2022},
  volume={9},
  number={6},
  pages={4322-4337},
  abstract={Early cancer identification is regarded as a challenging problem in cancer prevention for the healthcare community. In addition, ensuring privacy-preserving healthcare data becomes more difficult with the growing demand for sharing these data. This study proposes a novel privacy-preserving non-invasive cancer detection method using Deep Learning (DL). Initially, the clinical data is collected over the Internet via wireless channels for diagnostic purposes. It is paramount to secure personal clinical data against eavesdropping by unauthorized users that may exploit it for personalized interests. Therefore, the collected data is encrypted before transmission over the channel to prevent data theft. Various security measures, including correlation, entropy, contrast, structural content, and energy, are used to assess the proposed encryption method's efficiency. In this paper, we proposed using the Convolutional Neural Network (CNN)-based model and Magnetic Resonance Imaging (MRI) with different techniques, including transfer learning, fine-tuning, and K-fold analysis cancer detection. Extensive experiments are carried out to evaluate the performance of the proposed DL techniques with regard to traditional machine learning approaches such as Decision Tree (DT), Naive Bayes (NB), Random Forest (RF), and Support Vector Machine (SVM). Results show that the CNN-based model has achieved an accuracy of 98.9% and outperforms conventional ML algorithms. Further experiments demonstrate the efficiency of both encryption schemes, achieving entropy, contrast, and energy of 7.9999, 10.9687, and 0.0151, respectively.},
  keywords={Encryption;Data security;Security;Magnetic resonance imaging;Convolutional neural networks;Deep learning;Cancer detection;Diagnosis;convolutional neural networks;chaos;data security},
  doi={10.1109/TNSE.2022.3199235},
  ISSN={2327-4697},
  month={Nov},}@INPROCEEDINGS{10906133,
  author={Yu, Yangziwei and Yu, Shuangle and Wang, Chuqiao and Zhou, Zhaoli},
  booktitle={2024 17th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics (CISP-BMEI)}, 
  title={The Construction of Prognosis-Prediction Model of Acute Myeloid Leukemia Based on NF-KB Signaling Pathway}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Acute myeloid leukaemia (AML) is a haematological malignancy characterized by uncontrolled growth of abnormal myeloid cells. The NF-κB signaling pathway is crucial for regulating inflammation, immune responses, and metabolic processes, yet there are few studies using bioinformatics to explore the association between NF-κB signature genes (referred to as GsigNF-κB) and AML. This study aims to dissect the predictive capability of GsigNF-κB on AML by categorizing AML patients based on GsigNF-κB characteristics, developing a prognostic model, and establishing a corresponding risk score.},
  keywords={Biological system modeling;Leukemia;Signal processing;Predictive models;Bioinformatics;Immune system;Biomedical engineering;AML;NF-κB signaling pathway;survival;prognostic model;bioinformatics},
  doi={10.1109/CISP-BMEI64163.2024.10906133},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10199476,
  author={SR, Naren and Veerasamy, Vanitha and Natrajan, Rajathi},
  booktitle={2023 2nd International Conference on Advancements in Electrical, Electronics, Communication, Computing and Automation (ICAECA)}, 
  title={A Platform to Assist Pathologists in the Cancer Detection Process}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Cancer is a complex disease affecting millions worldwide, and early detection and accurate diagnosis are crucial for effective treatment. Biopsy tiles are an essential diagnostic tool in cancer detection and play a significant role in cancer pathology. This research paper proposes the development of a website for multiple cancer detection using biopsy tiles, which would aid pathologists in affirming their findings in cancer pathology. The website would use machine learning algorithms to analyze biopsy tile images and provide a preliminary diagnosis for multiple cancer types. This paper outlines the gradio interface development, which entails using pre-trained neural networks like InceptionV3, ResNet50, Alex Net, and VGG16. The interface also helps the pathologists ensure how the model learns a specific image and can modify it according to their own purpose. Having given access to the code to the pathologists, they can even modify or integrate new data into the model. The proposed interface has the potential to improve the accuracy and efficiency of cancer diagnosis, which could ultimately lead to better patient outcomes.},
  keywords={Pathology;Electric potential;Machine learning algorithms;Biopsy;Neural networks;Cancer detection;Data models;cancer;cancer detection;pathologists;image classification;biopsy},
  doi={10.1109/ICAECA56562.2023.10199476},
  ISSN={},
  month={June},}@ARTICLE{10979932,
  author={Xu, Qiaoyi and Adam, Afzan and Abdullah, Azizi and Bariyah, Nurkhairul},
  journal={IEEE Access}, 
  title={A Review of Advanced Deep Learning Methods of Multi-Target Segmentation for Breast Cancer WSIs}, 
  year={2025},
  volume={13},
  number={},
  pages={76016-76037},
  abstract={Breast cancer is one of the most common cancers among women, with its heterogeneity posing significant challenges for diagnosis and treatment, profoundly impacting patient prognosis and quality of life. Whole Slide Imaging (WSI) in digital pathology provides high-resolution images that enable a comprehensive examination of the tumor microenvironment, offering advanced tools for breast cancer diagnosis and prognostic evaluation. However, manually reviewing whole slide images (WSIs) for tissue segmentation is time-consuming and prone to errors, highlighting the need for multi-target deep learning models to automate the segmentation of these complex structures. Multi-target segmentation offers distinct advantages by simultaneously processing multiple interrelated tissue regions within a single image, thereby enhancing accuracy and efficiency. Despite the potential of deep learning techniques in automating pathological analysis, their clinical adoption faces significant challenges. To address these, this paper proposes six criteria focused on clinical acceptability of deep learning methods: inherent limitations of WSIs, feature extraction, annotation requirements, efficiency, automated quantification, and interpretability. A rigorous review of publicly available datasets and deep learning methods identifies key challenges for clinical adoption. Following the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) guidelines, this review analyzes 29 core articles, highlighting the critical role of multi-target segmentation in breast cancer digital pathology while assessing the limitations of these techniques in clinical applications. Based on this analysis, this paper proposes six criteria to enhance the diagnostic performance of deep learning methods in multi-target segmentation for breast cancer digital pathology and to improve the clinical acceptability of deep learning methods.},
  keywords={Annotations;Breast cancer;Pathology;Deep learning;Image segmentation;Cancer;Accuracy;Image resolution;Feature extraction;XML;Breast cancer;multi-target segmentation;digital pathology;whole slide images;segmentation algorithms;deep learning},
  doi={10.1109/ACCESS.2025.3565648},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11227617,
  author={Su, Yu and Wang, Peng},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={M2SOPT: Multi-scale Multi-modal Survival Outcome Prediction Transformer}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={With the rising incidence of cancer, precise diagnostics and accurate predictions of disease-free survival periods have become increasingly crucial for devising effective treatment strategies. The rapid development of large-scale models has driven innovations in cancer risk prediction methods. Initially, the existing models fused WSI images and genomic data directly through a co-attention mechanism, with WSI and genomic data processed through separate networks. However, this approach failed to address the fundamental issue of the vast number of features in WSI images compared to the relatively few features in genomic data, leading to suboptimal performance. To resolve this issue, we propose a new framework called the Multi-Scale Multi-Modal Survival Outcome Prediction Transformer (M2SOPT). Unlike traditional methods, the M2SOPT framework adopts a multi-scale fusion strategy, introducing multi-scale WSI features to better handle the Gigapixel nature of WSI images. It also employs an auxiliary attention mechanism to effectively integrate features across different levels. Moreover, we introduce a genomic-guided multi-scale co-attention mechanism for early modal fusion, addressing the challenge posed by the disparity in feature counts between the two modalities. With these improvements, M2SOPT better handles the difficulties in merging WSI images and genomic data, significantly enhancing survival prediction performance. Our research demonstrates that this new framework notably improves survival prediction across various cancer types in datasets from the GDC Data Portal. Specifically, for breast cancer and endometrial cancer, the c-index scores increased by 10.0% and 10.2%, respectively.},
  keywords={Technological innovation;Image resolution;Neural networks;Merging;Genomics;Imaging;Predictive models;Transformers;Bioinformatics;Portals;Survival Outcome Prediction;Multi-modal Fusion;Whole Slide Imaging (WSI);Genomic Data Integration;Multi-scale Attention Transformer},
  doi={10.1109/IJCNN64981.2025.11227617},
  ISSN={2161-4407},
  month={June},}@ARTICLE{9363915,
  author={Zhou, S. Kevin and Greenspan, Hayit and Davatzikos, Christos and Duncan, James S. and Van Ginneken, Bram and Madabhushi, Anant and Prince, Jerry L. and Rueckert, Daniel and Summers, Ronald M.},
  journal={Proceedings of the IEEE}, 
  title={A Review of Deep Learning in Medical Imaging: Imaging Traits, Technology Trends, Case Studies With Progress Highlights, and Future Promises}, 
  year={2021},
  volume={109},
  number={5},
  pages={820-838},
  abstract={Since its renaissance, deep learning has been widely used in various medical imaging tasks and has achieved remarkable success in many medical imaging applications, thereby propelling us into the so-called artificial intelligence (AI) era. It is known that the success of AI is mostly attributed to the availability of big data with annotations for a single task and the advances in high performance computing. However, medical imaging presents unique challenges that confront deep learning approaches. In this survey paper, we first present traits of medical imaging, highlight both clinical needs and technical challenges in medical imaging, and describe how emerging trends in deep learning are addressing these issues. We cover the topics of network architecture, sparse and noisy labels, federating learning, interpretability, uncertainty quantification, etc. Then, we present several case studies that are commonly found in clinical practice, including digital pathology and chest, brain, cardiovascular, and abdominal imaging. Rather than presenting an exhaustive literature survey, we instead describe some prominent research highlights related to these case study applications. We conclude with a discussion and presentation of promising future directions.},
  keywords={Biomedical imaging;Medical diagnostic imaging;Image segmentation;Diseases;Deep learning;Medical services;Computed tomography;Artificial intelligence;Market research;Network architecture;Clinical diagnosis;Deep learning (DL);medical imaging;survey},
  doi={10.1109/JPROC.2021.3054390},
  ISSN={1558-2256},
  month={May},}@ARTICLE{11062633,
  author={Chaddad, Ahmad and Peng, Jihao and Wu, Yihang},
  journal={IEEE Transactions on Radiation and Plasma Medical Sciences}, 
  title={Classification-Based Deep Learning Models for Lung Cancer and Disease Using Medical Images}, 
  year={2026},
  volume={10},
  number={3},
  pages={371-379},
  abstract={The use of deep learning (DL) in medical image analysis has significantly improved the ability to predict lung cancer. In this study, we introduce a novel deep convolutional neural network (CNN) model, named ResNet+, which is based on the established residual neural network (ResNet) framework. This model is specifically designed to improve the prediction of lung cancer and diseases using the images. To address the challenge of missing feature information that occurs during the downsampling process in CNNs, we integrate the ResNet-D module, a variant designed to enhance feature extraction capabilities by modifying the downsampling layers, into the traditional ResNet model. Furthermore, a convolutional attention module was incorporated into the bottleneck layers to enhance model generalization by allowing the network to focus on relevant regions of the input images. We evaluated the proposed model using five public datasets, comprising lung cancer (LC $2500~n \,\, {=} \,\, 3183$ , IQ-OTH/NCCD  $n \,\, {=} \,\, 1336$ , and lung and colon cancer  $n \,\, {=} \,\, 25000$  images) and lung disease (ChestXray  $n \,\, {=} \,\, 5856$ , and COVIDx-CT  $n \,\, {=} \,\, 425024$  images). To address class imbalance, we used data augmentation techniques to artificially increase the representation of underrepresented classes in the training dataset. The experimental results show that ResNet+ model demonstrated remarkable accuracy/F1, reaching 98.14/98.14% on the LC25000 dataset and 99.25/99.13% on the IQ-OTH/NCCD dataset. Furthermore, the ResNet+ model saved computational cost compared to the original ResNet series in predicting lung cancer images. The proposed model outperformed the baseline models on publicly available datasets, achieving better performance metrics. Our codes are publicly available at https://github.com/AIPMLab/Graduation-2024/tree/main/Peng.},
  keywords={Lung cancer;Accuracy;Training;Computed tomography;COVID-19;Lungs;Feature extraction;Cancer;Pneumonia;Predictive models;Classification;deep learning (DL);lung cancer;residual neural network (ResNet)},
  doi={10.1109/TRPMS.2025.3584031},
  ISSN={2469-7303},
  month={March},}@INPROCEEDINGS{9756124,
  author={Ahmed, Hanan and Hamad, Safwat and Shedeed, Howida A. and Saad, Ashraf},
  booktitle={2022 5th International Conference on Computing and Informatics (ICCI)}, 
  title={Review of Personalized Cancer Treatment with Machine Learning}, 
  year={2022},
  volume={},
  number={},
  pages={044-049},
  abstract={Cancer is a group of more than 100 diseases caused by abnormal cell growth that may spread to other parts of the body. Therefore, cancer treatment is considered one of the challenges in the medical field. According to the World Health Organization (WHO) “Cancer is the second leading cause of death worldwide; there were 9.6 million deaths in 2018”. As scientists have learned more about cancer, they have found that some mutations are commonly found in several types of cancer so cancer tumors can have thousands of genetic mutations. Because of this, cancers are categorized by the types of genetic alterations that are approved to be the driver, not only by where the tumor developed in the body and how the cancer cells look under the microscope. They also have found that certain treatments worked better for some patients than for others which means that, the response of patients with the same cancer type and same treatment plan is different. Now, cancer treatment tends to personalize medicine (also known as precision medicine), taking into account an individual's genetic profile and medical or disease history before treatment, dealing with each DNA sequence as a separate case, and analyzing its mutations which is a time and effort consuming task. Studying each patient DNA sequence requires a medical team with several working days to make a decision for the single patient which is too difficult to do with the high number of patients. So, recently the effort is exerted in replacing the human effort with artificial intelligence-based algorithms to study the DNA sequence, extract its mutations and study the various treatment effect on DNA. In this paper, a review is introduced for recent researches that use the machine and deep learning algorithms to personalize cancer treatments.},
  keywords={Machine learning algorithms;Precision medicine;Microscopy;Cancer treatment;Organizations;Prediction algorithms;Task analysis;Biomedical;Personalized Treatment;Drug Response Prediction;Deep Learning},
  doi={10.1109/ICCI54321.2022.9756124},
  ISSN={},
  month={March},}@INPROCEEDINGS{11569535,
  author={McMahon, Isabella and Margapuri, Venkat},
  booktitle={2026 IEEE World AI IoT Congress (AIIoT)}, 
  title={Diagnosis of Ulcerative Colitis using Supervised Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={0231-0238},
  abstract={Ulcerative colitis (UC) is a chronic inflammatory bowel disease characterized by varying levels of mucosal inflammation, typically assessed using the Mayo Endoscopic Score (MES). Accurate severity classification is critical for guiding treatment yet remains challenging due to increasing case prevalence and limited specialist availability. In this study, we develop a machine learning framework for automated UC severity classification using colonoscopy images from the LIMUC dataset (11,276 images). Deep feature embeddings are extracted using a pretrained ResNet-50 model and compressed via principal component analysis (PCA) to obtain a compact representation. Multiple supervised learning models are evaluated on these features, with ensemble methods achieving the strongest performance. Our analysis shows that discriminative information is largely preserved within a low-dimensional subspace, and that specific principal components exhibit structured trends aligned with disease severity. These findings suggest that deep feature representations encode an interpretable severity structure, supporting the use of efficient machine learning models for clinically relevant UC assessment.},
  keywords={Modeling;Machine learning;Machining;Manuals;Boosting;Diseases;Principal component analysis;Accuracy;Ulcerative colitis;Colonoscopy;Supervised Machine Learning;Mayo Endoscopic Score;LIMUC dataset;Ulcerative Colitis (UC);Predictive analytics;Principal Component Analysis;Clinical decision support;ResNet50 Feature Extraction;Permutation Importance Analysis;Cumulative Explained Variance},
  doi={10.1109/AIIoT68874.2026.11569535},
  ISSN={},
  month={May},}@ARTICLE{10942605,
  author={Amirian, Soheyla and Gao, Fengyi and Littlefield, Nickolas and Hill, Jonathan H. and Yates, Adolph J. and Plate, Johannes F. and Pantanowitz, Liron and Rashidi, Hooman H. and Tafti, Ahmad P.},
  journal={IEEE Access}, 
  title={State-of-the-Art in Responsible, Explainable, and Fair AI for Medical Image Analysis}, 
  year={2025},
  volume={13},
  number={},
  pages={58229-58263},
  abstract={Integrating responsible, explainable, and fair artificial intelligence (REF-AI) into medical image analysis has gained significant attention in recent years. This has been driven by the pressing need for ethical, trustworthy, and transparent implementation of AI systems in healthcare. The following review provides a concise overview of REF-AI in the context of medical image analysis. It begins with the fundamental concepts of AI responsibility, explainability, and fairness, followed by a comprehensive taxonomy of over 35 key algorithms and strategies. In addition, it compares methodologies, strengths, and limitations, such as the alignment of AI models with medical standards and the development of interpretable and actionable results for clinicians. Finally, it highlights current trends and proposes directions for future research to further advance the responsible, explainable, and fair application of AI in medical imaging.},
  keywords={Artificial intelligence;Medical diagnostic imaging;Medical services;Image analysis;Accuracy;Reliability;Ethics;Measurement;Biological system modeling;Image segmentation;Artificial intelligence (AI);responsible AI;explainable AI;fair AI;AI evaluation metrics;medical imaging},
  doi={10.1109/ACCESS.2025.3555543},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11570550,
  author={A, Kavitha and P, Jeya Sherlyne and A, Joevita Rex},
  booktitle={2026 7th International Conference on Inventive Research in Computing Applications (ICIRCA)}, 
  title={Cross-Domain Transfer Learning and Self-Supervised Representation Learning for Automated Histopathological Image Classification in Colorectal Cancer Grading System}, 
  year={2026},
  volume={},
  number={},
  pages={2044-2050},
  abstract={Colorectal cancer (CRC) is an important cause of cancer-related mortality and an effective diagnosis and treatment planning require the accurate histopathological grading. However, pathologist assessment is time consuming, subjective and can be inter-observer variability. Despite the potential of deep learning techniques, it is hindered by issues such as limited availability of labeled data, domain shift, and variability in staining, all of which limit their clinical applicability. This paper gives a cohesive architecture that incorporates cross-domain transfer learning and self-supervised representation learning to automatically grade CRC. It trains powerful feature representations on a self-supervised method based on DINO, and patch-level analysis to give global and cellular features. To cope with domain variability, the DomainAdversarial Neural Networks (DANN) and Maximum Mean Discrepancy (MMD) are used to effectively adapt a domain. Moreover, CycleGAN and Attention-GAN are also used in the generation of synthetic data and in the normalization of stains. A Swin Transformer is employed to add hierarchical features, and cross-attention multimodal transformer is used to add clinical metadata to enhance diagnostic performances. This framework includes an attention-based classifier, explainability such as GradCAM to interpretability. Elastic Weight Consolidation (EWC) will enable learning at any time. Experimental outcomes are enhanced accuracy, generalization and reliability which reveal its potentiality of being utilized clinically.},
  keywords={Modeling;Self-supervised learning;Learning (artificial intelligence);Transformers;Printing;Tumors;Equations;Tagging;Labeling;Biological tissues;Cross-Domain Transfer Learning;SelfSupervised Learning;DINO;Domain-Adversarial Neural Network (DANN);Maximum Mean Discrepancy (MMD);CycleGAN;Attention GAN;Grad-CAM;Continual Learning;Elastic Weight Consolidation (EWC)},
  doi={10.1109/ICIRCA69024.2026.11570550},
  ISSN={},
  month={June},}@ARTICLE{11050386,
  author={Kulsoom, Umay and Glavin, Frank G. and Bendechache, Malika},
  journal={IEEE Access}, 
  title={Natural Language Processing and Machine Learning for Analysis of Radiology Reports: A Systematic Review}, 
  year={2025},
  volume={13},
  number={},
  pages={112215-112254},
  abstract={Radiology reports, as a means of inter-physician and physician-to-patient communication, contain key findings and interpretations from imaging studies that guide diagnosis and treatment. Recent advancements in Artificial Intelligence (AI) technologies and the growing volume of clinical data necessitate efficient approaches for effective data utilisation. Integrating AI technologies can improve data analysis, enhance diagnostic accuracy, and streamline clinical workflows, reducing the burden on physicians. This Systematic Literature Review (SLR) examines the state-of-the-art of Natural Language Processing (NLP) and Machine Learning (ML) techniques, reviewing their diverse applications in radiology report processing, with a focus on automated disease diagnosis. We explored the commonly used approaches and their impact on diagnostic accuracy. We also looked into the availability of publicly accessible datasets that can be used for ML research within the radiology domain. Despite the promising advancements, challenges remain, such as data quality issues, interpretability of models and integrations of these technologies into clinical workflows. This review provides a thorough overview of the current research in this field by analysing existing findings and highlighting areas of improvement. The goal is to provide insights that can inform future studies in report analysis and improve the use of AI techniques in radiology.},
  keywords={Radiology;Natural language processing;Systematic literature review;Imaging;Medical services;Databases;Libraries;Accuracy;Diagnostic radiography;Data models;Artificial intelligence;deep learning;machine learning;multimodal;natural language processing;radiology reports;systematic review},
  doi={10.1109/ACCESS.2025.3582728},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10777243,
  author={Gebre, Hambisa Mitiku and Wegari, Getachew Mamo},
  booktitle={2024 International Conference on Information and Communication Technology for Development for Africa (ICT4DA)}, 
  title={The Integration of Deep Learning Techniques and Big Data Analytics for Improved Breast Cancer Diagnosis and Treatment: A Systematic Review}, 
  year={2024},
  volume={},
  number={},
  pages={13-18},
  abstract={Background:- Breast cancer is one of the most common and lethal diseases in the world. Traditional breast cancer diagnostic and prognosis procedures usually involve significant human talent and can be time-consuming and subjective, leading to potential errors and treatment delays. Two recent technical advancements, deep learning, and big data analytics are promising to improve breast cancer diagnosis and therapy. As a result, this systematic review aims to examine specific papers that describe deep learning techniques and big data analytics in the context of breast cancer diagnosis and prediction.Methods: Using Preferred Reporting Items for Systematic Reviews and Meta-Analysis (PRISMA), peer-reviewed articles published in the English language from January 2020 to August 2023 were selected from electronic databases such as PubMed, ACM, Digital Library, and Science Direct, as well as citations and manual searches. This review paper takes into account papers about deep learning algorithms, big data analytics, the efficacy of deep learning and big data analytics, as well as the problems and limitations of merging deep learning methods with big data analytics. Articles that were not original or in English were not included.Result: - Ten articles were identified for this review. The finding showed that deep-learning techniques play a great role in analyzing vast datasets to identify malignant cells or tumors, aiding radiologists in accurate diagnoses and improving patient outcomes. Big data analytics in breast cancer diagnosis and treatment can improve accuracy, efficiency, and patient-centered care. Deep learning techniques are utilized with big data, enhancing screening test accuracy and guiding diagnostic procedures, especially for image-based scanning that leads to early breast cancer identification, improving patient outcomes, and potentially enhancing diagnostics. Obtaining huge volumes of high-quality data for training deep learning models is a challenge and limitation of integrating deep learning algorithms with big data analytics; due to data privacy, data fragmentation across multiple healthcare systems, and restricted access to annotated datasets.Conclusion: Deep learning techniques combined with big data analytics have a significant potential for improving breast cancer detection and therapy.},
  keywords={Deep learning;Training;Accuracy;Merging;Medical treatment;Manuals;Big Data;Breast cancer;Prognostics and health management;Tumors;Deep learning algorithms;big data analytics;breast cancer diagnosis and treatment},
  doi={10.1109/ICT4DA62874.2024.10777243},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10601714,
  author={Breitkopf, Andreas Josef and Arun, R and Jeya, R.},
  booktitle={2024 International Conference on Advances in Computing, Communication and Applied Informatics (ACCAI)}, 
  title={Exploring Emerging Technologies for Gastrointestinal Cancer Diagnosis}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Gastrointestinal cancer is a prevalent and potentially life-threatening condition that affects the digestive system. Early diagnosis is essential for successful treatment and better prognoses in gastrointestinal cancers. Fortunately, recent breakthroughs in medical technology and research have provided us with more effective methods for detecting these cancers. This abstract aims to provide an overview of these detection techniques.One promising approach is the use of biomarkers, which are measurable substances in the body that indicate the presence of cancer cells. Researchers have identified carcinoembryonic antigen (CEA) and carbohydrate antigen (CA) which are cancer specific biomarkers and can be detected through blood tests. Additionally, genetic markers, including mutations in specific genes, have shown potential in diagnosing certain types of gastrointestinal cancer.Endoscopy, a commonly used diagnostic procedure, allows physicians to visualise the gastrointestinal tract and take tissue samples for analysis. Advanced endoscopic techniques, such as chromoendoscopy and confocal laser endomicroscopy, have significantly improved the detection of precancerous and early-stage lesions. Imaging techniques like CT scans and MRIs generate highly detailed crosssectional views of the digestive system. This allows physicians to visualize tumors and evaluate their properties.Artificial Intelligence and Machine Learning Algorithms are seeing a lot of use in cancer detection in recent times. These hold promise for improving diagnostic accuracy and efficiency. AI algorithms can analyze medical imaging data, like CT or MRI scans, with the ability to detect subtle patterns and abnormalities suggestive of gastrointestinal cancers.In conclusion, the continuous development of detection techniques, including the use of biomarkers, advanced endoscopy, medical imaging, and AI, holds great promise for early and accurate diagnosis of gastrointestinal cancer. These advancements will contribute to better disease management and improved rates of survival for individuals afflicted with this deadly condition.},
  keywords={Machine learning algorithms;Accuracy;Magnetic resonance imaging;Medical services;Biomarkers;Cancer detection;Gastrointestinal tract;gastrointestinal cancer;biomarkers;genetic markers;endoscopy;chromoendoscopy;confocal laser endomicroscopy;computed tomography;magnetic resonance imaging;artificial intelligence;machine learning},
  doi={10.1109/ACCAI61061.2024.10601714},
