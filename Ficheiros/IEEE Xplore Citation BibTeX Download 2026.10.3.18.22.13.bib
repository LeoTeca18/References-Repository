  author={Selvi, C. and Malini, Dommeti Hema and Almoussawi, Zainab Abed and Yamsani, Nagendar and Adnan, Myasar Mundher},
  booktitle={2023 International Conference on Ambient Intelligence, Knowledge Informatics and Industrial Electronics (AIKIIE)}, 
  title={Classification of Lung Cancer Using Hybrid Convolutional Neural Network Based Bidirectional Long Short-Term Memory}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Cancer is a deadly disease caused by a grouping of genetic diseases and several varieties of biochemical abnormalities. Colon and lung cancer appeared as two of the leading causes of death and human disability. The histological diagnosis of such tumors is typically the most critical factor in selecting the optimal course of therapy. The primary aim of this study is to identify malignant lung nodules in a given lung image and to categorize lung cancer and its seriousness. To identify lung nodules, Deep Learning (DL) models are used to categorize the lung cancer stages. A lung nodule is detected using the Convolutional Neural Network (CNN), which identifies a nodule that is precisely segmented and categorized. The proposed approach is divided into two sections: the first is used to categorize normal and aberrant behavior, and the second is used to categorize the various lung cancer stages. In the classification stage, characteristics based on texture and intensity are extracted. The right edge image and morphological thinning operation are applied to improve segmentation performance. The hybrid CNN based Bidirectional Long Short-Term Memory (CNN-Bi-LSTM) model achieves better classification results using performance metrics like accuracy, specificity, sensitivity, and f1-score values of about 99.41%, 99.39%, 99.43% and 99.18% respectively comparing with existing methods.},
  keywords={Image segmentation;Sensitivity;Lung cancer;Lung;Feature extraction;Colon;Classification algorithms;Bidirectional Long Short-Term Memory;Convolutional Neural Network;Deep Learning;Lung Cancer;Nodules},
  doi={10.1109/AIKIIE60097.2023.10390122},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11706252,
  author={Paranjothi, Geetha and A.S, Arunachalam},
  booktitle={2026 International Conference on Secure Information Systems and Technologies (ICSIST)}, 
  title={EQAM-LCDF: A Quantum Entanglement-Driven Multi-Modal Deep Learning Framework with Swarm Intelligence Optimization for Histopathological Lung Cancer Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1073-1080},
  abstract={Lung cancer is one of the most common and deadly of cancers worldwide. Due to late presentation and the lack of specific early symptoms, early and accurate diagnosis is crucial to improve patient survival. Histopathological image analysis using deep learning has been gaining a lot of attention and showing a lot of promise. Most of the current methods, however, suffer from a lack of image enhancement, inadequate integration of global and local information from the images, redundant feature extraction, and low classification accuracy. To address these issues, the propose an Enhanced Quantum-Assisted Multi-Modal Lung Cancer Detection Framework for histopathological images, named EQAM-LCDF. The framework starts with histopathological image preprocessing to enhance the image quality using stain, contrast, and spatial information. A hybrid Quantum-Inspired Vision Transformer (QIViT)–Multi-Scale Dense YOLOv10 CNN (QViT–MSDY-CNN), is then employed to learn feature representations from images of different modalities. The hybrid architecture consists of Quantum-Inspired Vision Transformer (QIViT) to learn the global contextual information of the whole tissue and Multi-Scale Dense YOLOv10 CNN to extract fine-grained local information of cells and morphologies. The features are then fused using a Quantum-Inspired Correlation-Based Feature Fusion (QICFF) to obtain a high-dimensional, comprehensive, and discriminative feature space. An Improved Quantum Particle Swarm Optimization (IQPSO) algorithm is then employed for optimal feature selection and adaptive hyperparameter optimization to eliminate redundant information and to improve the feature discriminability. The final optimized feature space is then fed into a hybrid Quantum-Inspired CNN (QICNN)–Light GBM (QCNN-LGBM) for classification. Experiments are conducted using several benchmark datasets and evaluated using accuracy, precision, recall, F1-score, specificity, and Area Under the Receiver Operating Characteristic Curve (AUC). The proposed framework is expected to provide robust feature learning, high classification accuracy, and effective cancer detection for early clinical decision-making and precision oncology.},
  keywords={Lungs;Modeling;Biological tissues;Lung cancer;Equations;Convolutional neural networks;Optimization;Accuracy;Medical diagnosis;Feature extraction;Lung cancer detection;Histopathological images;medical image analysis;Computer-aided diagnosis;Artificial intelligence;Deep learning;Image classification;Clinical decision support;Precision oncology;Biomedical imaging},
  doi={10.1109/ICSIST70215.2026.11706252},
