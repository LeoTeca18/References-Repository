@inproceedings{10.1145/3698587.3701368,
author = {Wang, Ruohan and Wang, Zilong and Song, Ziyang and Buckeridge, David and Li, Yue},
title = {MixEHR-Nest: Identifying Subphenotypes within Electronic Health Records through Hierarchical Guided-Topic Modeling},
year = {2024},
isbn = {9798400713026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3698587.3701368},
doi = {10.1145/3698587.3701368},
abstract = {Automatic subphenotyping from electronic health records (EHRs) provides numerous opportunities to understand diseases with unique subgroups and enhance personalized medicine for patients. However, existing machine learning algorithms either focus on specific diseases for better interpretability or produce coarse-grained phenotype topics without considering nuanced disease patterns. In this study, we propose a guided topic model, MixEHR-Nest, to infer subphenotype topics from thousands of disease using multi-modal EHR data. Specifically, MixEHR-Nest detects multiple subtopics from each phenotype topic, whose prior is guided by the expert-curated phenotype concepts such as Phenotype Codes (PheCodes) or Clinical Classification Software (CCS) codes. We evaluated MixEHR-Nest on two EHR datasets: (1) the MIMIC-III dataset; (2) the healthcare administrative database PopHR. Experimental results demonstrate that MixEHR-Nest can identify subphenotypes with distinct patterns within each phenotype, which are predictive for disease progression and severity. The MixEHR-Nest software is available at GitHub: https://github.com/li-lab-mcgill/MixEHR-Nest.},
booktitle = {Proceedings of the 15th ACM International Conference on Bioinformatics, Computational Biology and Health Informatics},
articleno = {53},
numpages = {8},
keywords = {Electronic health records, Expert-guidance, Gibbs sampling, Multi-modality, Subphenotyping, Topic modeling},
location = {Shenzhen, China},
series = {BCB '24}
}

@inproceedings{10.1145/3502871.3502888,
author = {(Charles) Zheng, Bowen},
title = {Comprehensive Identification of Potential Lung Cancer Biomarkers That are Applicable in Both Diagnosis and Prognosis},
year = {2022},
isbn = {9781450385077},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3502871.3502888},
doi = {10.1145/3502871.3502888},
abstract = {Lung cancer continually led all cancers in patient deaths, and lung adenocarcinoma and lung squamous cell carcinoma are two of the most common lung cancer subtypes. Given the steep increase in patient survival rate as lung cancer tumor progresses from the early to later stages, it is pivotal to develop diagnostic and prognostic strategies using biomarkers to ensure a better chance of survival for the patients. In this study, we performed a comprehensive analysis on the poly-A tail selected RNA-sequencing datasets in lung cancer. We firstly performed differential expression analysis to identify genes having different expression profiles between tumor and healthy patients. We then confirmed the biological impacts for these differential genes by observing their co-expression patterns and connectivity within the co-activation modules in tumor patients. Certain limitations exist with using RNA biomarkers in a clinical setting, due to RNA being a single-stranded structure that is likely to break down in an extract patient fluid sample and has inadequately abundant expression signal. Thus, we further applied epigenetic annotation data to associate our RNA gene list with methylation level and transcription factor binding signal. At last, with the annotated featured gene list serving as the basis, we developed a predictive model using Support Vector Machine (SVM) and showed that the selected featured genes not only possess biological significance but also a decent prognostic predictive power in distinguish early stage tumors. We further showed that they can be applicable to other endodermal cancers.},
booktitle = {Proceedings of the 2021 8th International Conference on Biomedical and Bioinformatics Engineering},
pages = {102–112},
numpages = {11},
keywords = {Lung cancer, biomarker, co-expression analysis, diagnosis, machine learning model, methylation, prognosis, transcriptomics},
location = {Kyoto, Japan},
series = {ICBBE '21}
}

