@article{OSUALA2023102704,
title = {Data synthesis and adversarial networks: A review and meta-analysis in cancer imaging},
journal = {Medical Image Analysis},
volume = {84},
pages = {102704},
year = {2023},
issn = {1361-8415},
doi = {https://doi.org/10.1016/j.media.2022.102704},
url = {https://www.sciencedirect.com/science/article/pii/S1361841522003322},
author = {Richard Osuala and Kaisar Kushibar and Lidia Garrucho and Akis Linardos and Zuzanna Szafranowska and Stefan Klein and Ben Glocker and Oliver Diaz and Karim Lekadir},
keywords = {Generative Adversarial Network, Adversarial training, Synthetic data, Trustworthiness},
abstract = {Despite technological and medical advances, the detection, interpretation, and treatment of cancer based on imaging data continue to pose significant challenges. These include inter-observer variability, class imbalance, dataset shifts, inter- and intra-tumour heterogeneity, malignancy determination, and treatment effect uncertainty. Given the recent advancements in image synthesis, Generative Adversarial Networks (GANs), and adversarial training, we assess the potential of these technologies to address a number of key challenges of cancer imaging. We categorise these challenges into (a) data scarcity and imbalance, (b) data access and privacy, (c) data annotation and segmentation, (d) cancer detection and diagnosis, and (e) tumour profiling, treatment planning and monitoring. Based on our analysis of 164 publications that apply adversarial training techniques in the context of cancer imaging, we highlight multiple underexplored solutions with research potential. We further contribute the Synthesis Study Trustworthiness Test (SynTRUST), a meta-analysis framework for assessing the validation rigour of medical image synthesis studies. SynTRUST is based on 26 concrete measures of thoroughness, reproducibility, usefulness, scalability, and tenability. Based on SynTRUST, we analyse 16 of the most promising cancer imaging challenge solutions and observe a high validation rigour in general, but also several desirable improvements. With this work, we strive to bridge the gap between the needs of the clinical cancer imaging community and the current and prospective research on data synthesis and adversarial networks in the artificial intelligence community.}
}
@article{CHEN2025218076,
title = {Tumor microenvironment and macroenvironment: A new perspective on holistic oncology},
journal = {Cancer Letters},
volume = {634},
pages = {218076},
year = {2025},
issn = {0304-3835},
doi = {https://doi.org/10.1016/j.canlet.2025.218076},
url = {https://www.sciencedirect.com/science/article/pii/S0304383525006482},
author = {Qun Chen and Kuirong Jiang and Michael S. Bronze and Min Li and Courtney W. Houchen and Yuqing Zhang},
keywords = {Tumor microenvironment, Tumor macroenvironment, Local-systemic crosstalk, Immunity, Precise treatment},
abstract = {The tumor microenvironment (TME) and tumor macroenvironment (TMaE) jointly shape cancer biology by linking local cellular niches with systemic host physiology. The TME provides the immediate soil for tumor initiation, progression, and therapy resistance, whereas the TMaE integrates metabolic, immune, neuroendocrine, microbial, and inflammatory signals that remodel local ecosystems. Recent advances highlight how systemic factors, including aging, energy imbalance, chronic inflammation, cachexia, and psychosocial stress, interact with extracellular matrix remodeling, vascular dynamics, and immune surveillance to influence tumor dormancy, metastatic reactivation, and therapeutic outcomes. However, the conceptual boundaries between TME and TMaE remain unclear, mechanistic insights are limited, and current models insufficiently capture local-systemic crosstalk. Future strategies integrating multi-omics, advanced imaging, and humanized models are essential to map this multidimensional interplay. A deeper understanding of TME-TMaE will be critical to refine precision oncology, advance preventive strategies, and design combinatorial therapies targeting both local and systemic cancer ecosystems. This review highlights the roles of the TME and TMaE in tumor initiation, progression, and heterogeneity, their interactions, and the clinical implications for classification, therapy, and prognosis.}
}
@article{PUIGCASTELLVI2023117248,
title = {Advances in the integration of metabolomics and metagenomics for human gut microbiome and their clinical applications},
journal = {TrAC Trends in Analytical Chemistry},
volume = {167},
pages = {117248},
year = {2023},
issn = {0165-9936},
doi = {https://doi.org/10.1016/j.trac.2023.117248},
url = {https://www.sciencedirect.com/science/article/pii/S0165993623003357},
author = {Francesc Puig-Castellví and Romina Pacheco-Tapia and Maxime Deslande and Manyi Jia and Petros Andrikopoulos and Kanta Chechi and Amélie Bonnefond and Philippe Froguel and Marc-Emmanuel Dumas},
keywords = {Gut microbiome, Clinical metabolomics, metagenomics, Data fusion, Knowledge integration, Biosynthetic gene clusters, Multi-omic analyses},
abstract = {The human microbiome and its metabolic output play an important role in shaping human health and disease. The host-microbe crosstalk is often characterised using metabolomics and metagenomics, yet a large proportion of microbial metabolites and the molecular functions of gut microbes remain unknown. This review summarises the strategies for annotation and discovery of the novel metabolites from the human gut microbiome, either using metabolomics alone or in combination with metagenomics, and presents data analysis methods for combining these two types of data to obtain biological insights. Applications of the gut microbiome research in biomarker screening, precision medicine, microbiome medicine, and drug discovery are also discussed, along with the perspectives, challenges and limitations of this research field.}
}
@article{MOTSINGERREIF2024100591,
title = {Gene-environment interactions within a precision environmental health framework},
journal = {Cell Genomics},
volume = {4},
number = {7},
pages = {100591},
year = {2024},
issn = {2666-979X},
doi = {https://doi.org/10.1016/j.xgen.2024.100591},
url = {https://www.sciencedirect.com/science/article/pii/S2666979X24001757},
author = {Alison A. Motsinger-Reif and David M. Reif and Farida S. Akhtari and John S. House and C. Ryan Campbell and Kyle P. Messier and David C. Fargo and Tiffany A. Bowen and Srikanth S. Nadadur and Charles P. Schmitt and Kristianna G. Pettibone and David M. Balshaw and Cindy P. Lawler and Shelia A. Newton and Gwen W. Collman and Aubrey K. Miller and B. Alex Merrick and Yuxia Cui and Benedict Anchang and Quaker E. Harmon and Kimberly A. McAllister and Rick Woychik},
keywords = {gene-environment interactions, precision environmental health, epidemiology, genetics, environmental exposures, epigenetics, environmental justice},
abstract = {Summary
Understanding the complex interplay of genetic and environmental factors in disease etiology and the role of gene-environment interactions (GEIs) across human development stages is important. We review the state of GEI research, including challenges in measuring environmental factors and advantages of GEI analysis in understanding disease mechanisms. We discuss the evolution of GEI studies from candidate gene-environment studies to genome-wide interaction studies (GWISs) and the role of multi-omics in mediating GEI effects. We review advancements in GEI analysis methods and the importance of large-scale datasets. We also address the translation of GEI findings into precision environmental health (PEH), showcasing real-world applications in healthcare and disease prevention. Additionally, we highlight societal considerations in GEI research, including environmental justice, the return of results to participants, and data privacy. Overall, we underscore the significance of GEI for disease prediction and prevention and advocate for integrating the exposome into PEH omics studies.}
}
@article{HAERIFAR2026156486,
title = {Opioids and cancer biology: Exploring the dark side of pain relief},
journal = {Pathology - Research and Practice},
volume = {283},
pages = {156486},
year = {2026},
issn = {0344-0338},
doi = {https://doi.org/10.1016/j.prp.2026.156486},
url = {https://www.sciencedirect.com/science/article/pii/S0344033826001391},
author = {Freshteh Haerifar and Hossein Kalarestaghi and Hamed Mirzaei and Mohammadmahdi Bahramloo and Sina Alinejad-Shahabi and Arian Samimifar and Seyyede Sepide {Ashraf Moosavi} and Khadijeh {Dizaji Asl} and Zeinab Mazloumi and Ali Rafat},
keywords = {Cancer pain management, Opioids, Tumor biology, Immunosuppression, Angiogenesis},
abstract = {Opioids have traditionally been a fundamental component of cancer pain management; however, emerging evidence raises concerns regarding their potential influence on cancer progression. Although they are effective in alleviating the severe pain associated with malignancies, recent studies suggest that opioids may exert complex and not yet fully understood effects on tumor biology. Some research indicates that opioids could facilitate tumor growth by modulating immune suppression, promoting angiogenesis, and enhancing metastatic potential. Conversely, other investigations propose that opioids may possess anti-neoplastic properties, such as inducing apoptosis in cancer cells and enhancing immune system activity. This review aims to elucidate the multifaceted relationship between opioids and cancer, examining their dual role in symptom palliation and possible tumor progression. Additionally, it discusses the effects of opioids across different cancer types and explores alternative pain management strategies that may offer safer long-term outcomes. With ongoing advances in understanding opioids’ biological impacts, it is evident that rigorously designed clinical trials are essential to clarify their role in cancer therapy and optimize their clinical application.}
}
@article{MAZZOLENI2026169384,
title = {DNA Topoisomerase II Mutations in Cancer: Structural Impact and Drug Response in High-grade Serous Ovarian Carcinoma},
journal = {Journal of Molecular Biology},
volume = {438},
number = {5},
pages = {169384},
year = {2026},
issn = {0022-2836},
doi = {https://doi.org/10.1016/j.jmb.2025.169384},
url = {https://www.sciencedirect.com/science/article/pii/S0022283625004504},
author = {Viola Mazzoleni and Amélie Boichard and Valérie Lamour},
keywords = {topoisomerase II, cancer genomics, drug resistance, high-grade serous ovarian carcinoma, structure–function analysis},
abstract = {Topoisomerases are essential enzymes that resolve DNA topological stress during replication and transcription. In mammalian cells, the two isoforms, TOP2A and TOP2B, differ in expression profiles and functions. TOP2A is a key regulator of cell division, mainly expressed in rapidly dividing cells, such as cancer cells, and is therefore the primary target of several chemotherapeutic molecules. In contrast, TOP2B is ubiquitously expressed in both dividing and non-dividing cells and is not directly implicated in tumorigenesis. Despite their functional differences, the high homology of the two isoforms contributes to unwanted off-target effects of TOP2-directed therapies, sometimes leading to secondary cancer. Both isoforms can harbor naturally occurring or cancer-associated point mutations, which could confer altered sensitivity or resistance to chemotherapy agents. Using data from cancer genomic databases, we analyzed hotspot mutations of both isoforms found in human tumors and conducted a molecular analysis based on structural and functional data. We identified TOP2 variants in high-grade serous ovarian carcinoma, a malignancy frequently treated with TOP2-targeting agents, such as doxorubicin or etoposide. Our analysis emphasizes the importance of modeling somatic mutations to assess enzyme conformation and therapeutic response. Additionally, this review provides insights that underline the potential value of including TOP2A and TOP2B in companion diagnostic gene panels used in personalized oncology, notably in cancers where TOP2-directed agents are part of the standard therapy.}
}
@article{ADEN2025155864,
title = {Exploring immune checkpoint inhibitors: Focus on PD-1/PD-L1 axis and beyond},
journal = {Pathology - Research and Practice},
volume = {269},
pages = {155864},
year = {2025},
issn = {0344-0338},
doi = {https://doi.org/10.1016/j.prp.2025.155864},
url = {https://www.sciencedirect.com/science/article/pii/S0344033825000561},
author = {Durre Aden and Samreen Zaheer and Niti Sureka and Monal Trisal and Jai Kumar Chaurasia and Sufian Zaheer},
keywords = {PD-1, PD-L1, Immune check point inhibitor, Immunotherapy},
abstract = {Immunotherapy emerges as a promising approach, marked by recent substantial progress in elucidating how the host immune response impacts tumor development and its sensitivity to various treatments. Immune checkpoint inhibitors have revolutionized cancer therapy by unleashing the power of the immune system to recognize and eradicate tumor cells. Among these, inhibitors targeting the programmed cell death protein 1 (PD-1) and its ligand (PD-L1) have garnered significant attention due to their remarkable clinical efficacy across various malignancies. This review delves into the mechanisms of action, clinical applications, and emerging therapeutic strategies surrounding PD-1/PD-L1 blockade. We explore the intricate interactions between PD-1/PD-L1 and other immune checkpoints, shedding light on combinatorial approaches to enhance treatment outcomes and overcome resistance mechanisms. Furthermore, we discuss the expanding landscape of immune checkpoint inhibitors beyond PD-1/PD-L1, including novel targets such as CTLA-4, LAG-3, TIM-3, and TIGIT. Through a comprehensive analysis of preclinical and clinical studies, we highlight the promise and challenges of immune checkpoint blockade in cancer immunotherapy, paving the way for future advancements in the field.}
}
@article{WU2025147996,
title = {The emerging role of ferredoxin 1 in cancer: Insights into cuproptosis and therapeutic innovation},
journal = {International Journal of Biological Macromolecules},
volume = {330},
pages = {147996},
year = {2025},
issn = {0141-8130},
doi = {https://doi.org/10.1016/j.ijbiomac.2025.147996},
url = {https://www.sciencedirect.com/science/article/pii/S0141813025085538},
author = {Annan Wu and Kai Tu and Guangfeng Xia},
keywords = {Cuproptosis, Ferredoxin 1, Therapeutic target, Biomarker, Cancer},
abstract = {Ferredoxin 1 (FDX1), a key component of the mitochondrial electron transport chain, is crucial in the copper-mediated cell death pathway known as cuproptosis. Located at the q22.3 locus on chromosome 11, FDX1 acts as a reductase and is integral to cellular redox reactions and energy metabolism. It also plays a significant role in the protein lipoylation pathway. Recent studies indicate that FDX1 expression levels correlate with the initiation and progression of various cancers, making it a potential prognostic biomarker. Furthermore, targeting FDX1 for inducing cuproptosis in cancer cells, along with its interaction with the tumor immune microenvironment, has emerged as a major research focus, driving drug development in this area. This review provides a systematic overview of FDX1's biological functions, explores the mechanisms underlying its role in cuproptosis, and summarizes its expression patterns, functions, and clinical significance across different cancers. Additionally, the review highlights ongoing drug research targeting FDX1, clarifying its potential as a therapeutic target and biomarker in oncology. It also addresses the challenges and future directions for FDX1 research, paving the way for further exploration in the context of cancer therapies.}
}
@article{ZHONG2026153259,
title = {Unveiling the landscape of m5C RNA methylation in lung cancer: From molecular mechanisms to therapeutic opportunities},
journal = {Biochemical and Biophysical Research Communications},
volume = {799},
pages = {153259},
year = {2026},
issn = {0006-291X},
doi = {https://doi.org/10.1016/j.bbrc.2026.153259},
url = {https://www.sciencedirect.com/science/article/pii/S0006291X26000227},
author = {Xiaoyou Zhong and Wenjing Wang and Jiajia Lv and Weifei Fan and Lin Wang},
keywords = {mC methylation, RNA modification, Lung cancer, NSUN family, YBX1, ALYREF, TET enzymes, Drug resistance, Immune evasion, Biomarkers},
abstract = {RNA methylation has emerged as a critical frontier in epitranscriptomics, with 5-methylcytosine (m5C) drawing particular attention for its multilayered roles in post-transcriptional gene regulation. Recent studies demonstrate that m5C modulates diverse biological processes by stabilizing RNA transcripts, promoting nuclear export, shaping translational efficiency, and orchestrating noncoding RNA function. Analogous to DNA methylation, m5C is dynamically reversible and governed by a finely tuned regulatory system composed of “writers” (such as the NSUN family and DNMT2/TRDMT1), “readers” (including YBX1 and ALYREF), and “erasers” (TET enzymes and ALKBH1), which collectively dictate its spatial and temporal distribution. In lung cancer, disruption of this regulatory axis is increasingly recognized as a driver of tumor phenotypic remodeling, metabolic adaptation, and immune evasion. Notably, writer enzymes such as NSUN2, NSUN4, and NSUN6 promote malignant progression by stabilizing oncogenic transcripts, enhancing translation, and rewiring metabolic networks. Meanwhile, reader proteins YBX1 and ALYREF maintain the stability of m5C-modified RNAs and activate proliferative and pro-invasive signaling pathways, including PI3K/AKT, mTOR, and Hippo/Wnt. In addition, m5C plays a pivotal role in shaping the tumor immune microenvironment and modulating immune checkpoint activity, thereby influencing the responsiveness and resistance of lung cancer to radiotherapy, chemotherapy, targeted therapy, and immunotherapy.}
}
@article{LI2025101067,
title = {Exosomal circRNAs: Deciphering the novel drug resistance roles in cancer therapy},
journal = {Journal of Pharmaceutical Analysis},
volume = {15},
number = {2},
pages = {101067},
year = {2025},
issn = {2095-1779},
doi = {https://doi.org/10.1016/j.jpha.2024.101067},
url = {https://www.sciencedirect.com/science/article/pii/S2095177924001643},
author = {Xi Li and Hanzhe Liu and Peiyu Xing and Tian Li and Yi Fang and Shuang Chen and Siyuan Dong},
keywords = {Exosomal circRNAs, Tumor microenvironment, Cancer biomarkers},
abstract = {Exosomal circular RNA (circRNAs) are pivotal in cancer biology, and tumor pathophysiology. These stable, non-coding RNAs encapsulated in exosomes participated in cancer progression, tumor growth, metastasis, drug sensitivity and the tumor microenvironment (TME). Their presence in bodily fluids positions them as potential non-invasive biomarkers, revealing the molecular dynamics of cancers. Research in exosomal circRNAs is reshaping our understanding of neoplastic intercellular communication. Exploiting the natural properties of exosomes for targeted drug delivery and disrupting circRNA-mediated pro-tumorigenic signaling can develop new treatment modalities. Therefore, ongoing exploration of exosomal circRNAs in cancer research is poised to revolutionize clinical management of cancer. This emerging field offers hope for significant breakthroughs in cancer care. This review underscores the critical role of exosomal circRNAs in cancer biology and drug resistance, highlighting their potential as non-invasive biomarkers and therapeutic targets that could transform the clinical management of cancer.}
}
@article{FAN2025104826,
title = {Super enhancers as drivers of hallmarks of cancer: From oncogene activation to metastatic progression},
journal = {Critical Reviews in Oncology/Hematology},
volume = {214},
pages = {104826},
year = {2025},
issn = {1040-8428},
doi = {https://doi.org/10.1016/j.critrevonc.2025.104826},
url = {https://www.sciencedirect.com/science/article/pii/S1040842825002148},
author = {Shuang Fan and Yihang Gao and Xinyu Dai and Hui Ma and Zecheng Yang},
keywords = {SEs, Hallmarks of Cancer, Metastasis, Therapy residences, Super-enhancer inhibitors, Immune scape, Cancer stem cells},
abstract = {Super enhancers (SEs) are a special type of enhancer with a unique shape and mechanism that allows them to regulate cellular processes by exhibiting a more significant gene transcription regulatory role than conventional enhancers. Tumorigenesis and metastasis may result from cancer cells exploiting SEs and developing a transcriptional addiction to them. Furthermore, tumor development may result from the translocation, creation, deletion, or duplication of SEs. According to reports, SEs closely control several carcinogenic chemicals and pathways. SE-targeting inhibitors can inhibit oncogene transcription and work in concert with chemotherapeutic drugs to overcome treatment resistance. In this work, we reviewed that SEs are essential players in the development of tumors, including the activation of oncogenes, the induction of tumor angiogenesis, the activation of invasion and metastasis, the control of immune checkpoint genes, cancer immune escape, cancer stem cells, and resistance to treatment. Additionally, we examined the therapeutic strategy and significant SE inhibitors that are helpful in cancer therapy in this research. The limits of SEs in malignancies, both present and prospective, have been covered last.}
}
@article{LIM2024189159,
title = {Molecular and immune pathobiology of human angiosarcoma},
journal = {Biochimica et Biophysica Acta (BBA) - Reviews on Cancer},
volume = {1879},
number = {5},
pages = {189159},
year = {2024},
issn = {0304-419X},
doi = {https://doi.org/10.1016/j.bbcan.2024.189159},
url = {https://www.sciencedirect.com/science/article/pii/S0304419X24000908},
author = {Ryan Mao Heng Lim and Jing Yi Lee and Bavani Kannan and Tun Kiat Ko and Jason Yongsheng Chan},
keywords = {Rare cancers, Single cell sequencing, Spatial transcriptomics, Proteomics, Next generation sequencing},
abstract = {Angiosarcoma is a rare endothelial-derived malignancy that is extremely diverse in anatomy, aetiology, molecular and immune characteristics. While novel therapeutic approaches incorporating targeted agents and immunotherapy have yielded significant improvements in patient outcomes across several cancers, their impact on angiosarcoma remains modest. Contributed by its heterogeneous nature, there is currently a lack of novel drug targets in this disease entity and no reliable biomarkers that predict response to conventional treatment. This review aims to examine the molecular and immune landscape of angiosarcoma in association with its aetiology, anatomical sites, prognosis and therapeutic options. We summarise current efforts to characterise angiosarcoma subtypes based on molecular and immune profiling. Finally, we highlight promising technologies such as single-cell spatial “omics” that may further our understanding of angiosarcoma and propose strategies that can be similarly applied for the study of other rare cancers.}
}
@article{YANG2025100187,
title = {Optimizing therapeutic strategies for hypertensive disorders of pregnancy through multi-omics integration and network pharmacology},
journal = {Letters in Drug Design & Discovery},
volume = {22},
number = {11},
pages = {100187},
year = {2025},
issn = {1570-1808},
doi = {https://doi.org/10.1016/j.lddd.2025.100187},
url = {https://www.sciencedirect.com/science/article/pii/S1570180825001927},
author = {Jie Yang and Lei Zhang and Jiayi Xie},
keywords = {Hypertension, Pregnancy, Network pharmacology, Multi-omics approach, Drug development},
abstract = {Hypertensive disorders of pregnancy (HDP) are common and serious complications, affecting approximately one in ten pregnancies and significantly increasing the risk of adverse maternal and perinatal outcomes. Despite improvements in clinical management and preventive strategies, persistent disparities in HDP incidence and outcomes across populations underscore the urgent need for more precise and effective therapeutic approaches. The pathogenesis of HDP is multifactorial, involving endothelial dysfunction, immune dysregulation, and oxidative stress. Although several treatment strategies exist, safe and targeted therapies remain limited, and clinical management continues to face significant challenges. In recent years, the rapid advancement of multi-omics technologies has enabled comprehensive exploration of HDP mechanisms across molecular layers, including transcriptomics, proteomics, and metabolomics. Coupled with network pharmacology, which focuses on multi-target and multi-component drug actions, these approaches offer a promising framework to systematically identify molecular targets and guide the development of more precise therapeutic interventions. This review summarizes current progress in the application of multi-omics and network pharmacology to HDP and highlights future directions for integrating these approaches to advance personalized medicine and improve maternal-fetal outcomes.}
}
@article{XIE2026,
title = {Lactylation: A Modulator of Progression and Therapeutic Responses in Digestive System Cancers and Non-Malignant Liver Diseases},
journal = {Current Genomics},
year = {2026},
issn = {1389-2029},
doi = {https://doi.org/10.1016/j.curgen.2026.09.001},
url = {https://www.sciencedirect.com/science/article/pii/S1389202926000334},
author = {Yihan Xie and Xiang Li and Wei Guo and Wenxin Li and Ziyi Yang and Yuhao Xie and Sinong Li and Han Wang and Du Ruixia and Tian Li and Liang Sang and Zhe Liu},
keywords = {Lactylation, Post-translational modification, Cancer, Liver diseases, Epigenetics, Metabolism, Tumor microenvironment},
abstract = {Protein lactylation is an emerging post-translational modification (PTM) driven by the accumulation of lactate in disease states; it serves as a key regulatory mechanism linking cellular metabolism, epigenetics, and immune regulation. The molecular system regulating lactoylation includes “writers”, “erasers” and “readers”. This mechanism has broad implications for both histone and non-histone lactylation and can influence cancer stem cell (CSC) properties as well as the microenvironment of tumors and non-malignant liver diseases by regulating gene transcriptional activity in cancer and non-malignant liver diseases. Recent studies have shown that lactylation promotes immunosuppression and drug resistance, a finding that offers new directions for therapeutic interventions in both cancer and non-malignant liver diseases. Lactylation prominently expressed in digestive system cancers; it is also involved in the pathological processes of non-malignant liver diseases. There are various methods for detecting lactylation, and the potential of its associated biomarkers in disease diagnosis and prognostic assessment has also been highlighted. Currently, many drugs under development are attempting to inhibit the progression of tumors and other diseases by regulating lactylation through targeting lactylation-related markers. However, lactylation has limitations. There is limited research on lactylation “readers” and clinical drugs targeting lactylation, and the lack of unified quantitative standards for lactylation detection still poses limitations for the diagnosis of clinical samples and prognostic assessment. Through the integration of multi-omics research methods and experimental validation, the mechanisms underlying lactylation will become clearer in the future. This review summarizes the role of lactylation in the onset, progression, and treatment resistance of gastrointestinal tumors and non-malignant liver diseases, as well as its associated limitations and future prospects. It provides guidance for developing precision medicine strategies targeting lactylation modifications to improve clinical outcomes for patients with complex diseases. This research was supported by the Liaoning Provincial Science and Technology Program Joint Project (Grant Number: 2023JH2/101700082).}
}
@article{HE2026105151,
title = {Cancer-associated thrombosis in the era of precision oncology: Mechanisms, challenges and future directions},
journal = {Critical Reviews in Oncology/Hematology},
volume = {219},
pages = {105151},
year = {2026},
issn = {1040-8428},
doi = {https://doi.org/10.1016/j.critrevonc.2026.105151},
url = {https://www.sciencedirect.com/science/article/pii/S1040842826000387},
author = {Chaonan He and Xianghao Dai and Dongyu Feng and Qi Zhou and Wenhong Liu and Ye Xu and Fangfang Tao and Mengjiao Hu},
keywords = {Cancer-associated thrombosis, Venous thromboembolism, Immune checkpoint inhibitor, Gene mutation, Mouse model, Risk prediction},
abstract = {Cancer-associated thrombosis (CAT) is a common and life-threatening complication in cancer patients, leading to poor prognosis and reduced survival rate. The pathophysiology process of CAT is driven by a complex interplay of tumor-related process, including tumor-specific genetic mutations, activation of coagulation cascades, multicellular interactions within the tumor microenvironment, and suppression of the fibrinolytic system. Moreover, anticancer therapies, particularly immune checkpoint inhibitors have been shown to further exacerbate this risk. A profound understanding of these mechanisms is essential for therapeutic advancement, necessitating robust preclinical models that accurately replicate the complex pathological features of the disease. This review synthesizes the core mechanisms of CAT, critically evaluates the strategic application of current CAT models, and highlights recent advances in predictive biomarkers, risk assessment models, and emerging therapeutic targets. By integrating mechanistic insights with translational challenges, this review seeks to inform and guide the development of more effective, targeted interventions for CAT.}
}
@article{GNAGNARELLA2021103202,
title = {Ethnicity as modifier of risk for Vitamin D receptors polymorphisms: Comprehensive meta-analysis of all cancer sites},
journal = {Critical Reviews in Oncology/Hematology},
volume = {158},
pages = {103202},
year = {2021},
issn = {1040-8428},
doi = {https://doi.org/10.1016/j.critrevonc.2020.103202},
url = {https://www.sciencedirect.com/science/article/pii/S1040842820303383},
author = {Patrizia Gnagnarella and Sara Raimondi and Valentina Aristarco and Harriet Johansson and Federica Bellerba and Federica Corso and Simone Pietro {De Angelis} and Pietro Belloni and Saverio Caini and Sara Gandini},
keywords = {VDR, Polymorphisms, Vitamin D, Cancer, Review, Meta-analysis, Ethnicity},
abstract = {Vitamin D receptors polymorphisms are found to be associated with several cancers. Since their prevalence vary across ethnicities and ethnicity itself seems to influence the cancer risk, a comprehensive meta-analysis was performed to investigate the role of VDR Fok1, Bsm1, Taq1, Apa1, Cdx2 and cancer risk at specific organ sites. Odds ratios, calculated with random-effects models, summarized one-hundred-ninety-two independent studies for twenty-two cancer sites. Evidence was provided that Fok1, Bsm1, Cdx2, Apa1 and Taq1 are linked to cancer susceptibility for colorectal, lung, ovarian, skin, multiple myeloma and brain cancer. Stratifying by ethnicity, some differences were found, partially explained by minor allele frequency (MAF), for colorectal cancer, ovarian and prostate cancer in Caucasian and prostate cancer in Asian populations. In summary, ethnicity may be a modifier of cancer risk, in particular for hormone dependent cancers and it should be considered evaluating the effect of VDR on cancer risk.}
}
@article{IZZO2026101332,
title = {Intraductal papillary mucinous neoplasms: a comprehensive analysis combining genetic, immunopathological and clinical management},
journal = {Current Problems in Cancer},
volume = {64},
pages = {101332},
year = {2026},
issn = {0147-0272},
doi = {https://doi.org/10.1016/j.currproblcancer.2026.101332},
url = {https://www.sciencedirect.com/science/article/pii/S0147027226000668},
author = {Giovanni Izzo and Pietro Tralongo and Marina Cerreto and Gabriele Ricciardi and Mariagiovanna Ballato and Walter Giuseppe Giordano and Emanuela Germanà and Rosa Scarfì and Antonio Ieni and Valeria Zuccalà and Vincenzo Fiorentino and Carmine Carbone and Maurizio Martini and Giuseppe Giuffrè},
keywords = {Intraductal papillary mucinous neoplasm, Pancreas, Invasive carcinoma, miRNA, Molecular pathways},
abstract = {Intraductal papillary mucinous neoplasms (IPMNs) are a heterogeneous group of pancreatic cysts with the potential to transform into invasive pancreatic cancer. These cysts result from alterations in the epithelial cells of the pancreatic ducts, leading to the overproduction of mucin and duct dilation. Based on ductal involvement, IPMNs can be classified into three types: Main Duct (MD)-IPMN if located in the main duct, Branch Duct (BD)-IPMN if located in one or more secondary ducts, and Mixed Type (MT)-IPMN if it involves both the main and secondary ducts. Advances in abdominal imaging techniques have enabled more frequent identification and characterization of IPMNs. Second-level examinations, such as endoscopic ultrasound (EUS) or cystic fluid analysis, are essential for determining the risk of malignancy and implementing timely interventions for curative purposes. Considering that these precursor lesions are asymptomatic in most cases, and bearing in mind the extremely high mortality rate of pancreatic cancer, searching for new biomarkers with predictive value for malignant transformation appears essential. By integrating histopathological features, molecular alterations, and emerging cyst fluid biomarkers, this review aims to frame IPMN as a biologically heterogeneous disease and highlights how a molecularly informed approach may enable more precise, personalized risk stratification beyond current guideline-based management.}
}
@article{LI2026153618,
title = {Molecular functions of deadenylases and their regulatory mechanisms in human diseases: A review},
journal = {International Journal of Biological Macromolecules},
volume = {377},
pages = {153618},
year = {2026},
issn = {0141-8130},
doi = {https://doi.org/10.1016/j.ijbiomac.2026.153618},
url = {https://www.sciencedirect.com/science/article/pii/S0141813026035634},
author = {Jia-Hui Li and Li-Na Zhang},
keywords = {Deadenylases, mRNA deadenylation, mRNA degradation, Poly(A) tail, Human diseases},
abstract = {Deadenylases possess intrinsic 3′ → 5′ exoribonuclease activity, which specifically mediates the removal of poly(A) tails at the 3′ terminus of mRNAs. As a key step in post-transcriptional mRNA processing, trimming excessive poly(A) tails to an appropriate length is critical for maintaining mRNA stability and translational efficiency. Structurally, nearly all deadenylases contain a conserved catalytic nuclease domain and are classified into the DEDD and EEP superfamilies according to the structural features of their catalytic domains. Functionally, these enzymes participate in diverse biological processes, including mRNA degradation, DNA damage response, maintenance of genomic stability, embryonic development, cellular metabolism, cell proliferation, cell cycle progression, and pluripotency regulation. Dysfunction of deadenylases compromises their capacity to remove mRNA poly(A) tails, leading to the disruption of post-transcriptional gene regulatory networks. Importantly, accumulating evidence further indicates that deadenylases are involved in the initiation and progression of a wide spectrum of pathological conditions, including telomere-related diseases, mitochondrial disorders, metabolic diseases, neurodegenerative diseases, cardiovascular diseases, reproductive disorders, and malignant tumors. In this review, we systematically summarize recent advances regarding deadenylases, with a focus on their biochemical and enzymatic properties, biological functions, and molecular mechanisms by which they contribute to human diseases. This summary aims to lay a theoretical foundation for the discovery and development of targeted therapies against deadenylase-associated diseases.}
}
@article{QI2025112224,
title = {Complications of transarterial radioembolization in hepatic malignancies: Pathophysiological insights and management paradigms},
journal = {European Journal of Radiology},
volume = {190},
pages = {112224},
year = {2025},
issn = {0720-048X},
doi = {https://doi.org/10.1016/j.ejrad.2025.112224},
url = {https://www.sciencedirect.com/science/article/pii/S0720048X25003109},
author = {Mengdi Qi and Zijia Tao and Duo Yu and Yang Zuo and Hongshan Zhong},
keywords = {Hepatic malignancies, Hepatocellular carcinoma (HCC), Colorectal liver metastases (CRLM), Yttrium-90 (Y) microspheres, Yttrium-90 selective internal radiation therapy (Y-SIRT), Transarterial radioembolization (TARE), Postprocedural complications},
abstract = {Hepatic malignancies remain among the most prevalent and lethal oncologic entities worldwide, characterized by aggressive biological behavior and dismal prognosis. Hepatocellular carcinoma (HCC) and colorectal liver metastases (CRLM) represent the predominant hepatic neoplasms, for which conventional therapies demonstrate limited efficacy in unresectable advanced-stage disease. Transarterial radioembolization (TARE), alternatively termed selective internal radiation therapy (SIRT) using yttrium-90 (90Y) labeled microspheres, has emerged as an innovative hybrid modality integrating interventional radiology with intratumoral radiotherapy. While offering distinct advantages including minimally invasive implementation, demonstrated tumor response, and abbreviated hospitalization, postprocedural complications may substantially compromise therapeutic outcomes and quality of life. Consequently, prevention and management of TARE-associated complications have become critical components of perioperative care. This comprehensive review systematically analyzes the spectrum of potential post-TARE complications while elucidating contemporary prevention strategies and therapeutic algorithms grounded in pathophysiological mechanisms.}
}
@article{DARZI2025118852,
title = {Harnessing cuproptosis for pancreatic cancer therapy: From molecular insights to clinical prospects},
journal = {Biomedicine & Pharmacotherapy},
volume = {193},
pages = {118852},
year = {2025},
issn = {0753-3322},
doi = {https://doi.org/10.1016/j.biopha.2025.118852},
url = {https://www.sciencedirect.com/science/article/pii/S0753332225010467},
author = {Ali Darzi and Siavash Boroumandi and Pouriya Khajegi and Mohammad Reza Dehdashti and Pedram Abdali and Mohammad Moein Amerinia and Fatemeh Kheirkhah and Mohammad Mahdi Ajalli and Mahla Shokouhfar},
keywords = {Cuproptosis, Pancreatic cancer, Therapy, Diagnose, Cancer},
abstract = {Pancreatic cancer (PC) remains a high-fatality malignancy with limited clinical progress, characterized by aggressive biology, marked resistance to standard therapies, and dismal outcomes. Even with state-of-the-art resection, radiotherapy, and multidrug chemotherapy, median survival benefits are modest, highlighting an urgent need for mechanism-based interventions. Cuproptosis, a newly delineated modality of regulated cell death initiated by intracellular copper accumulation and mitochondrial stress, presents a biologically coherent therapeutic avenue. Distinct from apoptosis, necroptosis, and ferroptosis, cuproptosis is driven by the direct binding of copper to lipoylated enzymes of the tricarboxylic acid (TCA) cycle, resulting in bioenergetic failure, misfolded protein aggregation, and collapse of cytotoxic proteostasis. Converging studies suggest that copper disequilibrium and metabolic reprogramming are recurrent features of PC, potentially contributing to malignant progression, immune evasion, and chemoresistance. These insights motivate two complementary strategies: first, therapeutic manipulation of copper flux, via chelators, ionophores, or transport modulators, to selectively trigger cuproptosis in tumor cells; and second, sensitization of mitochondrial metabolism, through targeting lipoic-acid pathway components, pyruvate utilization, or TCA load, to lower the threshold for cuproptotic killing. In parallel, multi-omic interrogation of cuproptosis-associated genes, proteins, and metabolites may yield prognostic and predictive biomarkers, enabling risk-adapted treatment selection and rational combinations with cytotoxic, targeted, or immunotherapeutic modalities. This review synthesizes recent advances on cuproptosis in PC and outlines its translational potential as both a therapeutic target and a biomarker framework.}
}
@article{SHI2023926,
title = {Decoding Human Biology and Disease Using Single-cell Omics Technologies},
journal = {Genomics, Proteomics & Bioinformatics},
volume = {21},
number = {5},
pages = {926-949},
year = {2023},
issn = {1672-0229},
doi = {https://doi.org/10.1016/j.gpb.2023.06.003},
url = {https://www.sciencedirect.com/science/article/pii/S1672022923001043},
author = {Qiang Shi and Xueyan Chen and Zemin Zhang},
keywords = {Single-cell omics, Computational method, Cellular heterogeneity, Disease, Cancer research},
abstract = {Over the past decade, advances in single-cell omics (SCO) technologies have enabled the investigation of cellular heterogeneity at an unprecedented resolution and scale, opening a new avenue for understanding human biology and disease. In this review, we summarize the developments of sequencing-based SCO technologies and computational methods, and focus on considerable insights acquired from SCO sequencing studies to understand normal and diseased properties, with a particular emphasis on cancer research. We also discuss the technological improvements of SCO and its possible contribution to fundamental research of the human, as well as its great potential in clinical diagnoses and personalized therapies of human disease.}
}
@article{LI2026218220,
title = {Foundation models in clinical oncology: Progresses and perspectives},
journal = {Cancer Letters},
volume = {639},
pages = {218220},
year = {2026},
issn = {0304-3835},
doi = {https://doi.org/10.1016/j.canlet.2025.218220},
url = {https://www.sciencedirect.com/science/article/pii/S030438352500792X},
author = {Jing Li and Jing Fu and Xin Geng and Hongyang Wang},
keywords = {Foundation models, Multimodal integration, Ethics, Precision medicine},
abstract = {Cancer remains a leading global burden, and the volume of multimodal oncology data—spanning digital pathology, radiology, genomics, and Electronic Health Records (EHRs)—is expanding exponentially. Foundation models (FMs), trained on broad unlabeled corpora and adapted to diverse tasks, have catalyzed advances in screening and diagnosis, outcome prediction, and inference of actionable molecular alterations, with early traction in treatment selection, drug repurposing, and clinical trial design. Yet key barriers persist: variability in tissue processing, imaging protocols, and data standards drives heterogeneity; the scarcity of well-annotated, multi-institutional cohorts limits development and independent validation; regulatory guidelines and policy making for FM-enabled diagnostics are still maturing; privacy and data sovereignty complicate data sharing; and bias against under-represented populations threatens equitable performance. A practical way forward is to combine high-quality, representative cohorts and interoperable data infrastructure with cross-institutional partnerships that embed AI talent within clinical teams—closing these gaps and enabling generalizable, trustworthy tools to reshape cancer care.}
}
@article{FORMELLI2025115671,
title = {Classic versus innovative strategies for immuno-therapy in pancreatic cancer},
journal = {Advanced Drug Delivery Reviews},
volume = {225},
pages = {115671},
year = {2025},
issn = {0169-409X},
doi = {https://doi.org/10.1016/j.addr.2025.115671},
url = {https://www.sciencedirect.com/science/article/pii/S0169409X25001565},
author = {Maria Giovanna Formelli and Andrea Palloni and Simona Tavolari and Chiara Deiana and Elisa Andrini and Mariacristina {Di Marco} and Davide Campana and Giuseppe Lamberti and Giovanni Brandi},
keywords = {Pancreatic ductal adenocarcinoma, Immunotherapy, Immune checkpoint inhibitors, Adoptive cell therapy, Vaccine, Microbiota, Tumor microenvironment},
abstract = {Pancreatic ductal adenocarcinoma (PDAC) is an aggressive malignancy with a dismal prognosis. Immunotherapy with immune checkpoint inhibitors (ICIs), either as monotherapy, in combination with other ICIs, or alongside chemotherapy, has significantly improved outcomes in several solid tumors. However, its efficacy in PDAC remains limited due to multiple resistance mechanisms. Key determinants of immunotherapy resistance in PDAC include physical barriers that hinder immune cells infiltration, such as aberrant vasculature, cancer-associated fibroblasts (CAFs), and excessive hyaluronic acid deposition in the tumor microenvironment (TME). Additionally, PDAC is characterized by an immunosuppressive TME enriched with regulatory T cells (Tregs) and myeloid-derived suppressor cells (MDSCs), and by low immunogenicity of tumor cells due to KRAS mutations, MYC overexpression, and a low tumor mutational burden, further impairing antitumor immunity. This review discusses advanced drug delivery systems to overcome determinants of immunotherapy resistance and to improve outcomes, explores emerging immunotherapy strategies, including adoptive cell therapies, cancer vaccines, and the potential role of microbiota as modulator of TME through fecal microbiota transplantation or intratumoral bacterial inoculation. Given the ambivalent role of microbiota in PDAC, the need for a clear definition of favorable strains and their selection is highlighted. Emerging approaches involving engineered bacteria and artificial intelligence applications are also explored. Finally, we propose a hypothetical conceptual framework for an innovative multimodal immunotherapy approach to overcome resistance and improve clinical outcomes in PDAC.}
}
