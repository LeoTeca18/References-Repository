@INPROCEEDINGS{11171700,
  author={Uddin Forkan, Md. Imam and Sarker, Adnan Sami and Mazumder, Prasun and Mural, Hrittik and Islam Khan, MD. Tohidul and Rahman, Ishanur},
  booktitle={2025 International Conference on Quantum Photonics, Artificial Intelligence, and Networking (QPAIN)}, 
  title={Integrated Survey and Clinical Data for Risk Assessment and Survival Prediction in Colorectal Cancer Using Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Colorectal cancer (CRC) continues to be a significant contributor to global mortality rates, with its incidence influenced by various factors including dietary habits, genetic predispositions, and age demographics. This study uses a dual-dataset strategy that combines survey and clinical data, providing a unique combination of laboratory-validated clinical information and patient-reported outcomes to improve the accuracy of CRC survival forecasts. Machine learning classifiers were utilized to assess each dataset independently and to categorize individuals into high-risk and low-risk survival groups based on age and gender. Key variables, including treatment type, survival status, and disease-free survival (DFS) events, were analyzed across the datasets, uncovering significant similarities within the respective demographic groups. The Random Forest algorithm attained the highest accuracy of 93 % on the survey data, while the logistic regression model reached an accuracy of 96% on the clinical dataset compared to existing work. Our work suggests that patients under 50 and over 70 face an increased risk, while patients between 50 and 70 exhibit a comparatively lower risk when they receive prompt treatment. By incorporating both clinical and demographic variables in the prediction of colorectal cancer survival, machine learning models prove to be effective in recognizing high-risk profiles and guiding personalized treatment plans. This technique improves the accuracy of predictions regarding colorectal cancer outcomes, serving as a crucial resource for targeted interventions and better patient prognoses.},
  keywords={Surveys;Logistic regression;Accuracy;Face recognition;Refining;Colorectal cancer;Predictive models;Data models;Risk management;Random forests;Colorectal cancer;Machine learning;Gender;Sex;Age;Survival prediction},
  doi={10.1109/QPAIN66474.2025.11171700},
  ISSN={},
  month={July},}@INPROCEEDINGS{11681037,
  author={S, Anbalagan},
  booktitle={2026 10th International Conference on Inventive Systems and Control (ICISC)}, 
  title={Accurate Detection and Prognostic Assessment of Colon Cancer Using an R-MobileNet-Driven Deep Learning Model with Clinical Structured Data}, 
  year={2026},
  volume={},
  number={},
  pages={903-907},
  abstract={Proper diagnosis and prognosis of colon cancer is essential to enhancing patient outcomes and informing individual treatment plans. This paper has formulated a deep learning model that is powered by the R-MobileNet design to perform effective colon cancer classification through clinical structured data. The model relied on a variety of data, featuring systematic pre-processing measures and careful validation to achieve as much predictive reliability as possible. Measures of evaluation related to ROC curve analysis, classification accuracy, predicted class distribution, and confusion matrix were evaluated, and the R-MobileNet model consistently performed well on validation datasets, with an area under the curve (AUC) of 0.75 and a high classification accuracy of 0.96. Predicted classes distribution and confusion matrix indicate successful discrimination of the relevant cell types and highlight the ability of this method to accurately detect and stratify prognosis. These findings confirm the incorporation of advanced deep learning algorithms such as R-MobileNet into the clinical decision-making process in managing colon cancer.},
  keywords={Modeling;Colorectal cancer;Training;Deep learning;Accuracy;Printing;Confusion matrices;Cells (biology);Visualization;Cancer detection;Colon cancer;R-MobileNet;Deep learning;Clinical structured data;Confusion matrix},
  doi={10.1109/ICISC69558.2026.11681037},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10894577,
  author={Velmurugan, R and Suresh, K and Thilagaraj, T and Sharma, Meenakshi and Saranya, D.},
  booktitle={2025 International Conference on Multi-Agent Systems for Collaborative Intelligence (ICMSCI)}, 
  title={Enhancing Prognostication in Colorectal Cancer with Integrated Machine Learning for Improved Survival Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={1681-1686},
  abstract={Machine learning methods are recently used to predict patient survival in colorectal cancer using such models as Convolutional Neural Networks (CNN), Recurrent Neural Networks (RNN), VGG16, and Support Vector Machines (SVM). Taking advantage of a combination of CT, MRI scan images, and clinical records with drug recommendations, the study also checks to see how these models compare for distinguishing between patients in terms of their illness course-whether they are going to get better or worse over time. The results reveal VGG16 has better accuracy than CNN, RNN and SVM; as the highest-performing model tested, it also demonstrates superior precision, recall and F1-score. The research findings also validate these proposed models as they compare favorably with existing literature. This presents a promising proposition: a new, revolutionary approach to using artificial intelligence to boost prognostic accuracy.},
  keywords={Support vector machines;Drugs;Recurrent neural networks;Accuracy;Magnetic resonance imaging;Computed tomography;Machine learning;Colorectal cancer;Predictive models;Convolutional neural networks;Colorectal cancer;Machine learning;Prognostication;Survival outcomes;Personalized treatment},
  doi={10.1109/ICMSCI62561.2025.10894577},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11546167,
  author={Hossain, Md. Dulal and Akther, Maria and Khan, Md. Rabby and Mahin, Md. Jubayerul Hasan and Ruman, Umme and Ahmmed, Mostak and Habib, Md. Ahsan},
  booktitle={2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence & Networking (QPAIN)}, 
  title={A Hybrid Explainable Machine Learning and Deep Learning Framework for Colorectal Cancer Biomarker Discovery and Prognosis Using Transcriptomic Data}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Colon cancer is still one of the major causes of cancer, related deaths globally. This problem is mostly caused by difficulties in diagnosis at the early stages of the disease and in prognosis accuracy. That is why it is crucial to find diagnostic and prognostic biomarkers that can help in identifying the disease so as to improve the patients outcomes. This study presents a hybrid computational framework that combines machine learning (ML), deep learning (DL), and bioinformatics methods to detect the most influential genes and biomarkers that are relevant to colorectal cancer. In this work, RNA, Seq gene expression data and the clinical information were retrieved from the publicly available TCGA datasets. To address class imbalance and high dimensionality, data preprocessing was performed using SMOTE for class balancing and ANOVA-based feature scaling. A hybrid feature selection strategy combining SHAP, Boruta, and Recursive Feature Elimination (RFE) was employed to extract the most informative genes. Five predictive models, i. e., XGBoost, Random Forest, LightGBM, 1D Convolutional Neural Network (1DCNN), and Bi, directional Long Short, Term Memory (BiLSTM), were designed and tested. Panel LightGBM and Random Forest were able to achieve the highest classification accuracies of 94.5% and 94%, respectively. Survival analysis using Cox proportional hazards modeling and Kaplan-Meier estimation, along with protein-protein interaction network analysis and pathway enrichment, confirmed the prognostic significance of the identified biomarkers. Among the cancer, related pathways investigated, PI3K, AKT, Wnt/, catenin, and TP53 signaling, were found to be significantly associated with the selected genes. The proposed hybrid framework demonstrates strong potential for robust biomarker discovery and provides valuable insights for personalized diagnosis and prognosis of colon cancer.},
  keywords={Modeling;Biomarkers;Colorectal cancer;Machine learning;Cancer;Printing;Feature extraction;Convolutional neural networks;Gene expression;Limiting;Colon cancer;Diagnostic biomarkers;Prognostic biomarkers;Machine learning;Deep learning;RNA-Seq;Feature selection},
  doi={10.1109/QPAIN69676.2026.11546167},
  ISSN={},
  month={April},}@INPROCEEDINGS{11189664,
  author={Kumar, Anand and Kaur, Savleen},
  booktitle={2025 International Conference on Computing, Intelligence, and Application (CIACON)}, 
  title={Unravelling Colorectal Cancer Survival Factors through Explainable AI in Clinical Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={One of the significant issues affecting public health is Colorectal cancer (CRC) that underlines the necessity of establishing accurate survival predictive models for improving patient care and clinical decision-making. The current study develops a framework based on machine learning, which makes predictions using clinical and survival data, leveraging Explainable AI (XAI) methods to improve interpretability. The dataset, which consisted of various phenotypic and survival data, formed the basis of predictive model development and testing. The predictive models developed consisted of Random Forest and XGBoost, which made an ensemble using a weighted averaging mechanism (60% contributed by Random Forest and 40% by XGBoost). The resulting ensemble accurately predicted by 87.6% with 0.823 as the area under the curve, reflecting its capability to identify complex patterns in clinical datasets. To identify prognostic factors and improve transparency, Shapley Additive Explanations (SHAP) were used that substantially impact survival predictions. However, data heterogeneity, richness, gaps, and computation costs remain significant barriers. Future studies must focus on improving models' scalability, integrating deep learning algorithms, and using clinical data in real-world scenarios for precision medicine. Additionally, regulatory approval and improving interdisciplinary communication among bioinformaticians, oncologists, and data scientists are necessary for making AI-powered survival predictive models widely accessible. The integration of XAI in CRC studies can potentially provide actionable clinical insights, enhance patient stratification, and facilitate individualized treatment planning, strengthening AI's position in precision medicine in the oncology arena.},
  keywords={Machine learning algorithms;Additives;Accuracy;Explainable AI;Precision medicine;Colorectal cancer;Predictive models;Prediction algorithms;Random forests;Testing;Colorectal Cancer (CRC);Survival Prediction;Machine Learning (ML);Explainable AI (XAI);Shapley Additive Explanations (SHAP);Health;cancer},
  doi={10.1109/CIACON65473.2025.11189664},
  ISSN={},
  month={July},}@INPROCEEDINGS{11648953,
  author={Ali, Md Musa and Gupta, Shivam},
  booktitle={2026 2nd International Conference on Sustainable Computing and Integrated Communication in Changing Landscape of AI (ICSCAI)}, 
  title={Deep Learning for Cancer Forecast Predictions}, 
  year={2026},
  volume={},
  number={},
  pages={468-471},
  abstract={Deep learning has applications in many areas of healthcare, including cancer cell categorization, digital pathology, hospital admission prediction, medication creation, and assistance for medical professionals. disease prognosis is crucial to clinical care since it entails estimating patient life times, chances of recurrence, and disease outcomes. Improvements in cancer prognosis prediction have been made possible by advances in biomedical translational research, together with advanced statistical analysis and machine learning approaches. Deep learning in particular has made significant strides in artificial intelligence and processing capacity in recent years. Additionally, there are now opportunities to create more accurate and reliable models for predicting the prognosis of cancer because to the cost reductions. This article examines current works that create prognostic models for cancer using deep learning. When dealing with large datasets, deep learning is hailed as a flexible model that requires less data engineering and produces excellent predictions. Deep learning applications for cancer prediction have shown performance on par with or better than more traditional methods like Cox proportional hazards modelling.},
  keywords={Modeling;Cancer;Printing;Deep learning;Machine learning;Artificial intelligence;Machining;Neural networks;Conferences;Breast cancer;Deep Learning;Cancer Prognosis Prediction;Healthcare;Multi-omics Data;Machine Learning;Neural Networks;Survival Analysis;Data Annotation;Data Annotation Expertise and Biomedical Research},
  doi={10.1109/ICSCAI68849.2026.11648953},
  ISSN={},
  month={May},}@ARTICLE{11576053,
  author={Shankar, Rhithu Sri and Shankar, Ruppikha Sree and Panicker, Rani Oomman},
  journal={IEEE Access}, 
  title={Interpretable Colorectal Cancer Recurrence Risk Prediction Using a Stacked Cox Survival Framework With Counterfactual Intervention Analysis}, 
  year={2026},
  volume={14},
  number={},
  pages={107603-107626},
  abstract={Colorectal cancer remains one of the leading causes of cancer-related mortality worldwide, with recurrence strongly influencing long-term patient prognosis. Existing machine learning approaches for colorectal cancer prediction predominantly formulate recurrence assessment as a static binary classification task, limiting temporal risk modeling and clinically actionable interpretability. To address these limitations, this study proposes an interpretable colorectal cancer recurrence risk prediction framework based on a stacked ensemble of domain-specific Cox Proportional Hazards survival models integrated with risk stratification and counterfactual intervention analysis. The framework decomposes patient variables into clinical, treatment-related, and lifestyle domains, each modeled using an independent survival estimator and combined through a meta-level Cox model to produce interpretable domain-level risk contributions. Evaluated on a large-scale colorectal cancer dataset containing 89,945 patient records, the proposed framework achieved a concordance index of 0.82, outperforming a standalone Cox model (C-index = 0.76) and conventional classification baselines including Random Forest (AUC = 0.76) and Gradient Boosting (AUC = 0.75). Kaplan–Meier analysis demonstrated statistically significant separation between low-, medium-, and high-risk groups ( $p $  < 0.001). Counterfactual intervention analysis further showed that surgical treatment and combined lifestyle modifications substantially reduced predicted recurrence hazard across high-risk patients. An interactive clinical dashboard was additionally developed to support real-time risk prediction and personalized intervention planning. The proposed framework provides a clinically interpretable and actionable approach for survival-based colorectal cancer recurrence assessment and decision support.},
  keywords={Modeling;Colorectal cancer;Machine learning;Cancer;Timing;Hazards;Aging;Tumors;Diseases;Machining;Colorectal cancer;survival analysis;interpretable machine learning;clinical decision support;counterfactual analysis;risk stratification;SDG},
  doi={10.1109/ACCESS.2026.3706377},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11557925,
  author={Shen, Zepeng and Lin, Sifang and Wang, Yong and Saunders, Emily and Dai, Yiyang},
  booktitle={2026 7th International Seminar on Artificial Intelligence, Networking and Information Technology (AINIT)}, 
  title={Survival Risk Prediction Model for Colorectal Cancer Patients Based on Graph Convolutional Network and TCGA Multi-Omics Data Integration}, 
  year={2026},
  volume={},
  number={},
  pages={370-373},
  abstract={Colorectal cancer exhibits substantial molecular heterogeneity, and conventional survival risk prediction methods based on a single omics modality or shallow feature representations are often inadequate for accurate prognostic assessment. To address this limitation, this study proposes a multi-omics survival risk prediction model for the TCGA colorectal cancer cohort by integrating existing multi-omics fusion strategies with graph convolution-based survival analysis frameworks. Specifically, transcriptomic, methylation, mutation, and clinical data are first integrated to construct a patient similarity graph, while multi-branch encoders are employed to extract high-level representations from each omics modality. Subsequently, graph convolution and graph attention mechanisms are jointly introduced to capture topological relationships among patients, and a cross-omics gated fusion strategy together with a hierarchical feature interaction module is designed to enhance the complementarity of heterogeneous data and reduce redundant noise. Finally, Cox loss, ranking constraints, and regularization terms are incorporated to improve risk stratification and survival prediction. Experimental results demonstrate that the proposed model outperforms several existing methods in terms of C-index, risk stratification significance, and prediction stability.},
  keywords={Modeling;Printing;Cancer;Colorectal cancer;Equations;Tumors;Indexes;Indexing;Tagging;Colorectal Cancer;Survival Risk Prediction;Graph Convolutional Network;Multi-Omics Integration;TCGA},
  doi={10.1109/AINIT70033.2026.11557925},
  ISSN={},
  month={May},}@INPROCEEDINGS{10866806,
  author={S, Ananthi and J, Rithish Kumar and R, Sai Prasanth and G, Soundhar and I, Sujith},
  booktitle={2024 4th International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)}, 
  title={Artificial Intelligence Driven Colorectal Cancer Classification Via Deep Learning Technique}, 
  year={2024},
  volume={},
  number={},
  pages={902-907},
  abstract={Collateral cancer is a serious concern for patients with primary tumors, as the development of secondary tumors can significantly reduce survival rates and increase the complexity of treatment. Colon polyps are a common precursor to colorectal cancer, and early detection is essential for effective treatment. Traditional strategies for polyp detection include colonoscopy and biopsy, which can be invasive and time-consuming. In this work, we explore the use of convolutional neural networks (CNNs) to detect polyps in colonoscopy images, as machine learning methods have shown potential in this area. Improving patient outcomes requires early detection and prevention of collateral cancer. However, precisely predicting the probability of recurrent tumors can be challenging due to the complexity of cancer progression and the multiplicity of factors that may influence tumor formation. In this study, we examine the use of a CNN to forecast the likelihood that patients with primary tumors may develop collateral cancer. Machine learning algorithms have demonstrated potential in predicting cancer outcomes based on patient data. The study uses a dataset of colonoscopy images, including both positive and negative cases of polyps. A CNN model is developed using this dataset to classify images as either positive or negative for polyps. The model is trained using a supervised learning approach, where the network learns from labeled examples of images with and without polyps. The accuracy of the CNN model is compared to other polyp detection strategies, such as traditional image analysis techniques and other machine learning algorithms.},
  keywords={Training;Surveys;Machine learning algorithms;Accuracy;Supervised learning;Colonoscopy;Colorectal cancer;Ubiquitous computing;Complexity theory;Convolutional neural networks;Colorectal Cancer;Medical Imaging;Machine Learning;Deep Learning;Neural Networks},
  doi={10.1109/ICUIS64676.2024.10866806},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11542096,
  author={Thaseen, Sumaiya and M, Vanitha and Mohan, Geetha and Veronica, Benita},
  booktitle={2026 International Conference on Artificial Intelligence, Systems, and Emerging Technologies (ICAISET)}, 
  title={Real-Time Colon Cancer Detection using Deep Learning: A Comparative Analysis of EfficientNet Architectures}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Colorectal cancer (CRC) is one of the most common and deadly cancers worldwide, with early detection being crucial for improving survival rates. This paper focuses on developing an advanced system for the automated real-time detection of colon cancer using deep learning techniques, specifically convolutional neural networks (CNNs). The study conducts an extensive comparison of three EfficientNet architectures (B0, B3, and B4) using a dataset of 20,038 augmented images from LC25000, categorized as colon adenocarcinoma and benign tissue. The system uses sophisticated data augmentation methods, including rotation, flipping, scaling, and translation, to improve model robustness. The experimental outcomes demonstrate that EfficientNetB3 outperforms with 99.87% accuracy, 1.00 precision, recall, and F1-score across all evaluation metrics, significantly outperforming both B0 (70% accuracy) and B4 (73% accuracy) variants. The research model exhibits outstanding generalization capabilities and demonstrates minimal misclassifications on the test data. Develop a web application that allows users to quickly interact with the model and check diagnostic results. This study shows that EfficientNetB3's optimized architecture offers the best combination of accuracy and computational efficiency for clinical deployment in limited resource constrained.},
  keywords={Modeling;Accuracy;Colorectal cancer;Training;Deep learning;Printing;Timing;Convolutional neural networks;Architecture;Cancer detection;Colon cancer detection;deep learning;EfficientNet;convolutional neural networks;histopathological image classification;transfer learning;medical image analysis;automated diagnosis},
  doi={10.1109/ICAISET66439.2026.11542096},
  ISSN={},
  month={April},}@INPROCEEDINGS{11031818,
  author={Dharshini, S.Dhivya and Anand, K.},
  booktitle={2025 International Conference on Frontier Technologies and Solutions (ICFTS)}, 
  title={SIGMO: Sigmoid Colon Cancer Prediction Using Machine Learning and Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Many sigmoid colon cancer prediction systems rely on traditional methods, which are prone to human error and ineffective in spotting minute variations. However, systems based on Random Forest (RF) and Support Vector Machines (SVM) are known to have drawbacks, including poor generalization and overfitting. Predictive Model machine learning (ML) and deep learning (DL) models such as Convolutional Neural Networks (CNNs), autoencoders, and XGBoost are used in the proposed SIGMO to address these issues. It also integrates rich and unstructured medical images and robust and structured clinical data to provide accurate and dependable predictions. Therefore, SIGMO exhibits cutting-edge efficiency by utilizing feature extraction, dimensionality reduction, and ensemble approaches, which clarifies the reasons for the underperformance of existing systems. These results demonstrate the significance of integrating multi-modal data for diagnosis and the real-time deployment of such systems in addition to enhanced diagnostic accuracy. It also shows a significant increase (92.8%) in accuracy, precision (89.6%), recall (94.2%), and AUC-ROC (95%) over traditional systems..},
  keywords={Deep learning;Training;Support vector machines;Accuracy;Computational modeling;Colorectal cancer;Predictive models;Real-time systems;Medical diagnostic imaging;Tumors;Sigmoid colon cancer;Machine learning;Deep learning;XGBoost;Medical imaging;Cancer diagnosis},
  doi={10.1109/ICFTS62006.2025.11031818},
  ISSN={},
  month={March},}@INPROCEEDINGS{9398977,
  author={Ho, Danliang and Chong, Dawn Qingqing and Tay, Brenda and Tan, Iain BeeHuat and Motani, Mehul},
  booktitle={2020 IEEE International Conference on E-health Networking, Application & Services (HEALTHCOM)}, 
  title={Prognosticating Colorectal Cancer Recurrence using Machine Learning Techniques}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Colorectal cancer is among the top three most commonly occurring cancers worldwide, and around 30-40% of patients treated by curative intent surgery will experience cancer recurrence. Proactive prognostication would enable clinicians to better plan treatment modality and intensity, and follow-up frequency to reduce recurrence. Here, we study the application of machine learning models to predict cancer recurrence in a cohort of 904 post-resection colorectal cancer patients. We employ heterogeneous structured and temporal clinical features including demographic and diagnostic information, tumour stage and location details, biochemistry and molecular typing results, as well as surgical details and treatment parameters. We characterize the performance of multiple machine learning classifiers including logistic regression, support vector machine, gradient boosting and multi-layer perceptron on structured data. Our best model achieved a sensitivity of 80.7% and a specificity of 88.2%. This is comparable to and even exceeding the performance of carcinoembryonic antigen (CEA), a tumour marker commonly used in the clinic for colorectal cancer monitoring. We also demonstrate feasibility for accurate forecasting of recurrence up to 4 months in advance, as well as the possibility of predicting recurrence as early as 6 months post-surgery. Our results have positive implications for better management of colorectal cancer patients in the post-resection setting.},
  keywords={Support vector machines;Sensitivity;Biological system modeling;Surgery;Predictive models;Cancer;Tumors;colorectal cancer;CEA;prognostication;machine learning},
  doi={10.1109/HEALTHCOM49281.2021.9398977},
  ISSN={},
  month={March},}@INPROCEEDINGS{11608460,
  author={Nusratullah, Shaikh and Anjankar, Ashish and Dhok, Archana},
  booktitle={2026 IEEE 1st International Conference on Intelligent Technologies for a Sustainable and Inclusive Future (ICITSIF)}, 
  title={Artificial Intelligence (AI) Using Atherogenic Index of Plasma (AIP)}, 
  year={2026},
  volume={},
  number={},
  pages={1254-1258},
  abstract={The Atherogenic Index of Plasma (AIP) is defined as the logarithmic ratio of triglycerides to high density lipoprotein cholesterol, has emerged as a novel biomarker reflecting atherogenic dyslipidemia, insulin resistance, oxidative stress and systemic inflammation. These pathophysiological mechanisms play a significant role in cancer progression and treatment response ,particularly in colorectal cancer patients undergoing chemotherapy .Recent advances in artificial intelligence (AI) and machine learning have enable the analysis of complex ,high-dimensional clinical and biochemical data, offering new opportunities for biomarker –driven precision oncology. This review explores the integration of AIP into AI-based predictive and prognostic frameworks, highlighting data acquisition, preprocessing, feature engineering and model development strategies.},
  keywords={Modeling;Artificial intelligence;Chemotherapy;Indexes;Indexing;Colorectal cancer;Printing;Lipidomics;Aluminum;Biomarkers;Atherogenic Index of Plasma;Artificial Intelligence;Machine Learning;Colorectal cancer;Chemotherapy;Prognostic Biomarker;Lipid metabolism;Explainable AI;Precision oncology},
  doi={10.1109/ICITSIF69060.2026.11608460},
  ISSN={},
  month={May},}@INPROCEEDINGS{11381829,
  author={Ahmad, Al Arian and Aman, Nakib},
  booktitle={2025 IEEE 2nd International Conference on Computing, Applications and Systems (COMPAS)}, 
  title={Improving Colorectal Cancer Detection: Leveraging EfficientNet-B0 and Explainable AI for High-Accuracy Classification}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Colorectal cancer (CRC) is one of the most serious and rapidly growing cancers, ranking among the leading causes of cancer-related deaths worldwide. It typically originates from polyps in the colon or rectum and can progress into malignancy over time. It needs early treatment, and recent advances in deep learning have shown great promise for the automation of the diagnosis. This paper presents an EfficientNet-B0-based deep learning framework with full incorporation of Explainable AI (XAI) techniques. The developed framework is trained on 11,340 CRC images and achieves a high accuracy of 99.95%, outperforming several state-of-the-art approaches. Incorporation of XAI methods such as Grad-CAM and LIME makes the framework produce interpretable decisions, making its predictions transparent and clinically trustworthy. The performance is validated using globally recognized metrics such as Precision, F1-Score and Recall, which all indicate the high credibility of the model. Grad-CAM visualizations are able to identify the significant regions in the images that have influenced the predictions, giving an idea of the concern areas for CRC detection. Not only is the model highly accurate, but it is also interpretable and easy to deploy, indicating its great potential for translation to real-world clinical practice. It could assist healthcare professionals in the identification and confirmation of CRC development and, thereby, enable timely and confident diagnosis. Such automated, explainable tools have the potential to be a mainstay of AI-powered healthcare diagnostics in the years to come.},
  keywords={Accuracy;Translation;Explainable AI;Colorectal cancer;Medical services;Robustness;Reproducibility of results;Real-time systems;Planning;Medical diagnostic imaging;Colorectal Cancer (CRC);Deep Learning;EfficientNet-B0;Explainable AI (XAI);Grad-CAM;Medical Image Classification},
  doi={10.1109/COMPAS67506.2025.11381829},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10731621,
  author={Zhou, Xueyou and Wang, Zunliang and Jiang, Qiuyang},
  booktitle={2024 8th International Conference on Biomedical Engineering and Applications (ICBEA)}, 
  title={Predictive Modeling for Stage II Colon Cancer Using Circulating Tumor DNA: A Nomogram and Machine Learning Approach}, 
  year={2024},
  volume={},
  number={},
  pages={157-162},
  abstract={Adjuvant chemotherapy is relatively common in high-risk stage II colon cancer patients, but there is a lack of uniform methods or specific molecular markers for identifying such patients. This paper presents a new model for predicting recurrence in this patient cohort, aiming to allow a subset of low-risk individuals to forego chemotherapy. The study, conducted from 2017 to 2020 at multiple oncology centers, selected 112 stage II colon cancer patients who met the inclusion criteria and had undergone curative surgery, with the recurrence-free survival (RFS) rate serving as the primary endpoint. In this paper, Kaplan-Meier method was used to calculate RFS, Cox proportional risk regression analysis was used for univariate and multivariate analyses to screen the risk factors, and R (R4.2.3) and the rms package were used to develop the nomogram model. A model was constructed based on machine learning algorithms, and the two were integrated into a hierarchical model. This model combines clinical pathological risk factors and circulating tumor DNA (ctDNA), effectively identifying high-risk stage II colon cancer patients, with an area under the receiver operating characteristic (ROC) curve of 0.84. Our method can provide auxiliary decision-making support for clinical physicians.},
  keywords={Radio frequency;Pathology;Chemotherapy;Biological system modeling;DNA;Colorectal cancer;Machine learning;Predictive models;Oncology;Tumors;Prediction model;Stage II colon cancer;Circulating tumor DNA},
  doi={10.1109/ICBEA62825.2024.00037},
  ISSN={},
  month={March},}@INPROCEEDINGS{10516180,
  author={J, Monica and S G, Arya and S, Naveen and B D, Parameshachari},
  booktitle={2024 International Conference on Distributed Computing and Optimization Techniques (ICDCOT)}, 
  title={A Comprehensive Study and Detection of Colon Cancer Cells Through Image Scaling for Medical Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The integration of neural networks in colon cancer detection signifies a significant change in medical diagnostics, specifically in dealing with the complexities of colorectal cancer. This disease requires early identification for successful intervention. This study investigates a novel approach that utilizes the capabilities of convolutional neural networks (CNNs), which are specifically designed for complex picture interpretation. CNNs are highly skilled at analyzing intricate medical imaging data from modalities like Computed Tomography (CT) scans and colonoscopies. They are particularly effective at catching subtle visual characteristics in the colon. The pivotal procedure entails the creation of extensive datasets that consist of carefully labeled images. These datasets serve as the fundamental foundation for training neural networks. By engaging in repeated learning, these networks develop the capacity to distinguish complex patterns and distinctive traits that are typical of both healthy and malignant tissues. It improves their capacity to detect possible signs of colon cancer with increased effectiveness and precision.},
  keywords={Training;Visualization;Computed tomography;Neural networks;Colonoscopy;Complexity theory;Medical diagnosis;Colon cancer;Computed Tomography;Convolutional Neural Network;Labeled images and Malignant tissues},
  doi={10.1109/ICDCOT61034.2024.10516180},
  ISSN={},
  month={March},}@INPROCEEDINGS{11645657,
  author={M, Rajalakshmi and Vindhya, A. Shri and Mathai, Anumol},
  booktitle={2026 4th International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Towards Interpretable Deep Learning for Colon Cancer Diagnosis in Healthcare System: A Comprehensive Review}, 
  year={2026},
  volume={},
  number={},
  pages={1948-1954},
  abstract={Colon cancer is a life-threatening type of cancer, with a survival rate that is too low. This type of cancer is difficult to diagnose at an early stage due to slow and hidden growth. Blood in stools, abdominal pain, and chronic diarrhoea are indicators of colon cancer. Colonoscopy is utilised to detect colon-rectal cancer and polyps, which are prone to human error. This paper reviews recent studies on detecting colon cancer with the integration of deep learning and machine learning in healthcare. Histopathological images are fed into Mobile-Net, Two Stage CNN, Compact CNN Models, and Modified VGG-CNN+COATI OPTIMIZATION algorithm to extract features of affected cells. The literature available currently focuses on obtaining accuracy, sensitivity, efficiency, balanced performance, and better prediction with the aid of deep architecture. However, the existing work demonstrates better performance; it lacks interpretability, transparency(black-box issue), architectural simplicity and real-time validation. This paper describes how Machine learning, Deep learning, and hybrid methods have evolved in diagnosing colorectal cancer. Currently, explainable AI has emerged to interpret and diagnose colorectal tumours in healthcare, which would be a solution for the black box issue that will build trust and support, and better decision making as a future scope.},
  keywords={Modeling;Colorectal cancer;Optimization;Accuracy;Convolutional neural networks;Machine learning;Deep learning;Printing;Aluminum;Cancer;Colon Tumour;Healthcare;Deep Learning;Machine Learning;Hybrid Learning;Optimisation Techniques},
  doi={10.1109/ICSCSS69635.2026.11645657},
  ISSN={},
  month={July},}@INPROCEEDINGS{11350373,
