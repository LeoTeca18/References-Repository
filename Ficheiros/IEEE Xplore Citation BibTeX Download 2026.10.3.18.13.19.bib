  month={Aug},}@INPROCEEDINGS{10347787,
  author={Yu, Ning and Deng, Fei and Lin, Yuxiang and Zhao, Lin},
  booktitle={2023 8th International Conference on Intelligent Informatics and Biomedical Sciences (ICIIBMS)}, 
  title={LIME-Explained Small-Scale Tabular Transformer Used for Improving the Classification Performance of Multi-Category Causes of Death in Colorectal Cancer}, 
  year={2023},
  volume={8},
  number={},
  pages={266-275},
  abstract={The timely identification and treatment of Colorectal cancer (CRC) are pivotal for enhancing patient prognosis. This paper presents a data-driven machine learning approach that aims to address the challenges in CRC prognosis. First an efficient feature selection method is used to address the problems posed by high and unbalanced data. A deep learning model based on the Transformer architecture is then used to process CRC small-scale tabular data. This model skillfully captures the inherent feature dependencies, leading to excellent performance in classification of causes of death in CRC patients. Additionally, the Local Interpretable Model-Agnostic Explanations (LIME) method is applied to interpret the model, providing explanations for both local and global level predictions. These elucidations promote our comprehension of the model's decision-making process and offer valuable insights for healthcare practitioners. The experimental results substantiate the validity and reliability of our methodology and demonstrate its potential extension to relevant prognostic diagnostic tasks and domains.},
  keywords={Deep learning;Medical services;Predictive models;Transformers;Feature extraction;Reliability;Prognostics and health management;Colorectal cancer;machine learning;feature selection;small-scale tabular Transformer;LIME},
  doi={10.1109/ICIIBMS60103.2023.10347787},
  ISSN={2189-8723},
  month={Nov},}@ARTICLE{9373895,
  author={Chi, Shengqiang and Tian, Yu and Wang, Feng and Wang, Yu and Chen, Ming and Li, Jingsong},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Deep Semisupervised Multitask Learning Model and Its Interpretability for Survival Analysis}, 
  year={2021},
  volume={25},
  number={8},
  pages={3185-3196},
  abstract={Survival analysis is a commonly used method in the medical field to analyze and predict the time of events. In medicine, this approach plays a key role in determining the course of treatment, developing new drugs, and improving hospital procedures. Most of the existing work in this area has addressed the problem by making strong assumptions about the underlying stochastic process. However, these assumptions are usually violated in the real-world data. This paper proposed a semisupervised multitask learning (SSMTL) method based on deep learning for survival analysis with or without competing risks. SSMTL transforms the survival analysis problem into a multitask learning problem that includes semisupervised learning and multipoint survival probability prediction. The distribution of survival times and the relationship between covariates and outcomes were modeled directly without any assumptions. Semisupervised loss and ranking loss are used to deal with censored data and the prior knowledge of the nonincreasing trend of the survival probability. Additionally, the importance of prognostic factors is determined, and the time-dependent and nonlinear effects of these factors on survival outcomes are visualized. The prediction performance of SSMTL is better than that of previous models in settings with or without competing risks, and the effects of predictors are successfully described. This study is of great significance for the exploration and application of deep learning methods involving medical structured data and provides an effective deep-learning-based method for survival analysis with complex-structured clinical data.},
  keywords={Analytical models;Deep learning;Neural networks;Data models;Task analysis;Hazards;Biological system modeling;Deep learning;model interpretability;multitask learning;semisupervised learning;survival analysis},
  doi={10.1109/JBHI.2021.3064696},
  ISSN={2168-2208},
  month={Aug},}@INPROCEEDINGS{11011403,
  author={Takkar, Sakshi and Rakhra, Manik},
  booktitle={2025 3rd International Conference on Advancement in Computation & Computer Technologies (InCACCT)}, 
  title={A Systematic Review of Deep Learning Techniques in Colon Cancer Screening}, 
  year={2025},
  volume={},
  number={},
  pages={382-387},
  abstract={Deep Learning is nowadays one of the powerful approaches of the Artificial Intelligence field in object detection and recognition. It also has gained reputation for improvement in the analysis of medical images. Early diagnosis and accuracy in prediction can be obtained by finding various normal and abnormal patterns in complex datasets by using different deep learning algorithms. Once deep learning models have undergone extensive training on enormous datasets, it can learn distinguishing between tissues that are either cancerous or not. Moreover, it improves precision in diagnosis and also enables better results in the outcomes of patients. This paper elaborates various deep learning architectures employed in investigating the state of the colon in diagnosing cancer. Deep learning algorithms which detect colon cancer help to identify various significant performance parameters to measure their effectiveness. The metrics include accuracy which helps to make the correct predictions, sensitivity metric to correctly identify the patients suffering from the disease and specificity metric to identify the people without the disease accurately. This paper will present reviews of different research papers that outline the overall framework. This paper will be beneficial for those researchers who are keen to know about different deep learning techniques for diagnosing the cancer in colon.},
  keywords={Deep learning;Training;Accuracy;Sensitivity;Colorectal cancer;Object detection;Medical services;Prediction algorithms;Medical diagnostic imaging;Systematic literature review;Colon Cancer;Dataset;Neural Networks;Explainable Artificial Intelligence;Machine Learning},
  doi={10.1109/InCACCT65424.2025.11011403},
  ISSN={},
  month={April},}@INPROCEEDINGS{11524042,
  author={Sharma, Mukesh and Garg, Vijay Kumar},
  booktitle={2026 International Conference on Intelligent Processing, Hardware, Electronics, and Radio Systems (CIPHER)}, 
  title={A Comprehensive Survey on Machine Learning and Deep Learning Approaches for Lung Disease Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent developments in artificial intelligence (AI), specifically machine learning (ML) and deep learning (DL), have had a major impact on the pulmonary disease detection, diagnosis, and prognosis. This survey offers a suitable overview of the state-of-the-art AI-based methods used in the lung disease research, but it is mainly focused on lung cancer. The research review is a systematic review of thirty new studies, differentiating approaches, data modeling, quantification of performance, and explainable methods. Based on the comparative analysis, it is clear that deep learning models and convolutional neural networks in particular are superior in imaging-based detection problems and provide high diagnostic accuracy, whereas ensemble-based and classical ML are more useful in structured clinical and longitudinal data. The analysis based on visualization also proves that the notable portion of the studies focuses on detection and diagnosis, and the prediction of the prognosis, estimation of risks, identification of biomarkers, and modeling of treatment outcomes are under-explored. Other aspects of explainable artificial intelligence (XAI) as SHAP and Grad-CAM are also not widely adopted, yet they are vital to clinical trust and interpretability. As these observations indicate, some of the main gaps in research are outlined in that there is a lack of multimodal data integration, no universal benchmark, no external validation, and difficulty in practical clinical implementation. Lastly, the paper will provide research directions in the future focusing on multimodal learning, federated AI models and privacy-preserving AI models along with standardized evaluation regimens to develop reliable, interpretable and clinically deployable AI solutions to lung disease management and detection.},
  keywords={Lungs;Modeling;Lung cancer;Machine learning;Machining;Printing;Artificial intelligence;Accuracy;Signal detection;Convolutional neural networks;Lung Cancer;Machine Learning;Deep Learning;Cross-Dataset Evaluation;CT scan;Clinical Data;Genomic Data},
  doi={10.1109/CIPHER70417.2026.11524042},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10989467,
  author={Tarawneh, Ahmad S.},
  booktitle={2025 4th International Conference on Computing and Information Technology (ICCIT)}, 
  title={Colon Cancer Prediction Using Machine Learning in Jordanian Patients: Preliminary Results}, 
  year={2025},
  volume={},
  number={},
  pages={283-287},
  abstract={Colon cancer remains a significant cause of cancer-related mortality globally, with early detection pivotal in enhancing patient survival rates. This study applies machine learning (ML) techniques to predict colon cancer using a dataset sourced from several hospitals across Jordan, featuring demographic data and complete blood count (CBC) test results. The methodology encompasses two primary phases: data preprocessing, which includes structuring the data, addressing missing values, and standardizing feature scales; and predictive analysis using various advanced ML models. These models were meticulously trained and validated within this region-specific context, employing a rigorous cross-validation strategy. The results, assessed through metrics such as precision, recall, and ROC curves, indicate that certain models, like the XGBoost classifier, achieved high performance, exemplified by an 80% precision and sensitivity rates, whereas others fell short in predictive effectiveness. Future efforts will focus on optimizing model parameters and further tuning to enhance the diagnostic capabilities of ML in the early detection of colon cancer.},
  keywords={Training;Hospitals;Computational modeling;Colorectal cancer;Predictive models;Data models;Predictive analytics;Tuning;Blood;Testing;Colon cancer;Machine learning;Classification;Predictive modeling},
