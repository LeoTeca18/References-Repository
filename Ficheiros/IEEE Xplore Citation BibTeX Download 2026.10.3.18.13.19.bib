  booktitle={2023 IEEE 12th International Conference on Communication Systems and Network Technologies (CSNT)}, 
  title={Predicting The Recurrence of Colorectal Cancer in Patients Using Ensemble Methods}, 
  year={2023},
  volume={},
  number={},
  pages={444-450},
  abstract={Among the top ten death-causing diseases in the world, cancer isconsidered to be one. There are about 100 different forms of cancer, and cancer prediction is critical to the advancement of data mining applications. The development of adequate methods for locating cancer instances will go a long way toward improving cancer patient therapy diagnosis. The term “cancer” refers to a group of disorders. All malignancies are caused by cells that continue to divide without stopping and spread to surrounding tissues. The ensemble model can be effectively used to prognosticate the recurrence of colorectal cancer in clinical patients. According to current data from Globacan India, over 27,000 cases were documented in the preceding year, with about 20,000 people dying. In this project, ensemble approaches are utilized to predict cancer recurrence. Basic classifier approaches such as SVM, and RF, as wellf as ensemble classifiers of bagging, were employed to construct classier models. According to the findings, the constructed models’ prediction performance was normally good. In terms of accuracy, ensemble models outperform when compared to Simple classifiers. In a model comparison, the ensemble voting technique outperformed all other models by a significant margin.},
  keywords={Support vector machines;Medical treatment;Predictive models;Data science;Prediction algorithms;Ensemble learning;Data mining;Colorectal Cancer;Ensemble methods},
  doi={10.1109/CSNT57126.2023.10134669},
  ISSN={2473-5655},
  month={April},}@INPROCEEDINGS{11167501,
  author={Dachawar, Madhavi and Tong, Vedant and Utrankar, Jayashri and Poornaprakash, S.},
  booktitle={2025 3rd International Conference on Sustainable Computing and Data Communication Systems (ICSCDS)}, 
  title={Tracing the Evolution of Artificial Intelligence and Machine Learning in Oncology: A Systematic Metadata Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1583-1593},
  abstract={The integration of work done by AI in oncology has turned out to be a transforming power that will revolutionize diagnosis, therapeutic decisions, and treatment optimization. The article represents an extended meta-analysis of 6,382 research papers related to AI applications in oncology, obtained from Google Scholar and arXiv from 2016 to 2024. The obtained analysis has underlined the main trends, breakthroughs, and challenges regarding the implementation of AI and machine learning technologies in oncology. The most important observations will include substantial improvement in AI diagnostics, predictive therapeutic success modeling, and personalized medical interventions. This work has also pointed out the rise of deep learning, natural language processing, and computer vision that promise to help improve the detection and prognosis of cancers and further aid the care for such patients. Again, the review points to the gaps in current limitations: heterogeneous data, ethical issues, and strong validating frameworks. It reflects a general view of AI's transforming face in oncology, thus offering an outlook for such technology in redefining care for cancer and improving care for a patient in a few years.},
  keywords={Systematics;Explainable AI;Reviews;Predictive models;Oncology;Cancer detection;Natural language processing;Prognostics and health management;Optimization;Cancer;Artificial Intelligence;Machine Learning;Explainable AI (XAI);Automated Cancer Detection;Data-Driven Oncology;Cancer Detection;Precision Oncology},
  doi={10.1109/ICSCDS65426.2025.11167501},
  ISSN={},
  month={Aug},}@ARTICLE{10769011,
  author={Yang, Xulin and Qiu, Hang},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Deep Gated Neural Network With Self-Attention Mechanism for Survival Analysis}, 
  year={2025},
  volume={29},
  number={4},
  pages={2945-2956},
  abstract={Survival analysis is commonly used to model the time distributions of the first occurrences of events of interest, and it has widespread medical applications. Many previous studies learned the relationship between risk and covariates by making strong assumptions such as proportional hazards. However, these assumptions limit the performance somewhat. Moreover, few studies consider the temporal patterns in feature effects. This paper proposed the novel framework of a deep gated neural network with self-attention mechanism (SA-DGNet) for survival analysis with single risk and competing risks. SA-DGNet transforms the problem of survival analysis into a time-series forecasting problem that treats time as an additional input covariate and estimates the probability mass function of the first hitting time. No assumptions are made about the distribution of survival times, and a deep gated neural network module is used to calculate the time-dependent and nonlinear effects of covariates on survival outcomes. Meanwhile, for enhanced data perception, a self-attention module comprising multi-scale time-aware self-attention and scaled dot-product self-attention is designed. The results of performance evaluation on multiple real-world datasets indicate that SA-DGNet significantly outperforms previous state-of-the-art methods. This study demonstrates the potential of gated neural networks and self-attention mechanisms in survival analysis, and it provides an effective method for risk prediction based on structured data.},
  keywords={Analytical models;Neural networks;Predictive models;Logic gates;Context modeling;Long short term memory;Hazards;Bioinformatics;Deep learning;Transformers;Deep learning;gated neural network;self-attention;survival analysis},
  doi={10.1109/JBHI.2024.3507109},
  ISSN={2168-2208},
  month={April},}@INPROCEEDINGS{11233743,
  author={Ramayanam, Suresh and Arunkumar, T. and Ponkumar, D. David Neels and PS, Saritha and Selvakani, R. and Arun, M. R.},
  booktitle={2025 IEEE International Conference on Compute, Control, Network & Photonics (ICCCNP)}, 
  title={Neuro-Fuzzy Machine Learning Model for Reliable Colorectal Cancer Screening}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Unity of the main sources of cancer connected death globally is colorectal cancer (CRC). Survival rates are considerably raised by early and precise diagnosis. In order to increase the reliability of CRC screening, we suggest a hybrid Neuro-Fuzzy Machine Learning (NFML) classical in this study. The Adaptive Neuro-Fuzzy Inference System (ANFIS) attends by way of the basis for the model, which blends the learning capabilities of artificial neural networks (ANNs) with fuzzy sense, which manages uncertainty. Clinical and biochemical data from publicly available CRC datasets were used to train the model. We contrasted NFML's performance with those of common classifiers, such as Deep Nervous Networks (DNN), Random Forests (RF), and Support Vector Machines (SVM). Our NFML model outperformed the benchmark models by up to 4.5% in terms of overall diagnostic accuracy, achieving high accuracy (93.4%), precision (92.1%), and F1-score (93.0%). The model can be used as a clinical decision support tool because it also provided improved interpretability through the extraction of fuzzy rules and reached a peak prediction accuracy of 95.4%. It shown potential for use in early CRC detection, particularly in low-resource healthcare situations, since it remained resilient across various data splits and noise levels. All things considered, the NFML model provides a trustworthy, understandable, and precise method for improving CRC screening and diagnosis.},
  keywords={Support vector machines;Fuzzy logic;Adaptation models;Accuracy;Adaptive systems;Biological system modeling;Colorectal cancer;Data models;Random forests;Noise level;Colorectal Cancer Detection;Neuro-Fuzzy System;Machine Learning;Adaptive Neuro Fuzzy Inference System (ANFIS);Clinical Decision Support;Medical Diagnosis;Hybrid Intelligence Model},
  doi={10.1109/ICCCNP63914.2025.11233743},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11539247,
  author={T, Deborah Mercy Bai and P, Getzial Anbu Mani and A, Sairam and Muthumarilakshmi, S and R, Geetha and Srivel, R},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={Random Forest-Based Modeling of Colorectal Cancer Risk from Lifestyle and Nutritional Factors}, 
  year={2026},
  volume={},
  number={},
  pages={607-612},
  abstract={Colorectal cancer (CRC) is a major cause of cancer-related death globally, affected by hereditary, lifestyle, and dietary factors. Precise risk forecasting is crucial for timely identification and prevention. This research utilizes a Random Forest (RF) model to forecast CRC risk, using the Colorectal Cancer Dietary and Lifestyle Dataset (CRC-DLD), which contains over 1,000 synthetic patient records including demographic, lifestyle, health, and dietary characteristics. The RF model was developed to categorize people as either high or low risk for CRC (binary: $\mathbf{1}=\mathbf{C R C}, \mathbf{0}=$ Non-CRC). The model attained an accuracy of 99.70 %, a precision of 99.88 %, a recall of 99.76 %, and an $F 1$-score of 99.82 %, indicating robust predictive efficacy. Feature significance analysis identified age, family history of CRC, body mass index, protein consumption, and sedentary behavior as the predominant risk variables. The findings indicate that RF modelling may proficiently encapsulate intricate interactions among lifestyle, dietary, and demographic factors for CRC risk evaluation. The research highlights the efficacy of machine learning methodologies in tailored dietary guidance and early CRC diagnosis, providing a powerful computational resource for public health investigations and preventative measures.},
  keywords={Modeling;Machine learning;Radio frequency;Printing;Conferences;Aging;Machining;Colorectal cancer;Internet of Things;Cancer;Colorectal Cancer;Random Forest;Machine Learning;Lifestyle Factors;Nutritional Intake;Risk Prediction},
  doi={10.1109/ICCSP68173.2026.11539247},
  ISSN={2836-1873},
  month={April},}@INPROCEEDINGS{10822422,
  author={Wang, Han and Li, Yunhe and Feng, Yannuo and Shen, Kexin and Lu, Chang and Xie, Zhongshi},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={DeepCRC: Precision Colorectal Cancer Diagnosis Using Deep Learning and Metagenomic Biomarkers}, 
  year={2024},
  volume={},
  number={},
  pages={1183-1190},
  abstract={Colorectal cancer (CRC) is one of the leading causes of cancer-related deaths globally, underscoring the critical need for early detection. Microbial biomarker detection offers significant advantages in revealing the physiological and pathological mechanisms of CRC, as well as in early screening. It provides not only deep insights into disease progression but also enables the possibility of non-invasive early diagnosis. The utilization of metagenomic shotgun sequencing (MGS) technology and the bioBakery workflow to analyze gut microbiome samples from six independent cohorts (n = 1291), including 645 CRC patients and 646 healthy controls (HC). Metagenomic analysis revealed a significant reduction in microbial diversity and identified 117 microbial species with altered abundance in CRC patients (p < 0.05). The DeepCRC model, incorporating key biomarkers and clinical metadata, achieved 97.70% accuracy and an AUC of 0.982 on an independent test set. SHAP analysis indicated that microbial species such as Ruminococcaceae unclassified SGB15260 and Clostridium leptum impact CRC significantly. These bacteria are associated with CRC through mechanisms involving inflammation and gut barrier dysfunction. The superior performance of the DeepCRC diagnostic model is expected to advance the development of non-invasive CRC screening methods. Source code is available at https://github.com/NENUBioCompute/DeepCRC.},
  keywords={Deep learning;Metagenomics;Analytical models;Sequential analysis;Accuracy;Biological system modeling;Source coding;Precision medicine;Colorectal cancer;Physiology;Colorectal Cancer;Metagenomic Shotgun Sequencing;Deep Learning;Microbiome Analysis;Metagenomic Biomarkers;Diagnostic Model;SHAP},
  doi={10.1109/BIBM62325.2024.10822422},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{11486104,
  author={Purushotham, N. and Avanija, J.},
  booktitle={2026 Contemporary Computing Innovations Conference (CCIC)}, 
  title={Explainable Deep Learning Techniques for Colon Cancer Diagnosis Using Histopathological Images}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Colon cancer has been one of the greatest causes of cancer related deaths in the global world and early and correct diagnosis through the use of histopathological images has been instrumental in saving lives of patients. Over the last few years, it has become evident that deep learning methods can be used to automate the process of colon cancer diagnosis with notable potential, but the model interpretability, generalization, and optimization issues remain at the level of constraints that do not allow the technique to be used on a large scale in clinical practice. The current survey includes a thorough and systematic overview of deep learning methods of colon cancer diagnosis based on histopathological images, with a special emphasis on the more recent Vision Transformer (ViT) architectures, explainable artificial intelligence (XAI) methods, selective features learning, and multi-objective optimization solutions. This paper initially introduces the traditional convolutional neural network-based models and their drawbacks in the ability to learn long-range relationships, as well as to make clinically interpretable explanations. It subsequently discusses the recent development in transformer-based architectures with greater capacity to capture global contextual relationships of high-level histopathological images. An elaborate taxonomy of explainability methods, such as gradient-based visualization tools and attention-based interpretability models, is introduced to determine the capability of transparency and trust to be incorporated into diagnostic models. In addition, the survey evaluates adaptive feature extraction methods and selective kernel learning which improve learning of multi-scale representations and which trade off opposing goals of accuracy, interpretability, and computational efficiency. Furthermore, frequently employed datasets, assessment protocols, and performance indicators are evaluated through a critical review to determine what benchmarking practices are in use and what are their drawbacks. By the help of comparative analysis, this survey can draw attention to the major research trends, performance trade-offs, and methodological gaps existing in the literature. Lastly, the open discussion of challenges and future research directions is presented, with a focus on the necessity to have standardized explainability evaluation, strong generalization across institutions, and diagnostic systems that can be clinically deployed and be trusted by patients. This survey is intended to be a systematic source of information to a researcher and practitioner who conducts studies and works on explainable and optimized deep learning models to diagnose colon cancer.},
  keywords={Filtering;Feedback;Filters;Circuits;LoRa;Protocols;Communication systems;HTTP;Data communication;Local area networks;Vision Transformers;Colon Cancer Diagnosis;Histopathological Image Analysis;Explainable Artificial Intelligence;Multi-Objective Optimization},
  doi={10.1109/CCIC68129.2026.11486104},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10230665,
  author={Saber, Ralph and Henault, David and Rebolledo, Rolando and Turcotte, Simon and Kadoury, Samuel},
  booktitle={2023 IEEE 20th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Ensemble Tabnet Predicting a T-Cell/MHC-I-Based Immune Profile Biomarker for Colorectal Liver Metastases from CT Images}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Colorectal cancer liver metastases (CLM) are the most common type of distant metastases originating from the abdomen and are characterized by a high recurrence rate after curative resection. It has been previously reported that CLM presenting a low cluster of differentiation 3 (CD3) positive T-cell infiltration density concurrent with a high major histocompatibility complex class I (MHC-I) expression were associated with poor clinical outcomes. In this study, we attempt to noninvasively predict whether a CLM exhibits the CD3LowMHCHigh immunological profile using preoperative CT images. To this end, we propose an ensemble network combining multiple Attentive Interpre table Tabular learning (TabNet) models, trained using CT-derived radiomic features. A total of 160 CLM were included in this study and randomly divided between a training set (n=130) and a hold-out test set (n=30). The proposed model yielded good prediction performance on the test set with an accuracy of 70.0% [95% confidence interval 53.6%-86.4%] and an area under the curve of 69.4% [52.9%-85.9%]. It also outperformed other off-the-shelf machine learning models. We finally demonstrated that the predicted immune profile was associated with a shorter disease-specific survival (p = .023) and time-to-recurrence (p = .020), showing the value of assessing the immune response.},
  keywords={Training;Computed tomography;Biological system modeling;Liver;Machine learning;Feature extraction;Immune system;Colorectal cancer liver metastases;noninvasive prognostic biomarker;immune profiling;attentive interpretable tabular learning;ensemble learning},
  doi={10.1109/ISBI53787.2023.10230665},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{10176535,
  author={Kadian, Vanishka and Singh, Arushi and Sharma, Kapil},
  booktitle={2023 Third International Conference on Secure Cyber Computing and Communication (ICSCCC)}, 
  title={A Robust Colon Cancer Detection Model Using Deep- Learning}, 
  year={2023},
  volume={},
  number={},
  pages={665-670},
  abstract={Colon cancer is the third most common cancer, with a high mortality rate and a high pathological need for early and accurate diagnosis. Histopathology is a golden standard tool for diagnosing almost all types of cancer, including colon cancer. It can be enhanced using deep learning techniques if the key challenges, namely, clean data annotation and inter-observer variability, are addressed. This highlights a need for a noise-robust algorithm with computational feasibility to work on real-world clinical data. In this paper, the experiment uses different deep learning models- ResNet-34, XCiT, SqueezeNet, MobileNet-individually integrated with a data cleaning architecture in an attempt to (1) achieve unmatched accuracy, (2) draw a comparison amongst the performance of these models and (3) point to the best model as a solution to the given problem. MobileNet outperforms all other models as the backbone for the algorithm, achieving the highest accuracy (84.39%), thus boosting the algorithm performance on the Chaovang dataset.},
  keywords={Deep learning;Analytical models;Computational modeling;Computer architecture;Cancer detection;Data models;Colon;Image Classification;Noise handling;Deep-learning;Colon cancer},
  doi={10.1109/ICSCCC58608.2023.10176535},
  ISSN={},
  month={May},}@INPROCEEDINGS{11649441,
  author={Bhattacharjee, Aparna and Roy, Sudipta and Singh, Lalit Kumar},
  booktitle={2026 IEEE Guwahati Subsection Conference (GCON)}, 
  title={Radiomics and Deep Learning for IoMT-Integrated Medical Imaging: A Review Toward Context-Aware Decision Support}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The Internet of Medical Things (IoMT) is transforming patient monitoring by integrating imaging and multi-modal fusion into unified radiomics pipelines. Furthermore, this review introduces a unified analytical framework for Internet of Medical Things, integrated radiomics pipelines and a parallel assessment of new deep learning and machine learning techniques across several imaging modalities. Key challenges include scanner and protocol variations, manual segmentation, limited data diversity, minimal cross-vendor validation, and opaque modeling. We highlight recent advances in radiomics-guided machine learning, deep learning architectures, multimodal integration, and improved image-based diagnostics.},
  keywords={Modeling;Radiomics;Printing;Deep learning;Machine learning;Magnetic resonance imaging;Accuracy;Diseases;Tumors;Machining;Internet of Medical Things;Artificial Intelligence;Machine Learning;Deep Learning;Healthcare 5.0},
  doi={10.1109/GCON69192.2026.11649441},
  ISSN={},
  month={June},}@INPROCEEDINGS{9630698,
  author={Hsu, Te-Cheng and Lin, Che},
  booktitle={2021 43rd Annual International Conference of the IEEE Engineering in Medicine & Biology Society (EMBC)}, 
  title={Training with Small Medical Data: Robust Bayesian Neural Networks for Colon Cancer Overall Survival Prediction}, 
  year={2021},
  volume={},
  number={},
  pages={2030-2033},
  abstract={Fast and accurate cancer prognosis stratification models are essential for treatment designs. Large labeled patient data can power advanced deep learning models to obtain precise predictions. However, since fully labeled patient data are hard to acquire in practical scenarios, deep models are prone to make non-robust predictions biased toward data partition and model hyper-parameter selection. Given a small training set, we applied the systems biology feature selector in our previous study to avoid over-fitting and select 18 prognostic biomarkers. Combined with three other clinical features, we trained Bayesian binary classifiers to predict the 5-year overall survival (OS) of colon cancer patients in this study. Results showed that Bayesian models could provide better and more robust predictions compared to their non-Bayesian counterparts. Specifically, in terms of the area under the receiver operating characteristic curve (AUC), macro F1-score (maF1), and concordance index (CI), we found that the Bayesian bimodal neural network (late fusion) classifier (B-Bimodal) achieved the best results (AUC: 0.8083 ± 0.0736; maF1: 0.7300 ± 0.0659; CI: 0.7238 ± 0.0440). The single modal Bayesian neural network classifier (B-Concat) fed with concatenated patient data (early fusion) achieved slightly worse but more robust performance in terms of AUC and CI (AUC: 0.7105 ± 0.0692; maF1: 0.7156 ± 0.0690; CI: 0.6627 ± 0.0558). Such robustness is essential to training learning models with small medical data.},
  keywords={Training;Biological system modeling;Systems biology;Receivers;Predictive models;Data models;Robustness},
  doi={10.1109/EMBC46164.2021.9630698},
  ISSN={2694-0604},
  month={Nov},}@INPROCEEDINGS{10571894,
  author={Olatunji, Sunday O. and Aleissa, Shahd and Alakkas, Maryam and Albugeaey, Zainab and Alshelaly, Hneen and Alzubaidi, Thuraya and Ahmed, Mohammed Imran Basheer and Farooqui, Mehwash},
  booktitle={2024 Seventh International Women in Data Science Conference at Prince Sultan University (WiDS PSU)}, 
  title={Preemptive Diagnosis of Colorectal Cancer Using Computational Intelligence Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={162-167},
  abstract={One of the most common cancers in the world is colorectal cancer. Due to this increasing global concern, the focus of this study was to enhance the predictive power of Machine Learning (ML) techniques for making preemptive diagnoses of colorectal cancer. This paper uses an online dataset to develop models for colorectal cancer and employs three ensemble ML algorithms, Histogram-based Gradient Boosting (HGB), Adaptive Boosting (AdaBoost), and Extra Trees (ET). The dataset comprised 115 instances, each with 11 features, after it underwent rigorous pre- processing including, imputing null values and one-hot encoding, followed by the utilization of the Synthetic Minority Over-sampling Technique accompanied by Edited Nearest Neighbors (SMOTE- ENN). Another key aspect of this study is the optimization of these models, achieved using GridSearchCV coupled with 5-fold-cross validation to identify the values of the most effective hyperparameters. A notable breakthrough is the enhanced performance of the HGB and Adaboost models in comparison with previous studies, as both models achieved a perfect 100% accuracy, precision, recall, and F1 score higher than previous studies where the F1 was about 88%. This outcome demonstrates the efficiency of using computational intelligence, specifically ML, in revolutionizing the preemptive diagnosis of colorectal cancer, offering a promising platform for future research and clinical application.},
  keywords={Adaptation models;Machine learning algorithms;Computational modeling;Null value;Data science;Boosting;Prediction algorithms;Colorectal Cancer;Machine Learning;Python;SMOTE-ENN;Histogram-based Gradient Boosting (HGB);Adaptive Boosting (AdaBoost)},
  doi={10.1109/WiDS-PSU61003.2024.00043},
  ISSN={},
  month={March},}@ARTICLE{11131175,
  author={Zhang, Haojie and Tian, Fuze and Tan, Yang and Shen, Lin and Li, Enze and Ma, Jiedong and Liu, Jingyu and Qian, Kun and Li, Jing and Hu, Bin and Yamamoto, Yoshiharu and Schuller, Björn W.},
  journal={IEEE Internet of Things Journal}, 
  title={Toward Practical Colorectal Cancer Diagnosis: A Bowel-Sound-Based System With Portable Sensor and On-Board Lightweight AI Model}, 
  year={2025},
  volume={12},
  number={21},
  pages={45722-45736},
  abstract={colorectal cancer (CRC) is one of the leading causes of cancer-related deaths worldwide, and early screening plays a crucial role in improving patient outcomes. In this study, we present a novel AI-assisted CRC diagnostic system using bowel sounds (BS) signals. We first develop two portable BS acquisition devices with distinct form factors for high-fidelity signal capture in both clinical and home-care scenarios. A total of 221 recordings were collected under expert-guided protocol, with 144 CRC recordings and 59 Non-CRC healthy controls using the developed device. To enable low-resource deployment, we design a lightweight deep learning model optimized for real-time, on-board inference. The model incorporates multiple training strategies, including transfer learning on a large-scale public BS dataset, self-supervised temporal feature learning, and a hybrid semi- and weakly-supervised approach that leverages both unlabeled and real-noise data. Furthermore, a sound event detection (SED) attention mechanism and iterative consistency learning are introduced to enhance the model’s sensitivity to BS activity. The proposed model comprises only 264.7K parameters and 253.2M floating-point operations (FLOPs), requiring 1.57MB of random-access memory (RAM) and 1.03MB of flash memory (FLASH) when deployed on microcontroller. It performs inference in approximately 3.4 s with low power consumption, making it well-suited for low-resource environments. Despite its compact design, the model achieves 93.06% classification accuracy, 96.46% sensitivity, and 86.99% specificity for binary-classes in CRC diagnosis. These results demonstrate the system’s potential for accessible and cost-effective CRC screening in community, home, and rural healthcare scenarios.},
  keywords={Artificial intelligence;Training;Monitoring;Medical services;Data models;Recording;Internet of Things;Gastrointestinal tract;Deep learning;Colorectal cancer;Artificial intelligence;bowel sound (BS);colorectal cancer (CRC) diagnosis;Internet of Things;on-board real-time model},
  doi={10.1109/JIOT.2025.3600644},
  ISSN={2327-4662},
  month={Nov},}@INPROCEEDINGS{11177121,
  author={Tran, Phuong Lam and Tang, Yun and Hsu, Justin BoKai and Lee, Tzong-Yi},
  booktitle={2025 IEEE Conference on Computational Intelligence in Bioinformatics and Computational Biology (CIBCB)}, 
  title={Integrative Multi-Omics Prognostic Modeling of Glioma Recurrence Using Variational Autoencoder and Similarity Network Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Gliomas represent the most prevalent form of malignant brain tumors, with glioblastoma (GBM) classified as the most aggressive subtype and lower-grade gliomas (LGGs) showing a high recurrence rate despite better survival outcomes. Traditional prognostic methods rely on clinical and molecular markers, yet they often fail to leverage the predictive potential of integrative multiomics data. Hence, early and accurate identification of glioma recurrence is critical for optimizing treatment strategies and improving patient outcomes. To address this challenge, we developed a deep learning-based approach that integrates multiomics data with clinical features to enhance recurrence risk stratification. Multiomics data, including mRNA, miRNA, DNA methylation, and CNV profiles from 512 LGG and 350 GBM patients in The Cancer Genome Atlas (TCGA), were processed using the variational autoencoder for nonlinear feature extraction, followed by similarity network fusion to capture cross-omics relationships. Recurrence-guided feature selection identified a robust biomarker panel that effectively categorized patients into high-and low-risk recurrence groups, with Kaplan-Meier survival analysis demonstrating a notable significant difference with p-value less than 0.001. Integration of clinical factors (age, tumor grade, IDH mutation status) further improved predictive performance, yielding a C-index of 0.695 (p < 2e-16) for LGG and 0.619 (p = 3.346e-11) for GBM. Together, these findings establish a multiomics-based predictive model that enables refined glioma recurrence risk assessment, offering personalized treatment strategies for LGG and GBM patients.},
  keywords={Accuracy;Sensitivity;Computational modeling;Biological system modeling;Autoencoders;Predictive models;Feature extraction;Data models;Prognostics and health management;Bioinformatics;glioblastoma;lower-grade glioma;multiomics;deep learning;machine learning;autoencoder;similarity network fusion;prognosis;recurrence prediction},
  doi={10.1109/CIBCB66090.2025.11177121},
  ISSN={2994-9408},
  month={Aug},}@INPROCEEDINGS{11013450,
  author={Wahed, Salma Abdel and Wahed, Mutaz Abdel and Alzoubi, Abed Elkareem},
  booktitle={2025 1st International Conference on Computational Intelligence Approaches and Applications (ICCIAA)}, 
  title={Optimizing Colorectal Cancer Treatment with Unconventional Therapies: A Data-Driven AI Approach for Comprehensive Image-Based Evaluation and Treatment Ranking}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={By 2040, colorectal cancer (CRC) is expected to have increased incidence and fatality rates, making it a serious worldwide health concern. While successful, conventional therapies like chemotherapy and surgery can have severe side effects, which is why non-conventional therapies like photodynamic therapy, hyperthermia, and high-dose vitamin C are becoming more and more popular. Through image-based analysis of pre- and post-treatment data, this study uses artificial intelligence (AI) to evaluate the efficacy of these alternative treatments. AI assessed tumor size, shape, and biomarkers using imaging datasets (CT, MRI, and Colonoscopy) and a deep learning model. The model demonstrated strong performance with an accuracy of 0.92, precision of 0.90, recall of 0.88, and an F1 score of 0.89. These metrics indicate the model's robustness in accurately identifying and quantifying tumor features, thereby providing valuable insights into treatment responses. Our findings suggest that AI-driven analysis can significantly enhance the evaluation and personalization of colorectal cancer therapies.},
  keywords={Shape;Biological system modeling;Medical treatment;Surgery;Colorectal cancer;Robustness;Safety;Artificial intelligence;Prognostics and health management;Tumors;colorectal cancer;non-conventional therapy;AI;Tumor},
  doi={10.1109/ICCIAA65327.2025.11013450},
  ISSN={},
  month={April},}@INPROCEEDINGS{9669445,
  author={Lv, Zhilong and Lin, Yuexiao and Yan, Rui and Yang, Zhenghe and Wang, Ying and Zhang, Fa},
  booktitle={2021 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={PG-TFNet: Transformer-based Fusion Network Integrating Pathological Images and Genomic Data for Cancer Survival Analysis}, 
  year={2021},
  volume={},
  number={},
  pages={491-496},
  abstract={Survival analysis is crucial to the evaluation of cancer treatment options and deep learning-based methods integrating pathological images and genomic data have been used for prognosis prediction. However, the most methods are based on the analysis of pathological image patches, thus ignoring the morphological structure information at larger field-of-view and intrinsic relationships between patches. Meanwhile, the existing models fail to exploit the powerful representation learning capabilities of the neural networks for effective multimodal feature fusion of pathological images and genomic data. In this paper, we propose a novel transformer-based fusion network integrating pathological images and genomic data (PGTFNet) for cancer survival analysis. Specifically, we present a transformer-based feature fusion module for multi-scale pathological slides to fully exploit the intra-modality relationships between image patches at various fields of view. Moreover, in order to make effective inter-modality feature fusion of pathological images and genomic data, we introduce a cross-attention transformer module that can exchange feature representations of different modalities between two transformers branches. The PG-TFNet is performed on the colorectal cancer dataset from the Cancer Genome Atlas (TCGA), which contains paired whole-slide images and genomic data with ground truth survival data. The experimental results from a 10-fold cross validation demonstrate that the proposed PG-TFNet facilitates the prognosis prediction of colorectal cancer and shows superiority over the existing methods.},
  keywords={Representation learning;Learning systems;Pathology;Neural networks;Genomics;Transformers;Data models;Survival Analysis;Pathological Images;Genomic Data;Multimodal Learning;Transformer},
  doi={10.1109/BIBM52615.2021.9669445},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11608145,
  author={Jawad, Duha Husein Mohamed and Ahmed, Maha Zuhair and Aljawad, Mohammed F. and Ibrahim, Sajjad Ghalib and Shahtool, Kazem Abd and Farhan, Marwa K. and Ibrahim, Alhasan Salih and Ahmed, Hadeel Hossam El-Din and Hassan, Diaa Fawzi},
  booktitle={2026 2nd International Symposium on AI-Driven Engineering Systems (ISADES)}, 
  title={MLA-Net: A Multimodal Machine Learning Framework for Early Cancer Detection, Subtype Classification, and Personalized Oncology}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Cancer remains one of the leading causes of death worldwide, with early detection playing a critical role in improving patient survival rates. Conventional diagnostic approaches often face limitations in speed, scalability, and consistency, creating growing interest in artificial intelligence–based cancer analysis systems. This paper presents a comprehensive review of machine learning applications in cancer detection, classification, prognosis, and personalized treatment, and introduces the proposed MLA-Net framework. The framework integrates ResNet-50 for histopathological image analysis, XGBoost for genomic feature classification, and Random Forest for clinical data modeling within a unified multimodal architecture. The proposed system is evaluated on large-scale public cancer datasets and demonstrates high predictive performance across multiple cancer types. Experimental results show that combining imaging, genomic, and clinical information significantly improves diagnostic accuracy and risk assessment compared to single-modality approaches. The study highlights the effectiveness of multimodal machine learning for precision oncology and identifies key future research directions, including federated medical learning, explainable AI, causal treatment modeling, and foundation model adaptation for healthcare applications. The proposed framework provides a scalable and interpretable solution for next-generation cancer diagnostics and personalized medicine. This study is structured as a hybrid empirical and review contribution: it conducts a systematic survey of 48 primary ML studies and reports experimental evaluation of MLA-Net on publicly available TCGA and SEER datasets.},
  keywords={Cancer;Modeling;Tumors;Machine learning;Printing;Training;Streams;Artificial intelligence;Convolutional neural networks;Lungs;Cancer Detection;Machine Learning;Deep Learning;Precision Oncology;Multimodal Learning;XGBoost;Explainable AI;Medical AI},
  doi={10.1109/ISADES69945.2026.11608145},
