  booktitle={2023 IEEE International Conference on Advances in Data-Driven Analytics And Intelligent Systems (ADACIS)}, 
  title={A Machine Learning Model for Survival Prediction in Secondary Liver Cancer}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Survival prediction in the context of secondary liver cancer represents a significant challenge within the field of oncology, yet it is an area that has received limited attention. To address this gap, our paper introduces an innovative approach that harnesses the power of machine learning to enhance the accuracy of survival predictions. Our work leverages a comprehensive dataset that encompasses a wide array of patient information, pre-treatment data, and essential clinical variables. A meticulous process of data preprocessing, along with the application of advanced techniques, ensures that this data is optimally prepared for in-depth analysis. Through the application of cutting-edge machine learning methodologies, our predictive model adeptly stratifies patients into two distinct categories: those who have 'Survived' and those who have unfortunately 'Deceased.' Our model's efficacy and precision are underscored by rigorous testing, suggesting the potential to significantly improve the decision-making process regarding treatments and, ultimately, patient outcomes.},
  keywords={Liver cancer;Analytical models;Machine learning;Predictive models;Reliability;Biomedical imaging;Testing;Machine Learning;Cancer Survival Prediction;Secondary liver cancer;random forest;KNN;imputation},
  doi={10.1109/ADACIS59737.2023.10424018},
  ISSN={},
  month={Nov},}@ARTICLE{11600501,
  author={Liu, Yaoyang and Zhang, Feng and Chen, Hongda and Chen, Kuangyu and Zhang, Yuhan and Luo, Chenyu and Luo, Jiahui and Li, Na and Dai, Min and Zhai, Jidong and Du, Xiaoyong},
  journal={Big Data Mining and Analytics}, 
  title={Multi-Layer Stacking Ensemble Learning Framework Utilizing Gut Microbiota Data for Colorectal Cancer Classification}, 
  year={2026},
  volume={9},
  number={4},
  pages={919-938},
  abstract={The gut microbiota has been increasingly recognized as a promising non-invasive biomarker source for Colorectal Cancer (CRC) detection. In this study, we develop a multi-layer stacking ensemble learning framework that integrates multiple machine learning models to improve the classification accuracy of CRC based on gut microbiota profiles. Our framework is trained using publicly available microbiome datasets comprising 1129 samples from diverse geographical regions (Europe, America, and Asia), and independently evaluated on an external validation cohort collected from Peking Union Medical College Hospital (PUMCH) in China. Based on our experiments, feature extraction of gut microbiota at the genus and species levels is found to achieve the best performance. The framework integrates multiple base classifiers—including Light Gradient Boosting Machine (LightGBM), eXtreme Gradient Boosting (XGBoost), Random Forests (RF), and Support Vector Machines (SVM)—combined through a weighting layer to optimize final classifications. Analysis of the feature importance in the trained model reveals several microbial populations previously reported to be associated with CRC, such as Gemella morbillorum and Fusobacterium nucleatum. These findings support the microbiological interpretability of our proposed framework. Experimental results show that our ensemble model achieves an Area Under the Receiver Operating Characteristic Curve (namely ROC_AUC) of 77.04% when validated on a real-world clinical dataset from Peking Union Medical College Hospital, surpassing existing microbiome-based CRC classification approaches.},
  keywords={Machine learning;Modeling;Printing;Microbiome;Colorectal cancer;Machining;Educational institutions;Training;Accuracy;Stacking;machine learning;Colorectal Cancer (CRC);classification modeling;human gut microbiota},
  doi={10.26599/BDMA.2025.9020088},
  ISSN={2097-406X},
  month={August},}@INPROCEEDINGS{11381817,
  author={Hussain, Mohammed Ibrahim and Rahman, Kawsher and Mamun, Mohammad and Azad, Mir Mohammad and Chowdhury, Safiul Haque and Hossain, Muhammad Minoar},
  booktitle={2025 IEEE 2nd International Conference on Computing, Applications and Systems (COMPAS)}, 
  title={Explainable AI-Driven Tree-Selection Stacking Random Forest with Hybrid Feature Synthesis for Lung Cancer Survival Time Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurately predicting lung cancer patient survival duration is crucial for medical research and informed clinical decision-making. This study presents a comprehensive regression framework introducing a novel methodology called Tree Selection-based Stacking Random Forest (TSRF), specifically developed to improve Lung Cancer survival time prediction using advanced machine learning (ML) and explainable AI techniques. To enhance model learning capability, we designed Hybrid Deep Feature Synthesis (HDFS), which combines traditional clinical variables with deep-learned representations to capture complex relationships and latent patterns within the data. This integrated feature space significantly strengthens predictive performance. We evaluated five state-of-the-art ML regressors: Random Forest Regressor (RFR), Extreme Gradient Boosting Regressor (XGBR), Gradient Boosting Decision Trees Regressor (GBDTR), Light Gradient Boosting Machine Regressor (LGBMR), and our proposed TSRF Regressor (TSRFR). Among these, TSRFR achieved the best performance, attaining the highest R2 score of 0.91 and the lowest Mean Squared Error (MSE) and Mean Absolute Error (MAE), demonstrating superior robustness and predictive accuracy for lung cancer survival regression. To ensure the reliability and generalizability of the results, we applied ten-fold validation and reported confidence intervals and standard deviations for all metrics. Additionally, advanced Explainable AI (XAI) methods, namely SHAP and LIME, were employed to interpret model predictions and identify the most influential clinical features, thereby improving transparency and clinical trust. This research introduces a high-performing, interpretable, and clinically relevant solution for predicting lung cancer survival time. The proposed TSRFR, supported by hybrid feature synthesis and explainability, shows strong potential to assist healthcare professionals in making precise and informed treatment decisions.},
  keywords={Explainable AI;Trees (botanical);Stacking;Lung cancer;Predictive models;Boosting;Robustness;Regression tree analysis;Random forests;Standards;Survival Time Prediction;Hybrid Feature Synthesis;Stacking Ensemble Learning;Tree Selection-Based Random Forest;Explainable AI},
  doi={10.1109/COMPAS67506.2025.11381817},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11134865,
  author={Aluvalu, Rajanikanth and Srinadhreddy, Nukamreddy and Patil, Anitha and V, Uma Maheswari and Mohan, Bonthala Vamsee and K., Sudheer Reddy},
  booktitle={2025 6th International Conference on Data Intelligence and Cognitive Informatics (ICDICI)}, 
  title={Integrated RAG-VGGNet and GRNN for Colon Cancer Detection From Images and Metadata}, 
  year={2025},
  volume={},
  number={},
  pages={358-365},
  abstract={Robust diagnostic tools are required to allow early besides precise diagnosis of colorectal and colon cancers, which are among the most common categories of cancer globally. Using a Retrieval-Augmented Generation (RAG) unit, this work suggests a new multimodal classification model that combines histopathology image data with clinical textual metadata. The CRC-VAL-HE-7K besides LC25000 datasets are used for imagebased analysis, while TCGA-COAD/READ database is queried for textual clinical data, which includes metadata such tumour stage, diagnosis, patient demographics, and survival statistics. Image preparation steps include histogram equalisation, CLAHE for contrast enhancement, and noise filtering (mean and Gaussian filters). Using a Text based Fully Convolutional Neural (TextFCN) network, to can filter both articles and images. In contrast to textual classification, which makes use of both Text-CNN and Gated Recurrent Neural Network (GRNN) models, image classification makes use of a VGGNet. After integrating multimodal representations, feature fusion technique uses a dynamically updated knowledge base for retrieval-based validation. Suggested RAGbased model outperforms more conventional methods, according on results of performance evaluation. In comparison to other approaches it obtains a higher accuracy ($\mathbf{9 6. 6 5 \%}$), precision (96.40 %), recall (96.25 %), and F1-score (96.32 %).},
  keywords={Histograms;Accuracy;Recurrent neural networks;Retrieval augmented generation;Knowledge based systems;Colorectal cancer;Metadata;Logic gates;Feature extraction;Transformers;Colorectal Cancer;Colon Cancer;Multimodal Learning;Retrieval-Augmented Generation Module;Gated Recurrent Neural Network},
  doi={10.1109/ICDICI66477.2025.11134865},
  ISSN={},
  month={July},}@INPROCEEDINGS{11565036,
  author={Shilpa and Shrinidhi and Shubharaksha and Srajani and Kamath, Shwetha},
  booktitle={2026 International Conference on Innovations in Computational Intelligence (ICICI)}, 
  title={A Deep Learning Framework Integrating Histopathological and CT Scan Features for Enhanced Diagnostic Performance}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Currently, hospitals have incorporated automated disease detection tools that analyze medical images. These devices helped medical professionals identify diseases early and take preventive measures before they turn into incurable conditions. One of the major causes of death due to cancer is colorectal cancer. The patient's recovery will be much better if the cancer is located at its primary or early stage. This diagnostic method is still based on the analysis of the CT scan and the histopathological images by the doctors, which can not only be very time-consuming but also prone to errors. Convolutional Neural Networks (CNNs), a recent breakthrough technique in the area of deep learning (DL), have greatly facilitated the task of medical image classification and feature extraction. This paper presents a deep learning-based diagnosis system capable of identifying colorectal cancer from CT and histopathology images. Separate CNN models are utilized to automatically learn detailed features from radiological images and microscopic tissue samples. To enhance interpretability and model transparency, the models also incorporated Gradient Weighted Class Activation Mapping (Grad-CAM), which highlights the areas that influenced the classification decisions. This work aligns with SDG 3: Good Health and Well-being by improving early cancer detection using AI.},
  keywords={Modeling;Colorectal cancer;Computed tomography;Accuracy;Convolutional neural networks;Training;Deep learning;Histopathology;Cams;Computer aided manufacturing;Colorectal Cancer;Deep Learning;Convolutional Neural Network (CNN);CT Scan;Histopathology Image;Explainable AI;Grad-Cam},
  doi={10.1109/ICICI68867.2026.11565036},
  ISSN={},
  month={April},}@INPROCEEDINGS{11399196,
  author={Dubey, Brahmanand and Dwibedi, Anubhav and Ghosh, Subhayu and Jana, Nanda Dulal},
  booktitle={2025 IEEE 9th International Conference on Information and Communication Technology (CICT)}, 
  title={Energy-Guided Gabor Texture Descriptors for Fusion-Based Multimodal Colon Cancer Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Early and accurate detection of colon cancer is critical for clinical decision-making and patient survival. Existing deep learning approaches often require large annotated datasets and offer limited interpretability, restricting their clinical adoption. This work proposes an interpretable, texture-driven framework for multimodal colon cancer detection using multi-orientation Gabor filters. Each modality is processed to extract statistical measures—energy, variance, standard deviation, and entropy—across six orientations, forming compact 24-dimensional descriptors. These descriptors are fused at the feature level via concatenation, yielding a unified multimodal representation. An energy-guided criterion selects the most discriminative orientation, enhancing robustness to noise and preserving structural detail. The fused features are analyzed through unsupervised clustering, where Gaussian Mixture Models (GMM) outperform K-Means in modeling irregular tumor clusters. Eight supervised classifiers are then evaluated, with performance measured using accuracy, precision, recall, F1-score, AUC-ROC, and log loss. A cumulative scoring scheme across these metrics identifies XGBoost as the most reliable model. On a dataset of 4500 augmented images, the proposed framework achieves superior classification results, demonstrating that energy-guided Gabor descriptors, combined with feature-level fusion, provide an efficient and interpretable solution for colon cancer detection in data-constrained clinical environments. The source code is publicly available at: https://shorturl.at/xBqXb.},
  keywords={Deep learning;Accuracy;Source coding;Colorectal cancer;Feature extraction;Loss measurement;Robustness;Gabor filters;Standards;Tumors;Gabor filters;Multimodal medical imaging;Feature fusion;Texture feature analysis;Colon cancer detection},
  doi={10.1109/CICT67193.2025.11399196},
  ISSN={},
  month={Dec},}@ARTICLE{10168911,
  author={Vania, Malinda and Tama, Bayu Adhi and Maulahela, Hasan and Lim, Sunghoon},
  journal={IEEE Access}, 
  title={Recent Advances in Applying Machine Learning and Deep Learning to Detect Upper Gastrointestinal Tract Lesions}, 
  year={2023},
  volume={11},
  number={},
  pages={66544-66567},
  abstract={The clinical application of a real-time artificial intelligence (AI) image processing system to diagnose upper gastrointestinal (GI) malignancies remains an experimental research and engineering problem. Understanding these commonly used technical techniques is required to appreciate the scientific quality and novelty of AI studies. Clinicians frequently lack this technical background, and AI experts may be unaware of such clinical relevance and implications in daily practice. As a result, there is a growing need for a multidisciplinary, international assessment of how to conduct high-quality AI research in upper GI malignancy detection. This research will help endoscopists build approaches or models to increase diagnosis accuracy for upper GI malignancies despite variances in experience, education, personnel, and resources, as it offers real-time and retrospective chances to improve upper GI malignancy diagnosis and screening. This comprehensive review sheds light on potential enhancements to computer-aided diagnostic (CAD) systems for GI endoscopy. The survey includes 65 studies on automatic upper GI malignancy diagnosis and evaluation, which are compared by endoscopic modalities, image counts, models, validation methods, and results. The main goal of this research is to assess and compare each AI method’s current stage and potential improvement to boost performance, maturity, and the possibility to open new research areas for the application of a real-time AI image recognition system that diagnoses upper GI malignancies. The findings of this study suggest that Support Vector Machines (SVM) are frequently utilized in gastrointestinal (GI) image processing within the context of machine learning (ML). Moreover, the analysis reveals that CNN-based supervised learning object detection models are widely employed in GI image analysis within the deep learning (DL) context. The results of this study also suggest that RGB is the most commonly used image modality for GI analysis, with color playing a vital role in detecting bleeding locations. Researchers rely on public datasets from 2018–2019 to develop AI systems, but combining them is challenging due to their unique classes. To overcome the problem of insufficient data to train a new DL model, a standardized database is needed to hold different datasets for the development of AI-based GI endoscopy systems.},
  keywords={Endoscopes;Cancer;Gastrointestinal tract;Hemorrhaging;Deep learning;Solid modeling;Real-time systems;Endoscopy;upper gastrointestinal tract;artificial intelligence;machine learning;deep learning},
  doi={10.1109/ACCESS.2023.3290997},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10499037,
  author={Vinudevi, G. and Vijayaragavan, S. P.},
  booktitle={2024 International Conference on Integrated Circuits and Communication Systems (ICICACS)}, 
  title={Predictive Modeling of Colorectal Tumor Growth and Progression with Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This research investigates the feasibility and potential applications of machine learning methods in forecasting the initiation and advancement of colorectal cancer. The proposed work investigates the efficacy of a machine learning model in customizing remedies according to each patient's diagnosis and stage of colorectal cancer. The machine learning model performed admirably when loaded with a "ColoGenIma" dataset comprising genomic, imaging, and clinical data. It is essential to highlight the model's remarkable accuracy of 97% in forecasting treatment outcomes. The results indicate that the proposed machine-learning model can provide individualized treatment recommendations for patients with colorectal tumors. The study's results shed light on the potential for data-driven models to revolutionize the healthcare industry by improving precision medicine, which enhances patient care and outcomes.},
  keywords={Solid modeling;Machine learning;Predictive models;Oncology;Data models;Forecasting;Integrated circuit modeling;Predictive Modeling;Colorectal Cancer;Machine Learning;Tumor Progression;Patient-Specific Predictions},
  doi={10.1109/ICICACS60521.2024.10499037},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11580755,
  author={Sardar, Tanvir H and Radhika, K. and Kulkarni, Praveen and Naresh, P and Reddy, Siva Nanda Lahari and Salotagi, Shreekant},
  booktitle={2026 4th International Conference on Inventive Computing and Informatics (ICICI)}, 
  title={Adaptive Neuro-Fuzzy Inference for Multi-Modal Clinical Data Fusion in Cancer Prognosis}, 
  year={2026},
  volume={},
  number={},
  pages={977-985},
  abstract={A wide range of clinical data including molecular biomarkers, histopathology characteristics, medical imaging characteristics, and patient demographics should be combined to have accurate cancer prognosis. The paper introduces a new Adaptive Neuro-Fuzzy Inference System of Multi-Modal Clinical Data Fusion (ANFIS-MCDF) to predict the outcome of cancer by jointly integrating heterogeneous data streams to provide forecasts using the fuzzy reasoning and neural network learning techniques. The framework proposed overcomes important challenges in multi-modal fusion such as different scales of data, modalities missing, inter-modal relationships, and clinically interpretable predictions are required. The architecture consists of modality-based preprocessing modules, parallel ANFIS encoders having optimized membership functions, hierarchical attention-based fusion mechanism and prognostic output layer giving survival probability estimates with confidence interval. Multi-institutional datasets on 12,847 patients with full multi-modes of data were also used to conduct comprehensive experiments in four types of cancer such as breast, lung, colorectal, and hepatocellular carcinoma. ANFIS-MCDF framework had a concordance index (C-index) of 0.847 in overall survival prediction, easily surpassing the approaches that use single-modality predictors and available fusion methods. The framework showed strong results in terms of area under the curve (AUC) of 0.912 in 5-year survival classification. The contribution of each modality and architecture element was confirmed by the ablation studies and interpretability analysis identified clinically significant fuzzy rules based on the well-known prognostic variables. The suggested method has a clear and efficient solution to personalized cancer prognosis that provides clinical decision-making in precision oncology.},
  keywords={Cancer;Modeling;Indexes;Indexing;Tumors;Learning (artificial intelligence);Equations;Transformers;Printing;Timing;Cancer prognosis;Neuro-fuzzy systems;Multi-modal fusion;ANFIS;Clinical decision support;Survival prediction;Precision oncology;Deep learning},
  doi={10.1109/ICICI68773.2026.11580755},
  ISSN={},
  month={June},}@INPROCEEDINGS{10385661,
  author={Zhu, Wen and Chen, Yiwen and Nie, Shanling and Yang, Hai},
  booktitle={2023 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={SAMMS: Multi-modality Deep Learning with the Foundation Model for the Prediction of Cancer Patient Survival}, 
  year={2023},
  volume={},
  number={},
  pages={3662-3668},
  abstract={Cancer survival prediction is pivotal in tailoring individualized treatment strategies and guiding clinician decision-making. Yet, existing methodologies grapple with efficiently harnessing the intricate distribution of medical data spanning various modalities. In response, we present SAMMS, an advanced multi-omics multimodal deep learning framework tailored for survival prediction. SAMMS leverages the robust image segmentation model, "Segment Anything" to adeptly characterize pathological images. This prowess is further enhanced by integrating multi-omics data and clinical insights, facilitating holistic modeling across a diverse modal spectrum. The framework weaves a modality-specific subnetwork with a cross-modality common subnetwork, meticulously capturing intra-modality nuances and inter-modality correlations. SAMMS eclipsed its contemporaries by delivering remarkable performance on TCGA’s LGG and KIRC tumor datasets. A battery of analyses underscored SAMMS’s unparalleled capability to distill multifaceted insights from multimodal datasets, yielding richer and more integrative multimodal representations. Such strides promise significant advancements in cancer survival analytics, bolstering the precision and efficacy of patient-centric treatments, disease oversight, and clinical decision processes.},
  keywords={Deep learning;Image segmentation;Pathology;Correlation;Decision making;Predictive models;Data models;Survival Analysis;Multi-omics Data;Pathological Images;Segment Anything},
  doi={10.1109/BIBM58861.2023.10385661},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{11688973,
  author={Umamaheswari, M. and Alex, Anisha and Jayanthi, R. and Sudhamathi, R. K. and Priya, T. Sathya and Nandhini, R.},
  booktitle={2026 7th International Conference On Computational Vision and Bio Inspired Computing (ICCVBIC)}, 
  title={Leveraging Artificial Intelligence for Occupational Stress Assessment and Women's Health Improvement}, 
  year={2026},
  volume={},
  number={},
  pages={610-616},
  abstract={Breast cancer is among the most common and dangerous diseases that affect women around the world; therefore, early diagnosis is very important and contributes to better treatment outcomes and higher survival rates. Machine Learning (ML) is an approach that can be used for prediction analysis and has proven its effectiveness and efficiency in medical diagnostics and classification. The purpose of this paper is to conduct predictive analysis of the breast cancer dataset using ML algorithms for identification of patterns and diagnosis of benign and malignant tumors. Breast density is a great challenge in breast cancer diagnostics, and significantly impacts mammogram diagnostics. It reduces the sensitivity of mammography, thus, complicates tumor identification and increases the chances of having a false negative result. In turn, high density of breasts can lead to an increased rate of false positives. Hence, additional diagnostic tests, such as ultrasound, MRI, and imaging techniques enhanced by artificial intelligence, have to be applied in order to overcome the limitations associated with mammography. The research paper focuses on the effect of breast density on early diagnosis of breast cancer taking into account mammography-based screening of breast cancer. The paper reviews the most recent advances in the field of digital mammography, breast tomosynthesis, and imaging systems based on artificial intelligence that were introduced in order to address the limitations related to dense breast tissue. Additionally, this paper highlights the research gaps, technological limitations, and emerging trends in the sphere of breast density imaging. The results of this research prove the usefulness of AI-enhanced diagnostic tools as an auxiliary to oncologists in terms of faster and reliable analysis.},
  keywords={Breast cancer;Modeling;Machine learning;Diseases;Artificial intelligence;Accuracy;Machining;Cancer;Tumors;Printing;Medical Technology;Breast Cancer;Learning Algorithms;Clinical Decision Support;Digital Health;Precision Medicine},
  doi={10.1109/ICCVBIC71195.2026.11688973},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10533567,
  author={Vinudevi, G. and Vijayaragavan, S.P. and Anand, M. and Subbulakshmi, K.},
  booktitle={2024 International Conference on Advances in Data Engineering and Intelligent Computing Systems (ADICS)}, 
  title={Deep Learning for Personalized Treatment Strategies in Colorectal Tumor Patients}, 
  year={2024},
  volume={},
  number={},
  pages={01-07},
  abstract={This research presents a novel deep learning model that effectively customizes treatment regimens for patients diagnosed with colorectal cancer, yielding exceptional results. The model's 97% success rate in predicting treatment reactions on the “The Cancer Genome Atlas (TCGA)” dataset provides evidence of its effectiveness. The model demonstrates its capacity to reduce false positives and negatives through its recall of 0.86 and accuracy of 0.91. The model exhibited exceptional discriminatory capability, as evidenced by its AUC-ROC value of 0.89. A balanced measure of accuracy and recall, the F1-score of 0.88, further suggests that the model successfully attained consistent performance across all treatment categories. The results of this research illustrate the immense potential of deep learning to transform the field of colorectal cancer treatment through the provision of tailored recommendations. This research makes a valuable contribution to the field of precision medicine by illuminating the transformative potential of data-driven models in enhancing patient outcomes and quality of life.},
  keywords={Deep learning;Precision medicine;Genomics;Transforms;Predictive models;Data engineering;Bioinformatics;Colorectal Cancer;Deep Learning;Genomic Data;Tumor Profiling;Machine Learning},
  doi={10.1109/ADICS58448.2024.10533567},
  ISSN={},
  month={April},}@INPROCEEDINGS{10488624,
  author={Bahrami, Mahsa and Vali, Mansour and Kia, Hanif},
  booktitle={2023 30th National and 8th International Iranian Conference on Biomedical Engineering (ICBME)}, 
  title={Breast Cancer Detection from Imbalanced Clinical Data: A Comparative Study of Sampling Methods}, 
  year={2023},
  volume={},
  number={},
  pages={145-149},
  abstract={accurately detecting breast cancer presents a distinctive opportunity for addressing and managing its associated side effects. Collecting patient data is often costly, resulting in imbalanced clinical data, which poses significant challenges for machine learning algorithms. In this paper, we provide a comparative analysis of sampling methods for breast cancer detection. We initially pre-processed clinical data, followed by a comparison of various sampling methods to balance the data. Subsequently, we utilized a support vector machine (SVM) for the classification of malignant and benign breast cancer. Random over-sampling, synthetic minority over-sampling technique (SMOTE), borderline SMOTE, K-means SMOTE, adaptive synthetic sampling, under-sampling majority class, Edited Nearest Neighbor (ENN), Repeated Edited Nearest Neighbor (RENN), near miss, Tomeklink, SMOTEEN, and SMOTETomek were compared and evaluated for Breast Cancer Detection (BCD) from imbalanced clinical data. We also computed feature importance with the eXtreme gradient boosting method that offers an exclusive chance for pathologists in the data processing. We validated a comprehensive examination of BCD through a dataset comprising 569 recordings from the Wisconsin Diagnostic Breast Cancer Data. The best performance was achieved by SMOTEEN, where the accuracy, sensitivity, and specificity were 98.4%, 97.6%, and 98.9%, respectively. It was also found that the mean and worse concave points were more important features for BCD in the WDBC dataset.},
  keywords={Support vector machines;Machine learning algorithms;Sensitivity and specificity;Data collection;Sampling methods;Boosting;Breast cancer;Breast cancer;clinical data;machine learning;sampling methods;WDBC},
  doi={10.1109/ICBME61513.2023.10488624},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11451023,
  author={Naik, Narayan and K, Ranganatha and Naik, Harshitha Manjayya and Yaji, Praneeta Narayan and Pai, Sahana Suresh and Mesta, Vinutha Vishwanath},
  booktitle={2025 International Conference On Emerging Computation and Information Technologies (ICECIT)}, 
  title={Multiclass Deep Learning Framework for Colon and Lung Cancer Detection and Staging from Histopathology Images}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Colon and lung cancers represent two of the most prevalent and lethal malignancies worldwide, contributing to a substantial proportion of cancer-related mortality each year. Improving patient survival rates requires prompt and precise diagnosis using histopathological image analysis; however, conventional manual interpretation by pathologists is often subjective, labor-intensive, and prone to variability. This study offers a computer-aided diagnostic framework that uses deep learning techniques to automatically detect and classify lung and colon cancer from histopathological images in order to overcome these limitations. The system utilizes a CNN model that is trained on classification tasks to categorize images into clinically relevant groups and to clearly identify normal from malignant tissue. The dataset consisted of images of lung and colon tissues and was subjected to thorough preprocessing, augmentation, and normalization to enhance model learning efficiency. The framework architecture is two-layered, wherein the first-tier CNN identifies the organ type and determines cancerous or normal tissue, followed by organ-specific CNNs that further classify the detected cancers into respective stages. The interpretations were provided using Grad-CAM visualization techniques, highlighting the most informative regions of the images used for making predictions. Experimental evaluation of the proposed CNN-based framework revealed outstanding performance with high accuracy in distinguishing benign from malignant samples, confirming the validity of this approach as a reliable diagnostic tool. The proposed framework illustrates how deep learning can improve traditional histopathological examination by increasing diagnostic precision, reducing pathologists' workload, and promoting early detection of cancer in clinical settings.},
  keywords={Deep learning;Image segmentation;Visualization;Accuracy;Histopathology;Lungs;Computational modeling;Lung cancer;Colorectal cancer;Manuals;colon cancer;lung cancer;histopathology;CNN;deep learning;Grad-CAM;cancer detection},
  doi={10.1109/ICECIT67774.2025.11451023},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10782177,
  author={Lin, Tsung-Wei and Arriagada, Sofia Ormazabal and Lin, Che},
  booktitle={2024 46th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={Multi-task Learning Graph Neural Networks for Cancer Prognosis Prediction with Genomic Data}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Providing robust prognosis predictions for cancers with limited data samples remains a challenge for precision oncology. In this study, we propose a novel approach that combines multi-task learning (MTL) and graph neural networks (GNNs) to address this issue. By representing gene-gene interactions as a graph network, our approach leverages multi-task learning to effectively capture the relationships of genes relevant to the oncogenesis and progression of breast, lung, and colon cancer. We demonstrate that our approach improves the cancer prognosis prediction for cancers with fewer samples, such as colon adenocarcinoma, by leveraging the shared gene-gene interactions across different cancer types, obtaining increases in the area under the precision-recall curve (AUPRC) of 24%. Our work contributes to the field of smart healthcare by demonstrating the potential of MTL and GNNs for enhancing cancer prognosis prediction, even with limited data samples.},
  keywords={Lungs;Genomics;Medical services;Colorectal cancer;Breast;Multitasking;Oncology;Graph neural networks;Prognostics and health management;Cancer},
  doi={10.1109/EMBC53108.2024.10782177},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{9995576,
  author={Cao, Ruifen and Gu, Qingsong and Tan, Dayu and Wei, Pijing and Zheng, Chunhou},
  booktitle={2022 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Prediction of microsatellite instability of colorectal cancer using multi-scale pathological images based on deep learning}, 
  year={2022},
  volume={},
  number={},
  pages={1461-1466},
  abstract={Immunotherapy is an excellent treatment option for many solid tumors, and the therapeutic effect has been proved in clinical. Microsatellite instability (MSI) has been an important predictive marker for response to immune checkpoint inhibitors for Colorectal cancer (CRC). CRC patients with high-level MSI can be provided immunotherapy and benefit from it. Some studies have attempted to predict MSI using pathological images based on deep learning, but the accuracy of the prediction model needs to be improved. In this study, considering that different scales of pathological images contain various levels of information, we propose a novel method, named MSIUMP, to predict microsatellite instability using multi-scale pathological images. We first predict the MSI of a patient based on deep learning model using different scale pathological images, and then integrate the results by ensemble learning to improve the generalization and robustness. In addition, a convolutional neural network model modified on the basis of EfficientNet is used to extract the information of patches from pathological images at different scales. Our method achieved the areas under the receiver operating characteristic curves (AUC) of 0.9096 in the internal test dataset TCGA-CRC and the AUC of 0.9619 in the external independent validation dataset PAIP2020. These results demonstrate the potential of our method as a prediction tool for microsatellite instability in colorectal cancer.},
  keywords={Deep learning;Training;Pathology;Biological system modeling;Small satellites;Immunotherapy;Predictive models;pathological images;microsatellite instability;multi-scale;Colorectal cancer;deep learning},
  doi={10.1109/BIBM55620.2022.9995576},
  ISSN={},
  month={Dec},}@ARTICLE{11450087,
  author={Younis, Haseeb and Rehman, Hafiz Abdul and Minghim, Rosane},
  journal={IEEE Access}, 
  title={Somatic Mutation-Driven Cancer Stage Classification via Autoencoder Clustering and Explainable Deep Learning}, 
  year={2026},
  volume={14},
  number={},
  pages={45213-45226},
  abstract={The identification of the site of origin, stage and driver genes of cancer is important for the improved prognosis of cancer patients. Publicly available somatic mutation data and machine learning techniques provide a framework for cancer stage classification. However, due to the heterogeneity and sparsity of somatic mutation data, classifying cancer stages is challenging. Researchers are keen to employ Artificial Intelligence (AI), and specifically Machine Learning (ML) techniques to detect cancer in the early stages. Most of the models provided, however, are very specific to particular cancer types and do not generalise. We propose a pipeline named Clustering with Latent Autoencoder Representations and Interpretable Technology (CLARITY) for somatic mutation analysis, which works in two ways. First, we developed an autoencoder-based clustering algorithm for desparsified somatic mutation data to identify cancer stages based on cancer hallmark scores. Second, we created a Deep Neural Network (DNN) that is tightly integrated with autoencoder-based representation learning and explainable AI (XAI) to classify these stages and interpret the hallmarks that influence cancer progression. These hallmarks are candidates for biomarkers. We demonstrate CLARITY on Breast Invasive Carcinoma (BRCA), achieving 99.47% accuracy and outperforming state-of-the-art methods. Furthermore, we show the robustness of our performance using statistical analysis, traditional ML algorithms and data visualisation techniques. This demonstrates how well our clustering algorithm can identify cancer subtypes and how our classifier handles sparse and noisy somatic mutation data.},
  keywords={Cancer;Deep learning;Breast cancer;Gene expression;Classification algorithms;Genomics;Bioinformatics;Autoencoders;Accuracy;Explainable AI;Cancer stage classification;somatic mutation profiling;deep learning in cancer genomics;explainable artificial intelligence (XAI);survival analysis;spectral clustering},
  doi={10.1109/ACCESS.2026.3676284},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11254758,
  author={Ma, Xiaorui and Xu, Hongming and Wang, Ranran and Zhang, Liqun and Zhang, Jingdong},
  booktitle={2025 47th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={Predicting the efficacy of first-line therapy for patients with colorectal cancer liver metastases using CT imaging and clinical data}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Colorectal cancer (CRC) patients are highly prone to liver metastasis (CRLM), which often becomes the leading cause of death in this population. Predicting the efficacy of first-line therapies is crucial for clinicians to develop personalized treatment strategies for CRLM patients. In this paper, we propose a novel multimodal cross-attention model that integrates contrast-enhanced liver CT imaging and clinical data to predict the therapeutic efficacy of first-line treatment in CRLM patients. Our approach utilizes the nnUNetv2 model to segment liver and intratumoral regions from CT scans. Radiomics features are extracted from the segmented tumor regions, followed by a feature selection process to identify key predictors of treatment efficacy. In parallel, highly correlated clinical variables are identified and preprocessed. The selected radiomic features and clinical variables are processed through two separate branches with identical structures, each incorporating a multi-head cross-attention module to enable efficient exchange and alignment of multimodal information. The fused multimodal features are subsequently used to predict therapeutic outcomes. Experiments conducted on a dataset of 177 patients demonstrate that our multimodal learning model outperforms uni-modal models and existing deep learning methods, achieving an AUC of 0.7195. This approach highlights the potential of integrating imaging and clinical data for improved treatment efficacy prediction in CRLM.Clinical relevance— This study highlights the importance of integrating contrast-enhanced liver CT imaging and clinical data for predicting the efficacy of first-line therapies in CRLM patients.},
  keywords={Deep learning;Image segmentation;Computed tomography;Imaging;Liver;Medical treatment;Predictive models;Feature extraction;Data models;Radiomics},
  doi={10.1109/EMBC58623.2025.11254758},
  ISSN={2694-0604},
  month={July},}@ARTICLE{10444549,
  author={Asif, Arun and Ahmed, Faheem and Zeeshan and Khan, Javed Ali and Allogmani, Eman and Rashidy, Nora El and Manzoor, Sobia and Anwar, Muhammad Shahid},
  journal={IEEE Access}, 
  title={Machine Learning Based Diagnostic Paradigm in Viral and Non-Viral Hepatocellular Carcinoma}, 
  year={2024},
  volume={12},
  number={},
  pages={37557-37571},
  abstract={Viral and non-viral hepatocellular carcinoma (HCC) is becoming predominant in developing countries. A major issue linked to HCC-related mortality rate is the late diagnosis of cancer development. Although traditional approaches to diagnosing HCC have become gold-standard, there remain several limitations due to which the confirmation of cancer progression takes a longer period. The recent emergence of artificial intelligence tools with the capacity to analyze biomedical datasets is assisting traditional diagnostic approaches for early diagnosis with certainty. Here we present a review of traditional HCC diagnostic approaches versus the use of artificial intelligence (Machine Learning and Deep Learning) for HCC diagnosis. The overview of the cancer-related databases along with the use of AI in histopathology, radiology, biomarker, and electronic health records (EHRs) based HCC diagnosis is given.},
  keywords={Cancer;Artificial intelligence;Histopathology;Tumors;Liver diseases;Ultrasonic imaging;Viruses (medical);Medical diagnosis;Biomedical imaging;Hepatectomy;Cellular biophysics;Hepatocellular carcinoma (HCC);viral cancers;artificial intelligence;cancer diagnosis;traditional cancer diagnostic},
  doi={10.1109/ACCESS.2024.3369491},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10466107,
  author={Britto, Christopher Francis},
  booktitle={2023 International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)}, 
  title={Prediction of Colon Cancer Disease with the Handling of Outliers and Overfitting through Neural Network Clustering and Optimal Tuning}, 
  year={2023},
  volume={},
  number={},
  pages={681-686},
  abstract={One serious public health concern is colon cancer. The early detection and accurate prediction are crucial for effective treatment and improved patient outcomes. By addressing two important issues—managing outliers and reducing overfitting—this research presents a novel method for colon cancer prediction.The proposed model consists of three main steps: data preprocessing, neural network clustering, and neural network modeling. The data preprocessing step includes handling outliers, selecting features, and balancing the classes. The neural network clustering step trains a self-organizing map (SOM) on the preprocessed data to generate a feature map that captures the relationships and similarities among the instances. In the neural network modeling step, a feedforward neural network is trained on the feature map to predict the probability of colon cancer.A dataset of 10,000 patient records—equally divided between those with and without colon cancer—was used to evaluate the study model. On a held-out test set, the model's accuracy of 93% is a notable improvement over that of conventional machine learning models. This suggests that the new model could be used to improve the early detection of colon cancer.The following measures contributed to the performance improvement. The use of neural network clustering to identify distinct groups of patients with similar disease characteristics. This information can be used to personalize treatment strategies. The use of optimal tuning techniques to reduce overfitting. This ensures that the model is generalizable and robust.The proposed model is a valuable source for colon cancer prediction as it is accurate and robust It can be used to personalize treatment strategies and improve patient outcomes.},
  keywords={Self-organizing feature maps;Computational modeling;Neural networks;Data preprocessing;Machine learning;Predictive models;Data models;coloncancer;neuralnetwork;overfitting;outliers;optimaltuning},
  doi={10.1109/ICAICCIT60255.2023.10466107},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11481881,
  author={Arumugam, Chockalingam and Ramesh, P.S. and Jagannathan, J. and S, Senthilvadivu. and Sudha, I. and Aparaj, Seema},
  booktitle={2026 2nd International Conference on Computing for Sustainability and Intelligent Future (COMP-SIF)}, 
  title={Transformers-Based Multi-Modal Deep Learning Framework for Early Cancer Detection Using ViT and Clinical Data Fusion}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Early cancer diagnosis is crucial in enhancing survival of the patient and proper planning of the treatment. To address such a difficulty, the proposed Transformers-Based Multi-Modal Deep Learning Framework that combines Vision Transformer (ViT) image processing with clinical data fusion via a Cross-Attention Fusion Transformer (CAFT) is presented in this paper. ViT module derives spatial and contextual features on a global level on medical images like MRI, CT, and histopathology slides, whereas clinical encoder processes the attributes of patients like biomarkers, demographics, and genetic data. The CAFT harmonizes the two modalities by cross-attentions which gives a single representation of accurate cancer prediction. The experimental results on datasets of TCIA and TCGA indicate that the proposed framework has an accuracy of 96.4 % and a precision of 95.8, a recall of 95.1, an F1-score of 95.4, and AUC-ROC of 0.97, which is $4-8$ times higher than existing CNN and unimodal models. Attention-based heatmaps increase the interpretability of the system, which improves clinical trust. The model was implemented on PyTorch on an NVIDIA RTX 4090 graphics card and an inference time of 19.7 ms per image, which is efficient and scalable. This framework can provide a bright future of precision oncology and early cancer diagnosis driven by AI.},
  keywords={Feeds;Antennas;Internet of Things;Protocols;Next generation networking;Communication systems;Internet;Computer networks;HTTP;Videos;Early Cancer Detection;Vision Transformer (ViT);Multi-Modal Deep Learning;Clinical Data Fusion;Cross-Attention Fusion Transformer (CAFT);Medical Imaging;Explainable AI;Precision Oncology},
  doi={10.1109/COMP-SIF69752.2026.11481881},
  ISSN={},
  month={March},}@INPROCEEDINGS{11014945,
  author={Mamieh, Alaa Abdulrahman and Chermahini, Siavash Hosseinpour and Eltayeb, Hiba hatim hummaida and Istaitia, Nadin ahmed mohammed and Mallat, Zeina Omar},
  booktitle={2025 Eighth International Women in Data Science Conference at Prince Sultan University (WiDS PSU)}, 
  title={Revolutionizing Healthcare Management Through Artificial Intelligence: A Comprehensive Literature Review}, 
  year={2025},
  volume={},
  number={},
  pages={256-261},
  abstract={The aim of this literature review is to discuss how artificial intelligence has transformed healthcare through new approaches to diagnosis, treatment and management processes. Personalized treatments, earlier disease detection, and more accurate diagnoses are becoming possible through advances in artificial intelligence technologies, including deep learning, natural language processing, and machine learning. Notable applications include therapeutic drug monitoring, robotic surgery, and improved cancer detection. Electronic health records and predictive models are two ways artificial intelligence improves administrative tasks, leading to better overall healthcare efficiency. Privacy, the need for human oversight, and other ethical concerns are some of the challenges that remain despite the obvious benefits of artificial intelligence. This review article highlights the potential benefits and drawbacks of artificial intelligence in revolutionizing healthcare.},
  keywords={Privacy;Ethics;Surgery;Medical services;Predictive models;Natural language processing;Artificial intelligence;Robots;Monitoring;Systematic literature review;artificial intelligence;applications;robotics;artificial intelligence-driven devices;healthcare challenges},
  doi={10.1109/WiDS-PSU64963.2025.00057},
  ISSN={},
  month={April},}@INPROCEEDINGS{10871259,
  author={Subhash, P and Manju, D and Sreaya, V and Sharath, P and Shreyana, S and Manideep, P},
  booktitle={2024 IEEE 6th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={OMM-RLC Optimised Multimodal Fusion For Recurrence Lung Cancer Detection}, 
  year={2024},
  volume={},
  number={},
  pages={406-410},
  abstract={Lung cancer is one of the deadliest cancers, involving abnormal cell changes and uncontrollable growth leading to tumors. It’s a leading cause of cancer-related deaths and can spread throughout the body if untreated. An efficient detection system is crucial, and multimodal fusion techniques offer greater accuracy than single-data-type models. Our approach for diagnosing recurrent lung cancer combines clinical and imaging data from a radiogenomic dataset. We create two unique models specific to their datasets and combine them using a late fusion strategy. This includes data gathering, preprocessing, feature extraction, and identifying recurrent lung cancer. Models are individually trained and then combined, aiming to select the best model based on accuracy and mean absolute error (MAE). Deep Learning is effective for clinical data processing, and CNNs like ResNet50 have shown promising results in image classification over traditional CNNs like VGG-16. The late fusion technique enhances predictive outcomes for multi-source datasets. Using an ensemble of models with an averaging method achieves a $78.04 \%$ accuracy rate, surpassing individual models. Our project focuses on the often-neglected aspect of recurrent lung cancer, emphasizing the need for early detection techniques. By using advanced fusion methods, integrated various data sources and models, improving predictive precision and advancing cancer detection and patient care},
  keywords={Accuracy;Soft sensors;Lungs;Lung cancer;Imaging;Predictive models;Feature extraction;Tumors;Residual neural networks;Image classification;Multimodal Fusion;Deep Learning;Recurrence of lung cancer;Feature Extraction;Clinical Data;Images Data},
  doi={10.1109/ICCCMLA63077.2024.10871259},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10541219,
  author={Merabet, Asma and Saighi, Asma and Ferradji, Mohamed Abderraouf and Laboudi, Zakaria},
  booktitle={2024 6th International Conference on Pattern Analysis and Intelligent Systems (PAIS)}, 
  title={Enhancing Colon Cancer Prediction in Histopathology with Integrated Deep Learning Models: A Comparative Study on the LC25000 Dataset}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Accurate prediction of colon cancer through histopathology images is crucial for diagnosis and treatment. Despite deep learning models showing promise in this domain, a comprehensive analysis on the LC2500 dataset, especially integrating advanced models, remains limited. This research critically evaluates the predictive performance of CNNs, Inception V3, and ResNet50, and further explores the enhancement of CNN and ResNet50 through integration with Inception V3. The hybridization of these models demonstrates a key advancement, demonstrating that the strategic combination of different architectures can lead to superior predictive capabilities. Our findings reveal significant improvements in prediction accuracy with these integrations, underscoring the capability of Inception V3 to amplify model performance. Specifically, the integration of Inception V3 with CNN yielded an impressive accuracy of 99.27%, while its combination with ResNet50 achieved an accuracy of 99.20% and a perfect recall rate. This study not only offers a detailed comparison of existing deep learning approaches but also demonstrates the substantial advancements in colon cancer prediction achieved by leveraging the strengths of combined architectures, setting new benchmarks for future research.},
  keywords={Deep learning;Training;Measurement;Analytical models;Histopathology;Predictive models;Robustness;Colon cancer;Deep Learning;Prediction;Comparative Analysis;LC25000;Inception V3;Resnet50;CNN},
  doi={10.1109/PAIS62114.2024.10541219},
  ISSN={},
  month={April},}@INPROCEEDINGS{9967308,
  author={Venkatayogi, Nethra and Kara, Ozdemir Can and Bonyun, Jeff and Ikoma, Naruhiko and Alambeigi, Farshid},
  booktitle={2022 IEEE Sensors}, 
  title={Classification of Colorectal Cancer Polyps via Transfer Learning and Vision-Based Tactile Sensing}, 
  year={2022},
  volume={},
  number={},
  pages={1-4},
  abstract={In this study, to address the current high early-detection miss rate of colorectal cancer (CRC) polyps, we explore the potentials of utilizing transfer learning and machine learning (ML) classifiers to precisely and sensitively classify the type of CRC polyps. Instead of using the common colonoscopic images, we applied three different ML algorithms on the 3D textural image outputs of a unique vision-based surface tactile sensor (VS-TS). To collect realistic textural images of CRC polyps for training the utilized ML classifiers and evaluating their performance, we first designed and additively manufactured 48 types of realistic polyp phantoms with different hardness, type, and textures. Next, the performance of the used three ML algorithms in classifying the type of fabricated polyps was quantitatively evaluated using various statistical metrics.},
  keywords={Training;Measurement;Three-dimensional displays;Transfer learning;Tactile sensors;Support vector machine classification;Sensors;colorectal cancer;machine learning;deep residual networks;support vector machine;transfer learning;vision-based surface tactile sensor},
  doi={10.1109/SENSORS52175.2022.9967308},
  ISSN={2168-9229},
  month={Oct},}@INPROCEEDINGS{10894209,
  author={Indumathi, R. and Jayaraj, R.},
  booktitle={2024 International Conference on System, Computation, Automation and Networking (ICSCAN)}, 
  title={Leveraging AI-Driven Machine Learning Approaches -SVM and RESNET-50 For Predicting Esophageal Cancer Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Esophageal cancer, a very aggressive malignancy, exhibits a significant mortality rate attributed to late diagnosis and diverse patient responses to therapeutic interventions including chemotherapy, radiation therapy, and immunotherapy. Customized therapy suggestions are essential for enhancing patient outcomes; however, existing methodologies depend on generic models that fail to consider individual heterogeneity. This paper proposes an AI-driven approach utilizing machine learning algorithms, that includes Support Vector Machines (SVM) ResNet-50 structure for deep convolutional neural networks and its objective is to classify the Barrett's esophagus and adenocarcinoma cancers. As multilayered perceptron's are the center of the approach, determined which maximal classification in ResNet-50 would be appropriate layers and trained them to cut to avoid redundancy. It was demonstrated that regional information and high-dimensional features are important to enhance classification. Also, maximal layer discrimination and differential effect can be important in Barrett's esophagus and adenocarcinoma classification training on ResNet50. The model improves precision through the incorporation of clinical data to plan individualized treatment pathways. It has shown more sensitivity in terms of the detection of neoplasia in Barrett's esophagus, reaching up to 90% as compared to conventional techniques. The experimental findings indicate enhanced prediction accuracy, precision, sensitivity relative to conventional approaches. This AI system offers a prospective option for the optimization of individualized treatment in esophageal cancer therapy.},
  keywords={Support vector machines;Sensitivity;Machine learning algorithms;Accuracy;Computational modeling;Data models;Vectors;Convolutional neural networks;Cancer;Esophagus;Esophageal carcinoma;Machine learning;Support Vector Machines (SVM);Convolutional Neural networks;ResNet-50},
  doi={10.1109/ICSCAN62807.2024.10894209},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10971627,
  author={Handshoe, Benjamin and Kim, Sujin and Bae, Jihye},
  booktitle={SoutheastCon 2025}, 
  title={Identifying Key Diagnostic Codes for Initial Belief State Prediction for Modeling Colorectal Cancer Screening Based on Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={894-899},
  abstract={Colorectal cancer (CRC) is a leading cause of cancer-related deaths in the United States. Reinforcement learning (RL) allows modelling the dynamic decision-making in CRC screening and early detection as a partially observable Markov decision process (POMDP). Accurate computation of the initial belief state is a critical step in the POMDP implementation. We explore clinical codes that can contribute to the prediction of the initial belief state of the POMDP. Clinical codes from 4714 adults (2357 CRC and 2357 healthy) obtained by University of Kentucky HealthCare were employed. Each subject's demographics along with CRC related diagnostic codes including K (diseases of the digestive system), R (symptoms, signs, and abnormal clinical and laboratory findings), and Z (factors influencing health status and contact with health services) codes, were applied to compute the initial belief state using eXtreme Gradient Boosting (XGBoost), and the key factors were determined using Shapley Additive exPlanations (SHAP). A reasonable initial belief state computation was obtained, and we found that codes related to health maintenance and preventative care, screening for cancer and post-treatment, treatment and follow-up care, and digestive system condition positively contribute to the prediction of CRC cases. As these extracted key factors are ranked by importance, they can provide guidelines for selection of codes for the initial belief state computation in POMDP.},
  keywords={Codes;Computational modeling;Markov decision processes;Digestive system;Reinforcement learning;Colorectal cancer;Medical services;Predictive models;Maintenance;Guidelines;Colorectal Cancer;Diagnostic Codes;Reinforcement Learning;Partially Observable Markov Decision Process;Belief States},
  doi={10.1109/SoutheastCon56624.2025.10971627},
  ISSN={1558-058X},
  month={March},}@INPROCEEDINGS{11126633,
  author={da Silva, Aurea Valeria Pereira and Sa Leitao-Junior, Plinio and Felix, Juliana},
  booktitle={2025 IEEE 49th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={A Comparative Study of Data Balancing Techniques for Predicting Metastases in Colorectal Cancer Using the SEER Database}, 
  year={2025},
  volume={},
  number={},
  pages={2142-2147},
  abstract={Predicting liver and/or lung metastases in colorectal cancer (CRC) patients remains a critical challenge, especially due to the strong class imbalance commonly found in clinical datasets such as SEER (Surveillance, Epidemiology, and End Results Program). To address this issue, this study presents a comparative analysis of eight data balancing techniques combined with seven machine learning algorithms for metastasis prediction using SEER data. The evaluated techniques include traditional SMOTE, ADASYN, Borderline-SMOTE, SMOTE-LOF, Radius-SMOTE, RDSMOTE, and CUSS, along with a baseline configuration without any balancing. A total of 53,463 CRC patients were analyzed, and model performance was assessed using F1-score and AUC metrics under five-fold stratified cross-validation. Among the techniques, SMOTE-LOF achieved the best overall results, particularly when combined with XGBoost, reaching an F1-score of 0.6642 and AUC of 0.8988. The results indicate that combining oversampling with noise filtering or structural awareness significantly enhances model sensitivity. This study highlights the importance of selecting appropriate resampling techniques for clinical prediction tasks and offers insights for improving the robustness and fairness of machine learning applications in oncology.},
  keywords={Sensitivity;Lungs;Surveillance;Noise;Liver;Colorectal cancer;Sensitivity and specificity;Data structures;Software;Metastasis;Colorectal cancer;metastasis prediction;class imbalance},
  doi={10.1109/COMPSAC65507.2025.00301},
  ISSN={2836-3795},
  month={July},}@ARTICLE{10663258,
  author={Su, Yuhan and Huang, Chaofeng and Yang, Chen and Lin, Qin and Chen, Zhong},
  journal={IEEE Open Journal of Engineering in Medicine and Biology}, 
  title={Prediction of Survival in Patients With Esophageal Cancer After Immunotherapy Based on Small-Size Follow-Up Data}, 
  year={2024},
  volume={5},
  number={},
  pages={769-782},
  abstract={Esophageal cancer (EC) poses a significant health concern, particularly among the elderly, warranting effective treatment strategies. While immunotherapy holds promise in activating the immune response against tumors, its specific impact and associated reactions in EC patients remain uncertain. Precise prognosis prediction becomes crucial for guiding appropriate interventions. This study, based on data from the First Affiliated Hospital of Xiamen University (January 2017 to May 2021), focuses on 113 EC patients undergoing immunotherapy. The primary objectives are to elucidate the effectiveness of immunotherapy in EC treatment and to introduce a stacking ensemble learning method for predicting the survival of EC patients who have undergone immunotherapy, in the context of small sample sizes, addressing the imperative of supporting clinical decision-making for healthcare professionals. Our method incorporates five sub-learners and one meta-learner. Leveraging optimal features from the training dataset, this approach achieved compelling accuracy (89.13%) and AUC (88.83%) in predicting three-year survival status, surpassing conventional techniques. The model proves efficient in guiding clinical decisions, especially in scenarios with small-size follow-up data.},
  keywords={Immunotherapy;Predictive models;Ensemble learning;Cancer;Stacking;Accuracy;Immune system;Esophageal carcinoma;immunotherapy;survival prediction;stacking ensemble learning;machine learning},
  doi={10.1109/OJEMB.2024.3452983},
