  month={April},}@INPROCEEDINGS{11252666,
  author={Kim, Kyungbeom and Sathu, Harinishree and Hornback, Andrew and Isgut, Monica and Traynelis, Joshua and Wang, May D.},
  booktitle={2025 47th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={Enhancing Colon Cancer Risk Prediction in Machine Learning Models using Polygenic Risk Scores}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Colon cancer is one of the deadliest types of cancer in the United States, with close to 50,000 projected deaths in 2024. The disease requires early diagnosis to optimize chances of survival by enabling timely administration of treatment. To investigate the key non-genetic (NG) factors influencing the onset of colon cancer and evaluate how genetic factors enhance the performance of machine learning (ML) models in predicting incidence, we incorporated polygenic risk scores (PRSs) alongside NG data in ML models to predict 10-year incident risk prediction of colon cancer using data from the UK Biobank. This approach enabled us to assess the added predictive value of PRSs in multi-modal models in estimating the 10-year risk of developing colon cancer over NG data alone. Moreover, our research focused on identifying the most relevant and predictive PRS and validating them using a robust ML framework. To ensure the robustness, we restricted the cohort to White British individuals to minimize ancestry-related heterogeneity. PRSs have proven effective in enhancing disease prediction for conditions such as breast cancer, myocardial infarction, and schizophrenia, reinforcing their relevance in clinical research. Exploring six PRSs, our goal was to minimize false negatives while simultaneously maximizing area under the receiver-operating characteristic curve (AUC), in order to improve early detection rates by identifying those who are at risk for colon cancer. This research shows that PRSs can be used to enhance overall predictive ability of ML models in colon cancer research over NG factors alone, bolstering the argument for incorporating PRSs into routine clinical practice. PRSs can also help minimize false negatives, a key feature for disease prediction models, as missed potential diagnoses are life-threatening.},
  keywords={Biological system modeling;Colorectal cancer;Machine learning;Predictive models;Schizophrenia;Genetics;Data models;Robustness;Breast cancer;Engineering in medicine and biology},
  doi={10.1109/EMBC58623.2025.11252666},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{11484753,
  author={Fatima, Nayab and Maurya, Pratibha and Pandey, Rajiv},
  booktitle={2025 IEEE International Conference on Communication Networks and Computing (CNC)}, 
  title={AI in Early Detection of Colorectal Cancer}, 
  year={2025},
  volume={},
  number={},
  pages={161-167},
  abstract={AI-powered early detection of colorectal cancer (CRC) has emerged as a transformative solution to a significant public health challenge, particularly in regions experiencing a rise in cases due to lifestyle shifts. This paper explores the potential of AI, including machine learning, deep learning, and image analysis, to enhance CRC screening. We conducted a comprehensive review of existing literature and analyzed the application of advanced algorithms, such as Convolutional Neural Networks (CNNs), for interpreting colonoscopy images, histopathology slides, and clinical data. Our findings indicate that these AI tools can identify polyps, abnormal tissue, and pre-cancerous changes with high accuracy, addressing the limitations of traditional, invasive diagnostic methods which often lead to delays and missed early-stage signs. The research also addresses key challenges, including data availability, clinical integration, and ethical considerations. The results underscore the growing role of AI in making CRC screening more accessible and efficient, offering a promising future for cancer diagnostics.},
  keywords={MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Videos;Communication networks;Communication systems;Internet;Location awareness;Video equipment;Protocols;Artificial Intelligence (AI);Colorectal Cancer (CRC);Early Detection;Deep Learning (DL);Colonoscopy},
  doi={10.1109/CNC68716.2025.11484753},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11605028,
  author={Gardašević, Gordana and Grbić, Milana and Ždralević, Maša and Mihailovic, Andrej},
  booktitle={2026 9th International Balkan Conference on Communications and Networking (Balkancom)}, 
  title={Towards an Integrated CRC Risk Prediction using Machine Learning - Driven Digital Twin Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Colorectal cancer remains a major global health challenge, with substantial variability in patient outcomes and risk of relapse. Machine learning (ML) methods have shown potential in improving risk prediction by integrating heterogeneous clinical, molecular, and imaging data. At the same time, the Digital Twin (DT) concept enables the creation of dynamic patient-specific models that can support continuous monitoring and personalized risk assessment. This paper proposes an architectural framework for ML-DT integration for colorectal cancer risk prediction (CRC). The integration of ML and DT frameworks is implemented using the Kafka-ML model to sup-port dynamic, real-time, event-driven healthcare applications. To validate a proposed architecture, a few simple models are tested, with particular emphasis on those that incorporate longitudinal patient data and enable adaptive updates to risk estimates over time.},
  keywords={Modeling;Colorectal cancer;Tumors;Printing;Machine learning;Timing;Real-time systems;Digital twins;Medical services;Machining;machine learning;digital twin;colorectal cancer;prognostic models},
  doi={10.1109/BalkanCom71095.2026.11605028},
  ISSN={},
  month={June},}@INPROCEEDINGS{11013346,
  author={Rana, Humayan Kabir and Ahmed, Boshir},
  booktitle={2025 International Conference on Electrical, Computer and Communication Engineering (ECCE)}, 
  title={Identification of Candidate Genes for Colorectal Cancer Using Machine Learning and Bioinformatics Approaches}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Colorectal cancer (CRC) stands as the second most prevalent cause of cancer deaths, and its incidence is rising over time. Identifying key genes is essential for diagnosing and developing effective therapeutic strategies for cancer. Several studies were conducted to determine the candidate genes of CRC but this is still not sufficient and further research is needed in this area. Thus, we aimed to identify the key candidate genes of CRC using The Cancer Genome Atlas (TCGA) dataset, applying the Kruskal-Wallis test and Bonferroni correction machine learning techniques. We successfully identified 9 candidate genes, including CALB2, GRP, KRAS, MLH1, NPR3, PPFIA4, SOX11, STAC2, and TRPA1, from 20518 genes of CRC using our model. In addition, we used bioinformatics frameworks to identify signaling pathways, gene ontological pathways, and PPI networks that reflect the functions of these candidate genes. We found 9 significant signaling pathways, 12 ontological pathways, and 3 hub genes for CRC. The diagnostic effectiveness of the candidate genes was evaluated through the receiver operating characteristic (ROC) analysis, and all candidate genes showed good performance according to area under the curve (AUC) values. Notably, the gene MLH1 demonstrated the highest AUC of .91. In fine, the findings of this study may play a role in disease management and offer a foundation for further laboratory investigations to uncover potential therapeutic targets for CRC treatment.},
  keywords={Proteins;Electric potential;Biological system modeling;Genomics;Machine learning;Colorectal cancer;Receivers;Bioinformatics;Colorectal Cancer (CRC);Key genes of CRC;Influential genes of CRC;Kruskal-Wallis test;and Bonferroni correction},
  doi={10.1109/ECCE64574.2025.11013346},
  ISSN={},
  month={Feb},}@ARTICLE{11197657,
  author={Tourab, Hania and Lopez-Perez, Laura and Arroyo-Gallego, Peña and Georga, Eleni and Rujas, Miguel and Ponziani, Francesca Romana and Torrego-Ellacuría, Macarena and Merino-Barbancho, Beatriz and Dei, Neri Niccolò and Ciuti, Gastone and Fotiadis, Dimitrios and Antonio, Gasbarrini and Cabrera, María Fernanda and Arredondo, María Teresa and Fico, Giuseppe},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={The Use of Machine Learning and Explainable Artificial Intelligence in Gut Microbiome Research: A Scoping Review}, 
  year={2026},
  volume={30},
  number={1},
  pages={717-731},
  abstract={Gut microbiome research has made tremendous progress, especially with the integration of machine learning and artificial intelligence that can provide new insights from complex microbiome data and its impact on human health. The use of explainable artificial intelligence is becoming critical in medicine and adopting it in precision medicine-models leveraging gut microbiome data is appealing for providing more transparency and trustworthiness in clinical research. This scoping review evaluates the use of machine learning and explainable artificial intelligence techniques and identifies existing gaps in knowledge in this research area to suggest future research directions. Online databases (PubMed and Scopus) were searched to retrieve papers published between 2018-2024, and from which we selected 76 publications. Different clinical applications of machine learning and artificial intelligence techniques in gut microbiome studies were explored in the reviewed articles. We observed a high prevalence in the use of black box models in the field, with Random Forest being the most used algorithm. The explainability remains somewhat limited in the field, but it appears to be improving. Researchers showed interest in SHAP applications as an explainable technique. Finally, not enough attention was paid to the reproducibility of the research work published. This review highlights opportunities for advancing research on explainable artificial intelligence models in the field of microbiome, supporting future applications of microbiome-based precision medicine.},
  keywords={Microorganisms;Artificial intelligence;Reviews;Analytical models;Machine learning;Predictive models;Reproducibility of results;Biological system modeling;Sequential analysis;Precision medicine;Artificial intelligence;explainability;explainable artificial intelligence;gut microbiome;interpretability;machine learning;precision medicine},
  doi={10.1109/JBHI.2025.3593198},
