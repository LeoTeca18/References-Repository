  booktitle={2025 3rd International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)}, 
  title={Enhancing Sigmoid Colon Cancer Diagnosis: XGBoost and CNN for Accurate and Rapid Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1843-1848},
  abstract={Better patient outcomes emerge when Sigmoid colon cancer diagnosis processes reach both high accuracy levels and swift diagnosis times. XGBoost Machine Learning together with Convolutional Neural Networks operates to make predictions from clinical structures and histopathology images. The evaluation of Real Colorectal Cancer Dataset with XGBoost yielded 92.31% accuracy while CNN processed LC25000 data which achieved 96.45% accuracy. The results from the confusion matrix showed CNN achieved superior diagnostic outcomes than XGBoost because its accuracy level reduced by 37% relative to XGBoost. Using Grad-CAM as a visualization technique allows medical professionals to identify crucial cancer areas inside histopathology images which improve their diagnostic ability. Among the factors analyzed by XGBoost tumor size occupied the top-ranking position followed by CEA levels whereas lymph node involvement ranked in the third position based on this system. XGBoost provides explainable features that work on structured clinical data while pathological image analysis achieves maximum performance through CNN technology. Further research must focus on developing AI-directed hybrid diagnostic systems that integrate these models because they would boost their accuracy thus making them more useful for clinical applications},
  keywords={Accuracy;Histopathology;Computational modeling;Colorectal cancer;Cancer detection;Data models;Convolutional neural networks;Medical diagnostic imaging;Lymph nodes;Tumors;Sigmoid Colon Cancer;Machine Learning (ML);Deep Learning (DL);Histopathology Image Analysis;XGBoost and CNN Classification},
  doi={10.1109/ICSSAS66150.2025.11081050},
  ISSN={},
  month={June},}@INPROCEEDINGS{11602901,
  author={Ghaleb, Moshira S. and ElSmahey, Mohamed K. and Elsokkary, Hassan A. Rahman and Hamdy, Nadia M.},
  booktitle={2026 IEEE International Conference on Smart Sustainable Systems for Computer and Engineering Applications (3SCEA)}, 
  title={SOX2OT as a Novel Prognostic Biomarker and Therapeutic Target in Colorectal Cancer}, 
  year={2026},
  volume={},
  number={},
  pages={239-248},
  abstract={Colorectal cancer is a leading cause of cancerrelated mortality worldwide and is characterized by tumor heterogeneity, late-stage diagnosis, and therapeutic resistance. Recent advances in genomics and machine-learning approaches have enabled the identification of molecular biomarkers to improve prognostic assessment and support precision oncology. Among these, long non-coding RNAs (IncRNAs) have emerged as important regulatory elements, although many remain insufficiently characterized clinically. The SOX2 overlapping transcript (SOX2OT) has been reported as part of a novel biomarker panel; however, its prognostic and translational relevance in CRC has not been fully explored. In this study, RNA-sequencing and clinical data from The Cancer Genome Atlas colorectal cancer cohort were analyzed using an integrative computational framework to investigate SOX2OT. Elevated SOX2OT expression was significantly associated with poorer overall survival. Machine-learning modeling using a Random Forest-based approach demonstrated robust performance in predicting survival outcomes, supporting the predictive relevance of a SOX2OT-centered gene panel. Pathway enrichment analyses using KEGG and Reactome revealed enrichment of oncogenic, developmental, and immuneregulatory pathways, including Wnt signaling and immune checkpoint-associated processes. In addition, pharmacogenomic correlation analysis using GDSC and DepMap indicated that SOX2OT-associated transcriptional programs align with downstream, clinically actionable pathway dependencies, despite the non-coding and non-druggable nature of SOX2OT. Overall, these findings establish SOX2OT as a prognostic and predictive biomarker in colorectal cancer and demonstrate how non-coding RNA dysregulation can be translated into clinically meaningful insights through integrative machine-learning and pathway-based analyses. SOX2OT is proposed as a treatment-stratification biomarker for future biomarker-driven precision oncology studies.},
  keywords={Modeling;Machine learning;Cancer;Tumors;Printing;Machining;Drugs;RNA;Biomarkers;Colorectal cancer;SOX2OT;InRNA;Machine Learning;Drug discovery;Colorectal Cancer},
