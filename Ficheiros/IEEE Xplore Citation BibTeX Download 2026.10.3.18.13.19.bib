  author={Guo, Jirui and Cao, Wuteng and Nie, Bairun and Qin, Qiyuan},
  journal={IEEE Journal of Translational Engineering in Health and Medicine}, 
  title={Unsupervised Learning Composite Network to Reduce Training Cost of Deep Learning Model for Colorectal Cancer Diagnosis}, 
  year={2023},
  volume={11},
  number={},
  pages={54-59},
  abstract={Deep learning facilitates complex medical data analysis and is increasingly being explored in colorectal cancer diagnostics. However, the training cost of the deep learning model limits its real-world medical utility. In this study, we present a composite network that combines deep learning and unsupervised K-means clustering algorithm (RK-net) for automatic processing of medical images. RK-net was more efficient in image refinement compared with manual screening and annotation. The training of a deep learning model for colorectal cancer diagnosis was accelerated by two times with utilization of RK-net-processed images. Better performance was observed in training loss and accuracy achievement as well. RK-net could be useful to refine medical images of the ever-expanding quantity and assist in subsequent construction of the artificial intelligence model.},
  keywords={Deep learning;Training;Costs;Annotations;Neural networks;Manuals;Quality control;Artificial intelligence;computer aided diagnosis;deep learning;image filtering;oncology;unsupervised learning},
  doi={10.1109/JTEHM.2022.3224021},
  ISSN={2168-2372},
