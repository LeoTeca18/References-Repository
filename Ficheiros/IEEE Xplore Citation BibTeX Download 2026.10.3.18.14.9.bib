  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11580651,
  author={Jayasingh, Bipin Bihari and Monika, N.},
  booktitle={2026 4th International Conference on Inventive Computing and Informatics (ICICI)}, 
  title={Colorectal Cancer Histopathology Classification using Xception, ResNet-50, and Grad-CAM Explainability}, 
  year={2026},
  volume={},
  number={},
  pages={1641-1647},
  abstract={Colorectal cancer ranks among the most prevalent and lethal malignancies worldwide, with approximately 1.9 million new cases diagnosed annually. Accurate classification of colorectal tissue subtypes from hematoxylin and eosin (H&E)-stained histopathological images is essential for guiding treatment decisions, yet manual examination remains time-consuming and subject to significant inter-observer variability. This paper proposes an automated deep-learning framework for colorectal cancer tissue classification using the publicly available EBHI-SEG benchmark dataset, which contains 2,228 image patches across nine tissue categories. Two pre-trained convolutional neural network (CNN) architectures Xception and ResNet-50 are fine-tuned via a two-phase transfer learning strategy and rigorously benchmarked against three conventional machine-learning baselines. The Xception model trained with the Adam optimizer achieves the best performance: 94.2% accuracy, 93.5% precision, 95.1% recall, 94.3% F1-score, and an AUC-ROC of 0.978. To address the clinical interpretability requirement, Gradient-weighted Class Activation Mapping (Grad-CAM) is integrated to produce visual saliency maps that highlight diagnostically relevant tissue regions, thereby improving clinician trust in the automated system. Experimental results confirm substantial gains over traditional machine-learning methods and demonstrate the framework's readiness for real-time clinical decision-support deployment.},
  keywords={Modeling;Training;Accuracy;Cams;Computer aided manufacturing;Printing;Cancer;Biological tissues;Deep learning;Convolutional neural networks;colorectal cancer;histopathology;convolutional neural networks;transfer learning;ResNet-50;Xception;Gradient-weighted Class Activation Mapping;medical image classification},
  doi={10.1109/ICICI68773.2026.11580651},
