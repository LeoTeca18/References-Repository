  abstract={Identification of GI polyps plays a crucial role in reducing the risk of colorectal cancer by early detection and action. The application of deep learning in building CADe systems has proven to be groundbreaking, but unfortunately, all the currently available solutions are based on one modality of imaging, as well as lacking the key elements such as interpretability and clinical reasoning required for practical applications. This paper describes a novel multi-modal approach to AI that integrates the power of deep visual detection along with smart LLMs into an explainable AI system designed specifically for analyzing endoscopic images. For polyp localization, YOLO11m was used alongside a CNN-based classifier. Besides, it deploys dual LLM agents (llama-3.1-8b-instant and qwen3-32b) to help clinical interpretation, risk reasoning, and automated report generation. The system’s transparency is enhanced by techniques such as Grad-CAM and LIME visualizations. The method was tested on the Kvasir-SEG and Kvasir-Sessile datasets comprising 1,196 images, and it achieved an average overall accuracy of 97%. For polyp detection, precision was 0.98, recall was 0.97, and the F1-score was 0.975. These results are better than those achieved by conventional CNN-based and single-modality systems. The Streamlit-based deployment facilitates inference in under five seconds and generates structured PDF clinical reports. The proposed model integrates real-time image analysis with clinical reasoning, thereby providing a feasible and interpretable AI-assisted colonoscopy tool that can be effortlessly integrated into clinical workflows.},
  keywords={Modeling;Signal detection;Visualization;Cognition;Cognitive systems;Lighting;Artificial intelligence;Printing;Lesions;Timing;Gastrointestinal Polyp Detection;Deep Learning;YOLO11m;Explainable AI;Multi-Agent Systems;Clinical AI;Endoscopy},
  doi={10.1109/IC-ICNS68863.2026.11537595},
  ISSN={},
  month={March},}@INPROCEEDINGS{10862078,
  author={Singh, Agampreet and Gill, Kanwarpartap Singh and Kumar, Mukesh and Rawat, Ruchira},
  booktitle={2024 Global Conference on Communications and Information Technologies (GCCIT)}, 
  title={Addressing Bone Marrow Classification Hurdles Using EfficientNetB5 Technique}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Multi-class classification of bone marrow images faces challenges such as class imbalance, significant intra-class variability, and the need for precise and interpretable diagnostic models. These issues complicate the development of reliable automated clinical diagnostic systems. Accurate classification of bone marrow images is crucial for diagnosing a range of hematological disorders. However, difficulties arise in achieving precise and comprehensible results due to morphological variability and class imbalance. This study examines the application of EfficientNetB5, an advanced convolutional neural network, to address these issues in bone marrow image classification. By implementing customized loss functions, advanced data augmentation, and interpretability methods, our approach achieves an impressive 96% accuracy. These results highlight how EfficientNetB5 can enhance diagnostic reliability and precision in clinical settings. Our approach overcomes challenges by addressing class imbalance with tailored loss functions, increasing dataset diversity with innovative augmentation techniques, and ensuring model transparency with interpretability strategies. Leveraging EfficientNetB5's advanced architecture, we achieved a significant improvement with a 96% accuracy rate in classification.},
  keywords={Accuracy;Predictive models;Bones;Data augmentation;Data models;Information and communication technology;Reliability;Convolutional neural networks;Faces;Image classification;Artificial Intelligence;Machine Learning;Bone Marrow Classification;Model Training;Efficient NetB5 Model},
