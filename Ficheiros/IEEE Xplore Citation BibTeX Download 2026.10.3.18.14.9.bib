  author={Ingole, Rushikesh P and Anjankar, Ashish and Basheeruddin, Mohd and Qausain, Sana and kahan, Faez Iqbal and Dhok, Archana},
  booktitle={2026 IEEE 1st International Conference on Intelligent Technologies for a Sustainable and Inclusive Future (ICITSIF)}, 
  title={AI-Powered Early Detection of Cancer Using Circulating Tumor Biochemistry}, 
  year={2026},
  volume={},
  number={},
  pages={1213-1217},
  abstract={Due to its late diagnosis and the low sensitivity of traditional diagnostic techniques, cancer is one of the leading causes of mortality worldwide. Most of the recent technological developments in circulating tumor biochemistry, Tumor- derived exosomes, circulating tumor cells (CTCs), and circulating tumor DNA (ctDNA), and metabolomic markers have made early cancer screening less invasive. Artificial intelligence (Al) approaches, particularly deep learning and transformer-based design, have made it possible to identify weak molecular patterns that conventional statistical algorithms are unable to decode. This renew presents a discussion about the combination of Al and circulating biochemical markers to detect early cancer, new developments, weaknesses and aspirations.},
  keywords={Tumors;Cancer;Artificial intelligence;Modeling;Biopsy;Biomarkers;Printing;Liquids;Signal detection;Biochemistry;AI;cancer detection;liquid biopsy;biomarker prediction;deep learning;ctDNA;metabolomics},
