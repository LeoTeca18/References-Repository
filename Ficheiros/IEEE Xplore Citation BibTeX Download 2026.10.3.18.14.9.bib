@INPROCEEDINGS{11224832,
  author={Khan, Mehwish Wahid and Shahzad, Muhammad and Akram, Iqra and Ahmed, Ghufran and Hussain, Shahid and Rahim, Muhammad Abdul Basit ur},
  booktitle={2025 IEEE 49th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Clustering Effect on Cancer Molecular Subtype Classification}, 
  year={2025},
  volume={},
  number={},
  pages={2410-2414},
  abstract={Deep learning(DL) is a branch of artificial intelligence that emulates human brain functions through computational processes. It has demonstrated its effectiveness across various domains; healthcare is no exception. Encouraging outcomes have been achieved in multiple healthcare applications, which include the classification of cancer, its prognosis, diagnosis, and classifying different molecular subtypes of cancer. Molecular subtyping using gene expression data may provide biological insights into cancer heterogeneity, which is instrumental in developing personalized medicine. The samples' scarcity relative to the high dimensional feature space remains a challenge in implementing deep learning models. This research investigates the effectiveness of clustering for reducing the dimensionality of the transcriptomic data and its subsequent influence on classification accuracy. The proposed method clusters the features and leverages the cluster centroids to train the classification model to predict the cancer molecular subtypes of colorectal cancer. The result comparison of the model with and without clustering reveals improved performance, in our proposed framework, while achieving parity with accuracy levels in others.},
  keywords={Deep learning;Accuracy;Precision medicine;Transcriptomics;Medical services;Colorectal cancer;Oncology;Software;Gene expression;Reliability;Molecular Subtyping;Deep Learning;K-means cluster},
  doi={10.1109/COMPSAC65507.2025.11224832},
  ISSN={2836-3795},
  month={July},}@INPROCEEDINGS{10927570,
  author={Liu, Tengxiao and Yang, Huiya and Huang, Jiayi and Zhou, Yihan},
  booktitle={2024 6th International Conference on Control and Robotics (ICCR)}, 
  title={A Review of Colorectal Cancer Histopathology Image Segmentation Using Deep Learning Methods}, 
  year={2024},
  volume={},
  number={},
  pages={281-291},
  abstract={Colorectal cancer (CRC) is the third most common cancer in humans with a rising incidence and a high mortality rate. Image segmentation of histopathological slices based on deep learning models can effectively accelerate the diagnostic process. In this paper, an overview of the datasets of the introduced models is provided and the performance of deep learning models is compared on common datasets. We classify the CRC pathological image segmentation models proposed in recent years into categories based on several basic models: Convolutional Neural Network (CNN), U-Net, Transformer and others. We list effective quantitative evaluation metrics in image segmentation and apply them to these models for comprehensive comparative analysis. Besides, improvement of different models on each module of the traditional model with respective advantages and disadvantages are sorted out. Finally, limitations and future directions are proposed from three aspects of computing power requirements, datasets and the model itself to provide inspiration for researchers who want to enter and go deeper into this field in the future.},
  keywords={Deep learning;Image segmentation;Histopathology;Convolution;Computational modeling;Biological system modeling;Colorectal cancer;Feature extraction;Transformers;Convolutional neural networks;colorectal cancer;histopathology;deep learning;CNN;U-Net;transformer;medical image segmentation},
  doi={10.1109/ICCR64365.2024.10927570},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10915085,
  author={M, Gayathri and Thamarai Selvi, D. and Kalaiselvi, S. and Santhi, S.},
  booktitle={2025 3rd International Conference on Intelligent Data Communication Technologies and Internet of Things (IDCIoT)}, 
  title={Colorectal Cancer Detection based on Integrated Graph Convolutional Networks and Shift Window Transformer}, 
  year={2025},
  volume={},
  number={},
  pages={2192-2198},
  abstract={Advanced predictive analytics is required to improve early identification and patient outcomes for colorectal cancer (CRC), which is still a major worldwide health concern. Using deep learning and graph-based methods, this study suggests a new prediction framework that makes use of Graph Convolutional Networks (GCNs) and a Shifted Window Transformer architecture by means of thorough pre-processing, which includes graph creation and normalization, we establish a strong input structure for our model. To improve feature extraction from histopathology pictures, the Shifted Window Transformer-which is well-known for its effectiveness in capturing long-range dependencies-is incorporated. The model is able to utilize both individual cellular properties and their interrelations thanks to GCNs that learn from the graph structure. By automatically identifying colorectal cancer in its early stages, this prediction system seeks to do away with the requirement for human identification by medical professionals and allow for prompt treatment without awaiting a formal diagnosis. This work aims to improve early-stage (stage 1) detection using our suggested automated models because it is challenging to detect CRC in stage 0. This innovative strategy promises prompt interventions that will enhance patient care and clinical results.},
  keywords={Deep learning;Adaptation models;Accuracy;Sensitivity;Graph convolutional networks;Computational modeling;Colorectal cancer;Transformers;Feature extraction;Real-time systems;Cancer detection;Graph convolutional network;Deep learning;Feature extraction;Automated detection;Shift transformer},
  doi={10.1109/IDCIOT64235.2025.10915085},
  ISSN={},
  month={Feb},}@ARTICLE{10153937,
  author={Morvan, Ludivine and Nanni, Cristina and Michaud, Anne-Victoire and Jamet, Bastien and Bailly, Clément and Bodet-Milin, Caroline and Chauvie, Stephane and Touzeau, Cyrille and Moreau, Philippe and Zamagni, Elena and Kraeber-Bodéré, Francoise and Carlier, Thomas and Mateus, Diana},
  journal={IEEE Transactions on Radiation and Plasma Medical Sciences}, 
  title={Multiple Myeloma Prognosis From PET Images: Deep Survival Losses and Contrastive Pretraining}, 
  year={2023},
  volume={7},
  number={7},
  pages={732-741},
  abstract={Objective: Diagnosis and follow-up of multiple myeloma (MM) patients involve analyzing full body positron emission tomography (PET) images. Toward assisting the analysis, there has been an increased interest in machine learning methods linking PET radiomics with survival analysis. Despite deep learning’s success in other fields, its adaptation to survival faces several challenges. Our goal is to design a deep learning approach to predict the progression-free survival (PFS) of MM patients from PET lesion images. Methods: we study three aspects of such deep learning approach: 1) Loss Function: we review existing and propose new losses for survival analysis based on contrastive triplet learning; 2) Pretraining: we conceive two pretraining strategies to cope with the relatively small datasets, based on patch classification and triplet loss embedding; and 3) Architecture: we study the contribution of spatial and channel attention modules. Results: our approach is validated on data from two prospective clinical studies, improving the c-index over baseline methods, notably thanks to the channel attention module and the introduced pretraining methods. Conclusion and Significance: we propose for the first time an end-to-end deep learning approach, M2P2, to predict the PFS of MM patients from PET lesion images. We introduce two contrastive learning approaches, never used before for survival analysis.},
  keywords={Censorship;Lesions;Deep learning;Adaptation models;Positron emission tomography;Plasmas;Medical diagnostic imaging;Contrastive learning;deep learning (DL);multiple myeloma (MM);PET imaging;pretraining;survival analysis},
  doi={10.1109/TRPMS.2023.3283562},
  ISSN={2469-7303},
  month={Sep.},}@INPROCEEDINGS{11453646,
  author={Y, Roshan Sanu and Prakash, N},
  booktitle={2026 8th International Conference on Intelligent Sustainable Systems (ICISS)}, 
  title={AI-Driven Digital Pathology for Automated Disease Detection and Diagnosis: A Comprehensive Survey of Machine Learning and Deep Learning Innovations}, 
  year={2026},
  volume={},
  number={},
  pages={1088-1094},
  abstract={Digital pathology has enabled scalable analysis of histopathological data through whole-slide imaging (WSI) and computational methods. Recent advances in artificial intelligence (AI) have significantly improved automated disease detection, grading, segmentation, and prognostic modelling from histological images. This paper presents a structured narrative survey of AI-driven approaches in digital pathology, covering traditional machine learning methods, convolutional neural networks, multiple instance learning, transformer-based architectures, and emerging self-supervised and foundation models. The survey distinguishes between patch-level and slidelevel evaluation paradigms, emphasizing their respective roles in model development and clinical decision-making. Public datasets, preprocessing techniques, and commonly used evaluation metrics are summarized to contextualize model benchmarking. Key clinical applications across major cancer types are reviewed, alongside critical challenges including data variability, annotation scarcity, interpretability, computational complexity, regulatory readiness, and environmental sustainability. The maturity of foundation models for clinical deployment and their carbon cost implications for routine pathology laboratories is discussed. Finally, future research directions toward efficient, interpretable, and clinically deployable AI systems are highlighted.},
  keywords={Surveys;Pathology;Foundation models;Computational modeling;Biological system modeling;Imaging;Predictive models;Transformers;Artificial intelligence;Cancer;Digital Pathology;Artificial Intelligence;Deep Learning;Whole-Slide Imaging;Computational Pathology;Cancer Diagnosis},
  doi={10.1109/ICISS67859.2026.11453646},
  ISSN={},
  month={March},}@ARTICLE{10529284,
  author={Qi, Huamei and Hu, Yuxuan and Fan, Ruohao and Deng, Lei},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Tab-Cox: An Interpretable Deep Survival Analysis Model for Patients With Nasopharyngeal Carcinoma Based on TabNet}, 
  year={2024},
  volume={28},
  number={8},
  pages={4937-4950},
  abstract={The nutritional status of cancer patients is closely associated with the clinical progression of the disease. A survival analysis model combined with a neural network can predict future disease trends in patients, facilitating early prevention and assisting physicians in making diagnoses. However, the complexity of neural networks and their incompatibility with medical tabular data can reduce the interpretability of the model. To address this issue, thr paper propose a novel survival analysis model called Tab-Cox, which combines TabNet and Cox models. This model is specifically designed to predict the survival outcomes of patients with nasopharyngeal carcinoma. The model utilizes TabNet's sequential attention mechanism to extract more interpretable features, providing an interpretable method for identifying disease risk factors. Consequently, the model ensures accurate survival prediction while also making the results more comprehensible for both patients and doctors. The paper tested the efficacy of the model by conducting experiments on various diverse datasets in comparison with other commonly used survival models. The results showed that the proposed model delivered the highest or second-highest accuracy across all datasets. Furthermore, the paper conducted a comparative interpretability analysis against the classical Cox model. In addition and compare the interpretability of the Tab-Cox model with the classical Cox model and discuss the advantages and disadvantages of its interpretability. This demonstrates that Tab-Cox can assist doctors in identifying risk factors that are challenging to capture using artificial methods.},
  keywords={Analytical models;Data models;Predictive models;Cancer;Hazards;Deep learning;Feature extraction;Survival analysis;disease prediction;machine learning algorithms},
  doi={10.1109/JBHI.2024.3397955},
  ISSN={2168-2208},
  month={Aug},}@INPROCEEDINGS{11491827,
  author={Rana, Humayan Kabir and Ahmed, Boshir},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={Computational Framework for Identifying Candidate Genes in Colorectal Cancer Using TCGA Data}, 
  year={2025},
  volume={},
  number={},
  pages={5217-5221},
  abstract={Colorectal cancer (CRC) is currently the second most common cause of cancer-related deaths worldwide, and its incidence continues to grow each year. Candidate gene identification is crucial for improving early diagnosis and guiding the development of new treatment strategies. Although several prior studies have attempted to uncover the candidate genes of CRC, but the results are so far insufficient, which underscores the need for further research in this area. In this study, a computational framework was developed to identify the candidate genes of CRC using The Cancer Genome Atlas (TCGA) dataset, applying the Wilcoxon rank-sum (WRS) test and the Benjamini-Hochberg (BH) method. Afterwards, the biological functions of the candidate genes were analyzed using signaling pathways, gene ontological pathways, and protein-protein interaction (PPI) network. The diagnostic potential of these genes was evaluated through ROC analysis. The proposed framework enabled us to identify 12 candidate genes, including CALB2, CAMK2B, COQ2, GRP, GSR, ING1, NPR3, PPAPDC1A, PPFIA4, SCG2, SOX11, and UCHL1, from a set of 20518 genes. A total of 11 signaling pathways, 13 ontological pathways, and a central hub gene were found as significant for CRC. In the ROC analysis, all candidate genes demonstrated good predictive performance, with CALB2 achieving the highest AUC of 93.91%. In fine, the findings of this study could contribute to disease management and provide a basis for future laboratory research aimed at identifying potential therapeutic targets for CRC treatment.},
  keywords={Filtering;Filters;Protocols;HTTP;Network topology;Electronic messaging;Internet;Instant messaging;Machine learning;Ontologies;Colorectal Cancer (CRC);Candidate genes of CRC;Key genes of CRC;Wilcoxon rank-sum test;Benjamini-Hochberg correction},
  doi={10.1109/ICCIT68739.2025.11491827},
  ISSN={2474-9656},
  month={Dec},}@INPROCEEDINGS{11258480,
  author={Abdulqader, Shahla A. and Saeed, Ali Q},
  booktitle={2025 3rd International Conference on Business Analytics for Technology and Security (ICBATS)}, 
  title={AI-Based Cancer Detection and Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Cancer is still acknowledged as one of the prime causes of death globally, which depicts the urgent need for timely identification and exact prediction for the betterment of patient outcomes. Artificial intelligence (AI) is one of the technologies, which has recently made tremendous breakthroughs turning the cancer diagnosis and prognosis scenario around with the help of enormous and multifarious biomedical datasets. The study at hand delves into AI techniques such as machine learning and deep learning, which are used for the detection and forecast of cancer. The employment of all data including medical images, genomics, and patient records' in the AI system could help the models to unveil meticulous and invisible to human search patterns. The principal methods applied such as convolutional neural networks (CNNs) for diagnostic imaging and ensemble learning for forecasting are brought up for discussion. Also, the data privacy issues, model interpretability constraints, and not less than clinical practice integration problems are dealt with. The outcome points out the revolutionizing power of AI in fostering the precision of the diagnostic process, facilitating the customization of the cure, and, consequently, uplifting the overall cancer treatment appearance. This paper provides a thorough framework of the latest AI-based biomedical technologies in oncology, thus allowing developing healthcare systems to be efficient and user-friendly.},
  keywords={Deep learning;Accuracy;Biological system modeling;Predictive models;Cancer detection;Turning;Data models;Convolutional neural networks;Cancer;Tumors;Cancer detection;AI applications;Machine learning;Deep learning;Predictive analytics},
  doi={10.1109/ICBATS66542.2025.11258480},
  ISSN={},
  month={May},}@INPROCEEDINGS{9761550,
  author={Amine Elforaici, Mohamed El and Montagnon, Emmanuel and Azzi, Feryel and Trudel, Dominique and Nguyen, Bich and Turcotte, Simon and Tang, An and Kadoury, Samuel},
  booktitle={2022 IEEE 19th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Semi-Supervised Tumor Response Grade Classification from Histology Images of Colorectal Liver Metastases}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Colorectal liver metastases (CLM) develop in almost half of patients with colon cancer. Response to systemic chemotherapy is the main determinant of patient survival. Due to the importance of assessing treatment response of CLM to chemotherapy for the patient prognosis, there is a need to classify tumor response grade (TRG) on histopathology slides (HPS). However, annotating HPS for training neural networks is a time-consuming task. In this work, we present an end-to-end approach for tissue classification of CLM slides leading to TRG prediction. A weakly-supervised model is first trained to perform tissue classification from sparse annotations, generating segmentation maps. Then, using features extracted for these maps, a secondary model is trained to perform the TRG classification. We demonstrate the feasibility of the proposed approach on a clinical dataset of 1450 HPS from 232 CLM patients by comparing our semi-supervised Mean Teacher approach with other supervised and semi-supervised methods. The proposed pipeline outperforms other models, achieving a classification accuracy of 94.4%. Based on the generated classification maps, the model is able to stratify patients into two TRG classes (1-2 vs 3-5) with an accuracy of 86.2%.},
  keywords={Training;Chemotherapy;Annotations;Histopathology;Biological system modeling;Pipelines;Liver;Colorectal cancer;deep learning;Mean Teacher;histopathology;semi-supervised learning;tumor regression grade},
  doi={10.1109/ISBI52829.2022.9761550},
  ISSN={1945-8452},
  month={March},}@INPROCEEDINGS{9870361,
  author={Delgado-Osuna, José A. and Garcia-Martinez, Carlos and Ventura, Sebastián},
  booktitle={2022 IEEE Congress on Evolutionary Computation (CEC)}, 
  title={Smart Operators for Inducing Colorectal Cancer Classification Trees with PonyGE2 Grammatical Evolution Python Package}, 
  year={2022},
  volume={},
  number={},
  pages={1-9},
  abstract={Colorectal cancer is a disease that affects many people and requires a multidisciplinary approach, involving significant human and economic resources. We have been provided with a tabular dataset with 1.5 thousand cases of this disease. We are interested in producing interpretable classifiers for predicting the occurrence of complications. Grammatical Evolution has extensively been used for machine learning problems. In particular, it can be used to induce interpretable decision trees, with the advantage of allowing the practitioner to easily control the language by means of the grammar. PonyGE2 [1], [2] is a Python package that provides data scientists with Grammatical Evolution algorithms, which can be configured to their needs quite easily. In addition, and thanks to the benefits of the Python programming language, PonyGE2 is currently becoming more and more popular. However, the capabilities of PonyGE2 for inducing classification trees are still subject of improvement. In particular, it only uses simple equality conditions and requires to encode feature names and values with numbers. We have developed some smart operators for PonyGE2, which, not only enhance the framework in interpretability and performance when dealing with our colorectal cancer dataset, but also allows to produce results comparable to those of the widely known heuristic methods C4.5 and CART. We show how they could be applied to other datasets, and how they affect performance in our case.},
  keywords={Machine learning algorithms;Machine learning;Evolutionary computation;Germanium;Classification algorithms;Grammar;Task analysis;Grammatical Evolution;Classification Trees;Heterogeneous features;Colorectal Cancer},
  doi={10.1109/CEC55065.2022.9870361},
  ISSN={},
  month={July},}@INPROCEEDINGS{10625334,
  author={Gurumoorthi, T and Logesh, P. and Ismail, N Mohamed and Malathi, K.},
  booktitle={2024 2nd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Enhanced Colorectal Cancer Detection and Localization Using Self-Attention Mechanisms in Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1589-1594},
  abstract={Colorectal cancer belongs to the top/top-ranked malignancies worldwide, ranking among the leading causes of cancer deaths. Hence, improved methods for detection and localization are required. The study presented here describes state-of-the-art methods to improve colorectal cancer detection and localization with self-attention in a Convolutional Neural Network framework. A method that can take advantage of CNN in feature extractions and further combine them with self-attention mechanisms capturing long-range dependencies and contextual information across medical images makes ours very effective in highlighting subtle features and intricate patterns characteristic of CRC often overlooked by conventional methods. Such is the architecture of the proposed CNN, carefully designed to overcome specific challenges in colorectal tissue analysis: tissue heterogeneity and varying appearance of cancerous regions. This self-attention module, therefore, enhances the accuracy and robustness of cancer detection and localization. The proposed approach has been evaluated on an overall dataset of medical images of a colorectal nature and outperformed existing state-of-the-art methods.},
  keywords={Location awareness;Training;Adaptation models;Accuracy;Sociology;Colorectal cancer;Feature extraction;Colorectal cancer;detection;localisation;self-attention mechanisms;deep learning},
  doi={10.1109/ICSCSS60660.2024.10625334},
  ISSN={},
  month={July},}@INPROCEEDINGS{11589952,
  author={T, Jaya Priya and C M, Kalaiarasi and S, Meena},
  booktitle={2026 International Conference on Computer Networks and Inventive Communication Technologies (ICCNCT)}, 
  title={Dual - Model Explainable AI Framework for Early Detection of Periampullary Carcinoma using ResNet50 and XGBoost}, 
  year={2026},
  volume={},
  number={},
  pages={1362-1367},
  abstract={Periampullary carcinoma is a critical cancer condition, where timely diagnosis can significantly improve survival rates. Nevertheless, diagnosing this type of cancer through clinical data and histopathological images is difficult because of complicated anatomy and varying characteristics of tumors. This paper presents a novel approach for periampullary carcinoma detection through a two model explainable artificial intelligence architecture. The proposed framework includes a deep learning model and machine learning model to analyze both image-based and clinical information. The pre-trained ResNet50 model is applied for extracting features and classifying histopathological images, whereas XG Boost classifier is utilized to predict cancer according to clinical parameters. In order to increase interpretability, explainable AI techniques, namely Grad-CAM and SHAP, are introduced, where Grad-CAM highlights significant areas of the image, and SHAP reveals the importance of clinical factors. Experimentation results confirm high efficiency and applicability of the suggested solution.},
  keywords={Modeling;Cancer;Deep learning;Accuracy;Biomedical imaging;Artificial intelligence;Training;Cams;Computer aided manufacturing;Signal detection;Periampullary carcinoma;ResNet50;XG Boost;Explainable AI;SHAP;Grad-CAM;Medical image analysis},
  doi={10.1109/ICCNCT68477.2026.11589952},
  ISSN={},
  month={May},}@ARTICLE{10158019,
  author={Qi, Shi-ang and Kumar, Neeraj and Verma, Ruchika and Xu, Jian-Yi and Shen-Tu, Grace and Greiner, Russell},
  journal={IEEE Transactions on Biomedical Engineering}, 
  title={Using Bayesian Neural Networks to Select Features and Compute Credible Intervals for Personalized Survival Prediction}, 
  year={2023},
  volume={70},
  number={12},
  pages={3389-3400},
  abstract={An Individual Survival Distribution (ISD) models a patient's personalized survival probability at all future time points. Previously, ISD models have been shown to produce accurate and personalized survival estimates (for example, time to relapse or to death) in several clinical applications. However, off-the-shelf neural-network-based ISD models are usually opaque models due to their limited support for meaningful feature selection and uncertainty estimation, which hinders their wide clinical adoption. Here, we introduce a Bayesian-neural-network-based ISD (BNN-ISD) model that produces accurate survival estimates but also quantifies the uncertainty in model's parameter estimation, which can be used to (1) rank the importance of the input features to support feature selection and (2) compute credible intervals around ISDs for clinicians to assess the model's confidence in its prediction. Our BNN-ISD model utilized sparsity-inducing priors to learn a sparse set of weights to enable feature selection. We provide empirical evidence, on 2 synthetic and 3 real-world clinical datasets, that BNN-ISD system can effectively select meaningful features and compute trustworthy credible intervals of the survival distribution for each patient. We observed that our approach accurately recovers feature importance in the synthetic datasets and selects meaningful features for the real-world clinical data as well, while also achieving state-of-the-art survival prediction performance. We also show that these credible regions can aid in clinical decision-making by providing a gauge of the uncertainty of the estimated ISD curves.},
  keywords={Computational modeling;Feature extraction;Predictive models;Uncertainty;Bayes methods;Hazards;Estimation;Machine learning;Bayes methods;Precision medicine;Life estimation;Machine Learning;Bayesian neural networks;credible intervals;feature selection;precision medicine;survival analysis},
  doi={10.1109/TBME.2023.3287514},
  ISSN={1558-2531},
  month={Dec},}@ARTICLE{10506496,
  author={Lima, Débora V. C. and Terrematte, Patrick and Stransky, Beatriz and Neto, Adrião D. D.},
  journal={IEEE Access}, 
  title={An Integrated Data Analysis Using Bioinformatics and Random Forest to Predict Prognosis of Patients With Squamous Cell Lung Cancer}, 
  year={2024},
  volume={12},
  number={},
  pages={59335-59345},
  abstract={Lung cancer is the leading cause of cancer death worldwide, regardless of gender. Among the types of lung cancer, Lung Squamous Cell Carcinoma (LUSC) is the second most common type, characterized by a diagnosis in advanced stages, a poor prognosis, and a high association with smoking. Due to the severity of lung cancer, it is essential to understand its molecular mechanisms. In this context, this study uses transcriptomic and clinical data to implement bioinformatics pipelines, and machine learning, through random forest models to predict patients’ overall survival and obtain a gene signature of LUSC for tumor progression. We analyzed clinical and molecular data from the project LUSC-TCGA, and we performed differential expression analyses (DEA) comparing normal tissues against tumor tissues. Based on DEA-selected genes, the patients were divided into three clusters, followed by a feature selection and classification. Finally, it was possible to obtain classifications results close to 70% of accuracy for the three clusters. Finally, we also performed a functional enrichment analysis. The clustering analysis revealed in cluster 2, enriched genes such as CDT1, CENPI, and NLGN1, associated with the molecular EMT (epithelial-to-mesenchymal transition) process. Our approach facilitated the identification of genes that are biologically relevant to the LUSC development process, holding significant genes for predicting patient survival, such as gene ALDH3B1, C7, FAM83A, FOSB, GCGR, BMP7, PPP1R27 and AQP1, and putative therapeutic targets for LUSC such as gene FAM83A, CAV1, TNS4, EIF4G1, TFAP2A, GCGR and PPP1R27.},
  keywords={Cancer;Bioinformatics;Random forests;Tumors;Lung cancer;Feature extraction;Transcriptomics;Machine learning;Prognostics and health management;Predictive models;Gene signature;lung cancer;machine learning;random forest;survival analysis},
  doi={10.1109/ACCESS.2024.3392277},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11650509,
  author={Mahaboobbasha, Shaik. and Biswas, Balaka},
  booktitle={2026 International Conference on Circuit, Systems and Communication (ICCSC)}, 
  title={Decoding the Tumor Microenvironment: The Role of Machine Learning in Early Cancer Detection and Diagnostic Precision}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Cancer remains one of the foremost causes of global mortality, with late-stage diagnosis continuing to undermine survival rates across multiple malignancies. The convergence of machine learning (ML) and oncological diagnostics represents one of the most consequential frontiers in contemporary biomedical research. This review examines the application of ML methodologies encompassing deep learning, convolutional neural networks (CNNs), and ensemble methods in the early detection of cancer across imaging, genomic, and liquid biopsy domains. We trace the evolution of computer-aided diagnosis from its rule-based origins in the 1980s through to the transformer-based multimodal architectures dominating the present landscape. Recent landmark studies are critically assessed, including FDA-cleared AI diagnostic tools for mammography, lung nodule detection in low-dose CT scans, and ML-driven analysis of circulating tumor DNA (ctDNA). The review further interrogates persistent challenges: dataset bias, model opacity, regulatory bottlenecks, and generalization failures. Explainability frameworks such as SHAP and Grad-CAM are examined as bridges between algorithmic output and clinician trust. Finally, we survey the trajectory of the field federated learning, foundation models, and AI-pathology integration arguing that realizing the full promise of ML in early cancer detection requires coordinated advances in data governance, interdisciplinary collaboration, and equitable deployment.},
  keywords={Modeling;Cancer;Artificial intelligence;Cancer detection;Machine learning;Biopsy;Breast cancer;Deep learning;Signal detection;Training;machine learning;deep learning;early cancer detection;convolutional neural networks;liquid biopsy;explainable AI;precision medicine;federated learning;computational pathology;multi-cancer early detection},
  doi={10.1109/ICCSC71566.2026.11650509},
  ISSN={},
  month={July},}@INPROCEEDINGS{11320588,
  author={Regmi, Prasiddha and Verma, Somraj and Rani, Samta},
  booktitle={2025 International Conference on Digital Innovations for Sustainable Solutions (ICDISS)}, 
  title={Analysis 10-Year Cancer Trends: Identifying Key Types with Clustering}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Although medicine has come a long way but cancer is still one of the top causes of death in the world. Many researchers research has been conducted to understand the relationship between different cancer types and their impact. However, this study is focus on analyzing the cancer mortality rates across various different countries without suggesting any mitigation strategies. Traditional method may cause high cost, potential error, and Restricted Accessibility. Cancer is a complex and dangerous disease with tumor characteristics which varying across their types and individuals. This paper also discusses the importance of machine learning in cancer research and analyzes the cancer mortality data over the past decade to identify the most prevalent cancer types. However, This paper analyzes both 10 years of global mortality data and related cancer prediction studies which makes it distinct its approach.},
  keywords={Technological innovation;Stomach;Computational modeling;Mortality;Medical services;Market research;Cancer detection;Cancer;Tumors;Testing;cancer;mortality rate;cancer types;personalized medicine;machine learning;genetic profiles;treatment},
  doi={10.1109/ICDISS68238.2025.11320588},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11559528,
  author={Kumar, Pardeep and Mathur, Robin Prakash and Kaur, Harshpreet and Bajaj, Karan and Kondapalli, Pravallika},
  booktitle={2026 4th International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)}, 
  title={An Explainable Digital Twin Framework with GAN-Based Data Augmentation for Energy-Efficient Colon Cancer Histopathology Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={236-243},
  abstract={Colon cancer can be considered as the cause of the most significant cancer fatalities across the globe, and early and correct diagnosis based on histopathological images is the simple solution to ensure that the patients from their side of the point live. Nonetheless, the diagnostic systems developed on the base of deep learning generally struggle with the lack of annotated data, class imbalance, lack of interpretability, or excessive consumption of computational energy. To overcome these weaknesses, an Explainable Digital Twin Framework (EDTF) will be proposed in this paper, which combines data augmentation based on the GANs, deep convolutional neural networks, the explainable AI mechanism, and Green AI assessment to efficiently and reliably analyze colon cancer histopathology. The suggested framework will use a Generative Adversarial Network (GAN) to produce natural synthetic histopathology images, which will widen the range of datasets and boost the classification accuracy. Deep CNN models have been trained on the augmented data such MobileNetV2, DenseNet121, and ResNet50. Digital Twin simulation layer allows predicting diagnostics in real-time and tracking this, which allows to future deploy the innovation in clinical practice. To achieve interpretability, both Grad-CAM and SHAP methods are combined to give both visual and feature explanations of model predictions. In addition, Green AI module uses a premise of assessing computational efficiency considering energy usage, inference time, and a Normalized Energy Score (NES). Experiments with LC25000 data have shown that the LTF proposed exhibits much better classification, with up to 98.9% accuracy, and uses less energy than other baseline models. The framework gives out clinically meaningful explanations also and promotes real-time digital twin simulation thus a strong and stable solution of intelligent cancer diagnosis. The suggested solution will overcome the main shortcomings of current medical AI tools by integrating accuracy, interpretability, and energy efficiency into one architecture.},
