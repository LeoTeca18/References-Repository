  booktitle={2024 2nd International Conference on Artificial Intelligence and Machine Learning Applications Theme: Healthcare and Internet of Things (AIMLA)}, 
  title={Oral Cancer Detection Using Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={With a high death rate, oral cancers are widespread, complicated tumors. In addition to screening procedures, other methods for diagnosing oral cancer include biopsy, which entails removing a small sample of tissue from a part of the body and analyzing it under a microscope. By utilizing feature extraction and deep learning techniques, this study presents a strong diagnostic approach for the identification of oral cancer. For early diagnosis and categorization, modern technologies and a deep learning algorithm can be used. Employing the advanced EfficientNet architecture known for its efficacy in image processing tasks, our deep learning model capitalizes on this efficiency. The model is fine-tuned through transfer learning, utilizing pretrained weights to expedite convergence. This fusion of deep learning and feature extraction, particularly harnessing the capabilities of EfficientNet, showcases the potential of cutting edge technology in advancing oral cancer diagnostics. Utilizing these tools enables precise detection, enabling early intervention and potentially improving patient outcomes in the realm of healthcare.},
  keywords={Deep learning;Biological system modeling;Transfer learning;Medical services;Computer architecture;Feature extraction;Cancer detection;Oral cancer Detection;Advanced Deep Learning Models;EfficientNet Architecture;Feature Extraction Techniques},
  doi={10.1109/AIMLA59606.2024.10531555},
  ISSN={},
  month={March},}@ARTICLE{11265863,
  author={Prunella, Michela and Altini, Nicola and D’Alessandro, Rosalba and Schirizzi, Annalisa and De Leonardis, Giampiero and Arborea, Graziana and Savino, Maria Teresa and Valentini, Anna Maria and Armentano, Raffaele and Ricci, Angela Dalia and Lotesoriere, Claudio and Carli, Raffaele and Dotoli, Mariagrazia and Giannelli, Gianluigi and Bevilacqua, Vitoantonio},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Automated Pathomic Analysis of Angiogenesis and Immune Profiles Unveils an Interpretable Prognostic Biomarker in Colon and Gastric Cancers}, 
  year={2026},
  volume={30},
  number={8},
  pages={7218-7231},
  abstract={Computational pathology enables the automatic tissue analysis of Whole Slide Images (WSIs), offering unmatched possibilities to capture quantitative tumor microenvironment (TME) characteristics that are essential for patients’ prognosis and therapy response. The existing clinical and digital biomarkers do not encompass the morphometric features and spatial interactions between vascular networks and immunological compartment in the TME. To address this challenge, this work presents a high-throughput quantitative framework for automatic segmentation and assessment of aberrant phenotypes of blood vessels and immune cell clusters in hematoxylin & eosin-stained WSIs, to construct the Vascular-Immune Pathomic (VIPath) biomarker. For our study, we utilized three public datasets of Colon Adenocarcinoma (COAD) and Stomach Adenocarcinoma (STAD) from The Cancer Genome Atlas (TCGA) and Clinical Proteomic Tumor Analysis Consortium (CPTAC) projects: TCGA-COAD, TCGA-STAD, and CPTAC-COAD. Additionally, we collected two in-house gastric cancer cohorts of 80 and 51 patients: DBGC-M0 and DBGC-M1. The VIPath biomarker was incorporated in a Cox proportional hazards model trained on the TCGA-COAD. Then, it was validated for predicting Overall Survival (OS) in TCGA-STAD, DBGC-M0, and DBGC-M1, Disease Free Survival in CPTAC-COAD and second-line therapy Progression-free Survival (PFS-2) in DBGC-M1. VIPath encompasses features from both vascular and immunological compartments interacting in the TME. Results proved that VIPath was capable to significantly stratify risk groups for OS TCGA-STAD (p=0.018), OS DBGC-M0 (p = 0.029), OS DBGC-M1 (p = 0.014), and PFS-2 DBGC-M1 (p<0.005). Furthermore, when inserted in a Cox model, it led to an improvement of C-index and R2 over all other considered prognostic factors, i.e., p-TNM, ECOG, MSI, HER2.},
  keywords={Feature extraction;Immune system;Cancer;Tumors;Surgery;Bioinformatics;Biopsy;Training;Pathology;Biological system modeling;Clinical decision support system;image segmentation;survival prediction;whole slide image;tumor microenvironment},
  doi={10.1109/JBHI.2025.3625431},
  ISSN={2168-2208},
  month={Aug},}@INPROCEEDINGS{11436779,
  author={A, Kavitha and S, Naveen Kumar and Y, Mayilan},
  booktitle={2025 2nd Asian Conference on Intelligent Technologies (ACOIT)}, 
  title={Cross-Domain Transfer Learning and Self-Distillation in Histopathological Image Analysis for Automated Colorectal Cancer Grading}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={CRC is one of the most prevalent forms of malignancy throughout the whole world, accompanied by both high morbidity and mortality rates. Optimal grading of histopathological images is certain to improve patient outcomes. The automated deep learning for the diagnosis of CRC is proposed to minimize the use of human supervision. It includes cross-domain transfer learning, domain adaptation, and self-distillation for the enhancement of classification performance in the framework. Since histopathological images are not homogeneous since they are stained, and data there commonly lacks any labeling, preprocessing such as stain normalization and picture improvement are used. Convolutional Neural Networks e.g. ResNet-50, Xception, and EfficientNet are optimized on large histopathological data and then on cancer samples on CRC against progressive layer unfreezing.In order to further increase the extent of generalization and reduce the influence of label noise, The model has been adopted a strategy of self-distillation, in which the model has been trained student models on soft targets generated by teacher networks.Domain adaptation is done using the Maximum Mean Discrepancy (MMD) method, and adversarial adolescent learning with Gradient Reversal Layers (GRL), thus reducing the gap between source and target domain distribution features. Ulti-level attention model, which is Squeeze-and-Excitation (SE) and Shuffle Attention (SA), is utilized to lock into key regions of tumors and core structures. The final classification point uses dense layers with focal loss and ReLU activation, which therefore deals with the problem of class imbalance effectively. The dataset is 1,186 samples, including 514 controls and 672 case samples, though, there were significant results involving people who had been diagnosed with CRC at the age below 50. The laboratory findings exhibit that the suggested model complements feature extraction, resolves generalization, and assists in making clinical decisions. The model has got a lot of potential in its capability to identify early-stage colorectal cancer and make individualized treatment choices.},
  keywords={Deep learning;Adaptation models;Sensitivity;Transfer learning;Colorectal cancer;Predictive models;Data models;Robustness;Prognostics and health management;Tumors;Cross Domain;Transfer Learning;Efficient Net;Self Distillation;Histopathological Images},
  doi={10.1109/ACOIT66109.2025.11436779},
