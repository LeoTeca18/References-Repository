  month={Oct},}@INPROCEEDINGS{11644517,
  author={La’by, Joel Edward Arung and Arasy, Dustin Bijou and Widjaja, Shamgar Eugene T’sidkenu and Diana},
  booktitle={2026 International Conference on Advancement in Data Science, E-learning and Information System (ICADEIS)}, 
  title={Prediction of Gallstone Disease Using Interpretable, Probabilistic, and Deep Learning Models for Tabular Data}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Gallstone disease is characterized by the formation of hardened gallstones in the gallbladder. Early detection of gallstones is crucial to prevent complications in the biliary tract. Although recent studies have demonstrated impressive results, there is a clinical adoption gap in non-imagebased detection due to lack of model interpretability. Although conventional machine learning approaches have demonstrated impressive results, they are based entirely on discriminative performance. In this study, various appropriate models are evaluated using 319 patient data. These models are: EBM, XGBoost, NGBoost, TabPFN, and TabTransformer. The discriminative performances of these models are evaluated using sensitivity, specificity, and AUROC. In addition, model interpretability and uncertainty are integrated into these approaches to improve model transparency. The results revealed that XGBoost had the highest discriminative sensitivity of 0.847, while TabPFN had the highest discriminative specificity of 0.869. EBM had balanced performance across all metrics. The top 3 models achieved AUROC values ranging from 0.88 to 0.91. Feature importance analysis was carried out on the top-performing approaches using rank-based normalization after 10 iterations. The results revealed that Creactive protein had a unanimous rank 1 in all three approaches, followed by vitamin D and obesity (%). This implies that systemic inflammation was more significant in predicting gallstones than liver function tests. In addition, body composition metrics were equally important in predicting gallstone occurrences. However, NGBoost provided uncertainty estimates with a Brier score of 0.17 and mean $\sigma$ of 0.29, although it had relatively lower discriminative performance. These results indicate that integrating model interpretability into AI approaches does not compromise model performance. Instead, these approaches remain viable options for non-image-based gallstone screening.},
  keywords={Modeling;Machine learning;Machining;Printing;Diseases;Uncertainty;Sensitivity;Ranking (statistics);Testing;Boosting;gallstone disease;gradient boosting trees;interpretable machine learning;permutation feature importance;SHAP;tabular deep learning},
