  number={},
  pages={516-520},
  abstract={The integration of Convolutional Neural Networks (CNNs) into histopathology promises to revolutionize diagnostics, yet their vulnerability to adversarial attacks poses a significant risk to clinical deployment. This study investigates the relationship between CNN architecture, performance, and adversarial robustness. We benchmarked five distinct architectures (VGG16, ResNet-50, MobileNetV3-Large, EfficientNet-B4, and ConvNeXt-Tiny) on the PathMNIST dataset for classification accuracy, efficiency, and robustness against both Projected Gradient Descent (PGD) and Fast Gradient Sign Method (FGSM) attacks. Our results, averaged over five runs, show that while ConvNeXt-Tiny achieved the highest clean accuracy (93.07% ± 0.88%), its performance collapsed under low-strength attacks. Adversarial training significantly enhanced resilience, maintaining 62.14% ± 0.65% accuracy under a PGD attack that reduced the standard model's accuracy to nearly zero. This highlights a critical trade-off between standard accuracy and adversarial robustness, underscoring the need to evaluate models for both safety and reliability before clinical adoption.},
  keywords={Training;Accuracy;Histopathology;Performance metrics;Robustness;Safety;Convolutional neural networks;Standards;Image classification;Resilience;Convolutional Neural Networks;CNN;Histopathology;Adversarial Robustness;Adversarial Training;Medical Imaging;Image Classification},
  doi={10.1109/ICBME68496.2025.11392428},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11688554,
  author={Kiran, Vege Hari and Babu, T. R. Ganesh},
  booktitle={2026 7th International Conference On Computational Vision and Bio Inspired Computing (ICCVBIC)}, 
  title={A Novel Hybrid Swin-TransUNet with Adaptive Frequency-Domain Preprocessing for Early Multi-Class Cancer Detection}, 
  year={2026},
  volume={},
  number={},
  pages={381-387},
  abstract={Cancer continues to be among the most important global health challenges, accounting for millions of deaths annually and emphasizing the need for accurate and early diagnosis. Advances in medical imaging and artificial intelligence have created new opportunities for improving cancer detection; however, existing deep learning models often struggle to simultaneously capture local tissue characteristics, global contextual information, and spatial relationships among lesions. To address these limitations, this study proposes a novel Hybrid Swin-TransUNet with Adaptive Frequency-Domain Preprocessing (Swin-TransUNet-AFDP) framework for automated multi-class cancer detection from medical images. The proposed framework incorporates an Adaptive Retinexbased Frequency Enhancement (ARFE) module that enhances diagnostically relevant high-frequency lesion textures while reducing illumination variations, staining inconsistencies, and acquisition noise. A dual-path Swin Transformer encoder combines convolutional neural networks and hierarchical selfattention mechanisms to effectively learn both local and global image representations. Furthermore, a dense cross-attention decoder enables precise lesion segmentation and boundary localization, while a GCN-XGBoost ensemble classifier exploits graph-based spatial tissue relationships for robust cancer classification. Experimental evaluations conducted on the BreakHis and LC25000, benchmark datasets demonstrate outstanding performance, achieving classification accuracy of up to 99.4%. The outcomes validate the, generalization capability, and potential suitability for real-world clinical decision-support systems and early cancer diagnosis applications.},
  keywords={Modeling;Equations;Transformers;Biological tissues;Lesions;Cancer;Convolutional neural networks;Frequency-domain analysis;Printing;Accuracy;CancerDetection;SwinTransformer;TransUNet;Adaptive Frequency-Domain Preprocessing (AFDP);GCN-XGBoost Ensemble Classification},
  doi={10.1109/ICCVBIC71195.2026.11688554},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10984551,
  author={Kotnala, Anushka and Baraily, Smriti and Lathwal, Anjali},
  booktitle={2025 IEEE International Conference on Interdisciplinary Approaches in Technology and Management for Social Innovation (IATMSI)}, 
  title={Digital Twin Models for Enhanced Predictive Analysis and Treatment Optimization in Breast Cancer}, 
  year={2025},
  volume={3},
  number={},
  pages={1-6},
  abstract={Breast cancer ranks as the second most concerning cause of death for women worldwide, with an expected 2.3 million new cases by 2024. The disease’s development involves a mix of genetic mutations, hormonal elements, and environmental factors. Existing treatment methods struggle to address individual variations and the complexity of each case, underscoring the demand for new solutions. Digital twin technology emerges as a promising avenue to boost cancer detection, therapy, personalized medicine, and treatments by constructing an accurate digital replica of a patient’s body. By amalgamating genetic, biochemical, and lifestyle data, digital twins could assist in safe diagnoses and tailor-made treatment plans. Progress in math, computer science, and experimental technology has propelled the usability of digital twins in cancer research areas, enhancing virtual experiments, treatment accessibility, and patient empowerment. This review delves into the potential of digital twin technology in revolutionizing the management of breast cancer, emphasizing the significance of real-time data and simulation techniques for the broader audience’s awareness with the dawn of a new medical era, leveraging digital twins in cancer care holds increasing importance in enhancing patient outcomes.},
  keywords={Costs;Precision medicine;Breast cancer;Digital twins;Complexity theory;Artificial intelligence;Usability;Medical diagnostic imaging;Tumors;Testing;Breast Cancer;Treatment;Personalized Medicine;Simulation Techniques;Digital Twin},
