  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Supervised Optimal Chemotherapy Regimen Based on Offline Reinforcement Learning}, 
  year={2022},
  volume={26},
  number={9},
  pages={4763-4772},
  abstract={In recent years, reinforcement learning (RL) has achieved a remarkable achievement and it has attracted researchers’ attention in modeling real-life scenarios by expanding its research beyond conventional complex games. Prediction of optimal treatment regimens from observational real clinical data is being popularized, and more advanced versions of RL algorithms are being implemented in the literature. However, RL-generated medications still need careful supervision of expertise parties or doctors in healthcare. Hence, in this paper, a Supervised Optimal Chemotherapy Regimen (SOCR) approach to investigate optimal chemotherapy-dosing schedule for cancer patients was presented by using Offline Reinforcement Learning. The optimal policy suggested by the RL approach was supervised by incorporating previous treatment decisions of oncologists, which could add clinical expertise knowledge on algorithmic results. Presented SOCR approach followed a model-based architecture using conservative Q-Learning (CQL) algorithm. The developed model was tested using a manually constructed database of forty Stage-IV colon cancer patients, receiving line-1 chemotherapy treatments, who were clinically classified as ‘Bevacizumab based patient’ and ‘Cetuximab based patient’. Experimental results revealed that the supervision from the oncologists has considered the effect to stabilize chemotherapy regimen and it was suggested that the proposed framework could be successfully used as a supportive model for oncologists in deciding their treatment decisions.},
  keywords={Chemotherapy;Q-learning;Cancer;Drugs;Schedules;Heuristic algorithms;Prediction algorithms;Cancer chemotherapy;expert supervision;offline reinforcement learning;optimal drug schedule},
  doi={10.1109/JBHI.2022.3183854},
  ISSN={2168-2208},
  month={Sep.},}@INPROCEEDINGS{9731006,
  author={Hong, Siyi},
  booktitle={2021 3rd International Conference on Machine Learning, Big Data and Business Intelligence (MLBDBI)}, 
  title={Multi-task Learning Based on Multiple Data Sources for Cancer Detection}, 
  year={2021},
  volume={},
  number={},
  pages={486-491},
  abstract={Histopathologic cancer detection aims to detect cancer by identifying metastatic tissue in histopathologic scans. Compared with manual detection, machine learning based methods can eliminate the influence of subjective factors, thereby improving the accuracy and efficiency of cancer detection. Existing methods either focus on the improvement of network structure or add prior knowledge to the model. However, both methods are task related, thus failing to apply them to other medical image classification datasets. We propose a multi-task learning method based on multiple data sources. During training, the model can learn the shared knowledge of each task, thereby improving the generalization performance. In this way, the proposed model can partly alleviate the data sparsity problem, improving the performance on low-resource benchmarks. We apply this method to the PCam dataset, which improves the recall rate by 0.6% and reduces the misdiagnosis rate by 0.3%.},
  keywords={Soft sensors;Machine learning;Predictive models;Cancer detection;Multitasking;Feature extraction;Data models;Image Classification;Cancer Detection;Multi-task Learning},
  doi={10.1109/MLBDBI54094.2021.00099},
