  author={Salvi, Rupali and Sharma, Suresh Kumar and Shama, Babli and Kale, Shubhada and Bansal, Aayushi},
  booktitle={2025 IEEE 5th International Conference on ICT in Business Industry & Government (ICTBIG)}, 
