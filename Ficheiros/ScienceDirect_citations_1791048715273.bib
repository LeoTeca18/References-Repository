@article{EDA2026114429,
title = {Artificial intelligence in healthcare: A comprehensive survey on AI-driven diagnosis and patient monitoring},
journal = {Applied Soft Computing},
volume = {190},
pages = {114429},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114429},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017429},
author = {Jerina Eda and Tamador Mohaidat and Samiul Islam Niloy and Zhiqi Niu and Md rahat Kader Khan and Kasem Khalil},
keywords = {Artificial intelligence, Machine learning, Supervised learning, Unsupervised learning, Internet of medical things (IoMT), Feature selection, Medical image analysis, AI-powered patient monitoring, Medical data processing, Internet of things},
abstract = {Artificial Intelligence (AI) is reshaping modern healthcare, driven by interconnected medical devices and scalable computing resources such as cloud-based Tensor Processing Units (TPUs). This survey provides a comprehensive overview of AI applications across major healthcare domains, with a focus on disease diagnosis, patient monitoring, medical image analysis, and clinical decision support. We examine four prevalent conditions(selected as they are leading NCDs per WHO, causing 75% of global deaths, allowing in-depth analysis on high-impact areas with ample data), chronic kidney disease, diabetes mellitus, cardiovascular disease, and cancer, and analyze how supervised and unsupervised learning algorithms have been adapted to heterogeneous medical data, including Electronic Health Records (EHRs), Magnetic Resonance Imaging (MRI) scans, laboratory tests, and IoMT signals. A comparative assessment of methods highlights the strengths of ensemble and deep learning approaches, which consistently outperform traditional techniques, with several models achieving predictive accuracies above 95%. The review also summarizes preprocessing strategies, feature selection methods, and evaluation metrics used to validate performance. Key trends include the adoption of multimodal data fusion and the growing emphasis on explainability for clinical acceptance. Despite these advances, challenges remain in addressing data privacy, algorithmic bias, and seamless integration with clinical workflows. We conclude by identifying open challenges such as data privacy, bias, and workflow integration, and emphasize AI’s potential to advance diagnostic precision, personalized treatment, and real-time patient care. By consolidating findings across diverse medical domains, this study provides both a roadmap for researchers and a benchmark for advancing AI integration into clinical practice.}
}
@article{ALQUDAH2026133064,
title = {A systematic review of machine learning for digital stain processing in pathology},
journal = {Neurocomputing},
volume = {676},
pages = {133064},
year = {2026},
issn = {0925-2312},
doi = {https://doi.org/10.1016/j.neucom.2026.133064},
url = {https://www.sciencedirect.com/science/article/pii/S0925231226004613},
author = {Rabiah Al-Qudah and Abubakar Bala and Mrouj Almuhajri and Khiati Zakaria and Ching Y. Suen},
keywords = {Digital pathology, Generative adversarial networks, Machine learning, Survey, Virtual staining},
abstract = {Digital staining involves using methods such as Machine Learning (ML) to replace chemical staining in pathology. Staining adds contrast that makes cell details more visible under the microscope. However, chemical methods are slow, use toxic reagents, and require skilled personnel. In contrast, digital staining can generate images faster, reduce the need for reagents and specialized equipment, and minimize plastic and chemical waste, making the workflow more sustainable. This paper systematically reviews papers published on ML-based digital stain processing. We propose a new taxonomy that divides existing studies into five groups: stain normalization, stain augmentation, virtual staining, stain transformation, and hybrid approaches. In addition, we observed several trends from the reviewed papers. Finally, we outline open research directions.}
}