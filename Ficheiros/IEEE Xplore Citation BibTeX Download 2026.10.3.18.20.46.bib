  booktitle={2026 14th International Conference on Bioinformatics and Computational Biology (ICBCB)}, 
  title={Secondary Cancer Risk Detection Using Genetic Markers: A Hybrid Approach With K-Nearest Neighbors, Random Forest, and Logistic Regression}, 
  year={2026},
  volume={},
  number={},
  pages={122-128},
  abstract={Secondary cancer remains one of the leading causes of mortality among cancer survivors, with early cancer detection being a persistent issue in the field of oncology. To address this, the researchers developed a machine learning framework to predict secondary cancer risk utilizing genetic markers. Three hybrid architectures were evaluated using Breast Invasive Carcinoma and Skin Cutaneous Melanoma datasets: Random Forest-K-Nearest Neighbors (RF-KNN), Random Forest with Logistic Regression (RF-LogReg), and KNN with Logistic Regression (KNN-LogReg), with Synthetic Minority Oversampling Technique (SMOTE) and a 10-fold cross-validation incorporated to address class imbalance. Results identified RF-LogReg as the best-performing architecture. For the melanoma cohort, it achieved a test accuracy of 81% and a test F1-score of 0.81, with TTN and MUC16 identified as key gene mutations in both primary and metastatic cases. In contrast, data scarcity limited the Breast Cancer set to a test accuracy of only 46%. Although statistical analysis revealed no statistical significance nor improvement in model performance, the RF-Logreg model remains the superior model due to its overall stability and lower variance compared to the baseline and stacking models. The researchers concluded that integrating probability-based linear classifiers along with ensemble feature selection enhances overall predictive reliability in genetic marker analysis, with the RF-LogReg pipeline being the recommended model for confirmatory risk assessment.},
  keywords={Modeling;Radio frequency;Breast cancer;Cancer;Tumors;Melanoma;Testing;Accuracy;Logistic regression;Random forests;Metastasis;Genetic Markers;Random Forest;K-Nearest Neighbors;Logistic Regression},
