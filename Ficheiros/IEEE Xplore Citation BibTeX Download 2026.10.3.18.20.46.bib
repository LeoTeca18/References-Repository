  number={},
  pages={328-333},
  abstract={The steady growth of the global older population represents a major success of modern medicine and public health, but it also introduces new challenges in managing agerelated health issues. Older adults are particularly exposed to infections, chronic diseases, and sleep disturbances, which can significantly impact their quality of life. To better understand and manage these issues, especially sleep and activity patterns, actimetry can be a valuable tool. It employs a small device, an actigraph, to track movement and rest over time. It’s a simple and painless way to spot small changes in the body that might show early signs of health problems. This study investigates the relationship between actimetry data and various infectious diseases across different age groups, with the goal of applying these findings to improve health monitoring in older adults. By reviewing scientific literature and case studies, we explore how actimetry can offer early insights into the onset, progression, and recovery of infectious illnesses. Particular attention is given to contexts such as the monitoring of patients in intensive care units (ICUs) suffering from Sepsis, individuals living with Human Immunodeficiency Virus (HIV), and those affected by the neurological impacts of Tick-borne Encephalitis (TBE). The study also considers how inflammation and immune responses influence sleep and activity patterns, helping to highlight actimetry’s potential for managing infection-related health issues in the elderly.},
  keywords={Infectious diseases;Tracking;Immune response;Surveillance;Sepsis;Human immunodeficiency virus;Circadian rhythm;Older adults;Wearable devices;Public healthcare;Actimetry;Activity patterns;Circadian rhythm;Disease progression;Elderly;Health monitoring;Infectious diseases;Immune response;Sleep disturbances;Sleep/wake phases;Wearable devices},
  doi={10.1109/STA66620.2025.11365013},
  ISSN={2573-539X},
  month={Dec},}@INPROCEEDINGS{11088565,
  author={Vanaja and Saidala, Ravi Kumar and Radder, Umesharaddy and T, Varalakshmi and Rohit, Nisha Robin and Arunagiri, Bhuvaneswari},
  booktitle={2025 11th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={Improved Cancer miRNA Biomarker Classification through Adaptive Multi-Resolution Temporal Attention Network (AMRTA Net) with Efficient Transfer Learning}, 
  year={2025},
  volume={},
  number={},
  pages={318-322},
  abstract={Cancer diagnosis and treatment rely on biomarker discovery, and miRNA profiles are significant tools. The Adaptive Multi-Resolution Temporal Attention Network (AMRTA Net) is a novel miRNA biomarker classification method. AMRTA Net uses better multi-resolution feature extraction and fine-tuned temporal attention to represent miRNA data with fine-grained and global characteristics. AMRTA Net's Hierarchical Resolution Analysis Module analyzes biomarker data at several resolutions while concentrating on critical aspects for cancer classification. A Customizable Transfer Learning (CTL) architecture improves model performance. To effectively learn biomarker-related information, it adaptively modifies just the final few layers of a pre-trained deep neural network. The method uses a Temporal Stability Optimization (TSO) loss function to reduce feature extraction shift at various time points to counteract temporal volatility in miRNA data sets. Biomedical researchers typically lack labeled samples, hence a successful Hybrid Semi-Supervised Learning Strategy adds pseudo-labelled data to the training set. In experimental investigation, AMRTA Net outperformed other approaches in cancer miRNA dataset categorization with 97.2% accuracy. The model is ideal for biomedical diagnostics because to its noise tolerance and strong scalability for big data sets. AMRTA Net, a precision medicine breakthrough, classifies miRNA biomarkers intelligently and accurately using adaptive learning, multi-resolution analysis, and temporal attention.},
  keywords={Adaptive learning;Adaptation models;Adaptive systems;Attention mechanisms;Accuracy;Biological system modeling;Transfer learning;Feature extraction;Oncology;Cancer;miRNA Biomarker Classification;Multi-Resolution Feature Extraction;Temporal Attention Mechanism;Adaptive Learning Framework;Recision Oncology Diagnostics},
  doi={10.1109/ICCSP64183.2025.11088565},
