@article{SHEN2025189336,
title = {Advances and applications of multiomics technologies in precision diagnosis and treatment for gastric cancer},
journal = {Biochimica et Biophysica Acta (BBA) - Reviews on Cancer},
volume = {1880},
number = {3},
pages = {189336},
year = {2025},
issn = {0304-419X},
doi = {https://doi.org/10.1016/j.bbcan.2025.189336},
url = {https://www.sciencedirect.com/science/article/pii/S0304419X25000782},
author = {Ke Shen and Can Hu and Yanqiang Zhang and Xiangdong Cheng and Zhiyuan Xu and Siwei Pan},
keywords = {Gastric cancer, Multiomics technologies, Tumor heterogeneity, Precision medicine, Biomarker discovery, Personalized therapy},
abstract = {Gastric cancer (GC), one of the most prevalent malignancies worldwide, is distinguished by extensive genetic and phenotypic heterogeneity, posing persistent challenges to conventional diagnostic and therapeutic strategies. The significant global burden of GC highlights an urgent need to unravel its complex underlying mechanisms, discover novel diagnostic and prognostic biomarkers, and develop more effective therapeutic interventions. In this context, this review comprehensively examines the transformative roles of cutting-edge technologies, including radiomics, pathomics, genomics, transcriptomics, epigenomics, proteomics, and metabolomics, in advancing precision diagnosis and treatment for GC. Multiomics data analysis not only deepens our understanding of GC pathogenesis and molecular subtypes but also identifies promising biomarkers, facilitating the creation of tailored therapeutic approaches. Additionally, integrating multiomics approaches holds immense potential for elucidating drug resistance mechanisms, predicting patient outcomes, and uncovering novel therapeutic targets, thereby laying a robust foundation for precision medicine in the comprehensive management of GC.}
}
@article{LIU2026217242,
title = {Advances in cancer biomarkers: current detection strategies and challenges},
journal = {Coordination Chemistry Reviews},
volume = {549},
pages = {217242},
year = {2026},
issn = {0010-8545},
doi = {https://doi.org/10.1016/j.ccr.2025.217242},
url = {https://www.sciencedirect.com/science/article/pii/S0010854525008124},
author = {Zhixian Liu and Zhongxi Huang and Xiuyu Chen and Long Zhang and Qiong Wu and Lin Li and Changmin Yu and Jifu Wei},
keywords = {Cancer biomarkers, Detection strategies, Optical biosensors, Mass spectrometry, Electrochemical biosensors, PCR, Microfluidic chip, Challenges},
abstract = {Cancer biomarkers, serving as biological indicators of disease status, assume pivotal roles in cancer risk assessment, diagnosis, prognosis, and the prediction of treatment outcomes, encompassing efficacy, toxicity, and recurrence. The significance of early cancer diagnosis in reducing mortality has led to extensive efforts to explore innovative technologies for detecting these biomarkers. Currently, the conventional cancer detection techniques exist expensive, painful, time-consuming, and have low sensitivity and specificity. Despite researchers have developed biosensors tailored for the accurate detection of specific cancer molecular biomarkers, only a few biomarkers and some specific cancer types have been involved. A comprehensive summary of cancer biomarkers and their detection methods remain limited. Thus, it is urgent to provide a comprehensive review covering the existing challenges and latest developments in achieving high selectivity/sensitivity for the detection of diverse cancer biomarkers. In this review, we will summarize the currently available cancer biomarkers and the challenges that must be overcome to enhance their practical applications, as well as outline the latest research progress of cancer biomarkers applications and detection techniques. It is expected that the development of high specificity and sensitivity detection methods of cancer biomarkers can pave the way for clinical applications of cancer biomarkers, as well as encourage collaboration from different communities of chemists, physicists, biologists, clinicians, material-scientists, and engineering technical researchers, which may contribute to the realization of point-of-care diagnosis and individualized treatment of cancers.}
}
